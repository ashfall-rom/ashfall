From 1c8966650763d2b932ea4ed96d8a3e40617faa14 Mon Sep 17 00:00:00 2001
From: AshFall UI <ui@ashfall.local>
Date: Fri, 27 Nov 2026 13:01:57 +0000
Subject: [PATCH] ThemeOverlayController: default to the AshFall Ember accent

---
 .../theme/ThemeOverlayController.java         | 39 ++++++++++++++++++-
 1 file changed, 37 insertions(+), 2 deletions(-)

diff --git a/packages/SystemUI/src/com/android/systemui/theme/ThemeOverlayController.java b/packages/SystemUI/src/com/android/systemui/theme/ThemeOverlayController.java
index ea7a192..f6b1214 100644
--- a/packages/SystemUI/src/com/android/systemui/theme/ThemeOverlayController.java
+++ b/packages/SystemUI/src/com/android/systemui/theme/ThemeOverlayController.java
@@ -680,14 +680,49 @@ public class ThemeOverlayController implements CoreStartable, Dumpable {
         updateThemeOverlays(forceReload);
     }
 
+    // AshFall: the default accent until the user picks a theme in ThemePicker
+    // or sets a wallpaper with its own seed color.
+    private static final int ASHFALL_EMBER = 0xFFFF8A3D;
+
+    private boolean isAshFallDefaultTheme() {
+        final String overlayPackageJson = mSecureSettings.getStringForUser(
+                Settings.Secure.THEME_CUSTOMIZATION_OVERLAY_PACKAGES,
+                mUserTracker.getUserId());
+        if (TextUtils.isEmpty(overlayPackageJson)) {
+            return true;
+        }
+        try {
+            final JSONObject object = new JSONObject(overlayPackageJson);
+            if (object.has(OVERLAY_CATEGORY_SYSTEM_PALETTE)
+                    || object.has(OVERLAY_CATEGORY_ACCENT_COLOR)
+                    || object.has(OVERLAY_COLOR_INDEX)) {
+                return false;
+            }
+            final String source = object.optString(OVERLAY_COLOR_SOURCE);
+            return !COLOR_SOURCE_PRESET.equals(source)
+                    && !COLOR_SOURCE_LOCK.equals(source);
+        } catch (JSONException e) {
+            return true;
+        }
+    }
+
     /**
      * Return the main theme color from a given {@link WallpaperColors} instance.
      */
     protected int getNeutralColor(@NonNull WallpaperColors wallpaperColors) {
-        return ColorScheme.getSeedColor(wallpaperColors);
+        final int seed = ColorScheme.getSeedColor(wallpaperColors);
+        if (isAshFallDefaultTheme() && (seed == GOOGLE_BLUE
+                || (mDeviceProvisionedController != null
+                        && !mDeviceProvisionedController.isCurrentUserSetup()))) {
+            return ASHFALL_EMBER;
+        }
+        return seed;
     }
 
     protected int getAccentColor(@NonNull WallpaperColors wallpaperColors) {
+        if (isAshFallDefaultTheme()) {
+            return ASHFALL_EMBER;
+        }
         return ColorScheme.getSeedColor(wallpaperColors);
     }
 
@@ -962,7 +997,7 @@ public class ThemeOverlayController implements CoreStartable, Dumpable {
         Pair<Integer, String> styleAndSource = getHardwareColorSetting();
 
         // Last fallback color
-        Color defaultSeedColor = Color.valueOf(GOOGLE_BLUE);
+        Color defaultSeedColor = Color.valueOf(ASHFALL_EMBER);
 
         // defaultColor will come from wallpaper or be parsed from a string
         boolean isWallpaper = styleAndSource.second.equals(COLOR_SOURCE_HOME);
-- 
