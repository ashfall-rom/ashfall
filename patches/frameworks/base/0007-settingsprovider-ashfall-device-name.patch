From 17cc8d7710a08c869fb3bc6aec98141f4df60a5b Mon Sep 17 00:00:00 2001
From: AshFall UI <ui@ashfall.local>
Date: Sat, 21 Nov 2026 19:58:24 +0000
Subject: [PATCH] SettingsProvider: rename the old default device name to RP5
 AshFall

---
 .../providers/settings/SettingsProvider.java  | 30 +++++++++++++++----
 1 file changed, 25 insertions(+), 5 deletions(-)

diff --git a/packages/SettingsProvider/src/com/android/providers/settings/SettingsProvider.java b/packages/SettingsProvider/src/com/android/providers/settings/SettingsProvider.java
index 83a81e7..af8229b 100644
--- a/packages/SettingsProvider/src/com/android/providers/settings/SettingsProvider.java
+++ b/packages/SettingsProvider/src/com/android/providers/settings/SettingsProvider.java
@@ -4405,11 +4405,15 @@ public class SettingsProvider extends ContentProvider {
         final class UpgradeController {
             // AshFall: 237 was introduced by the #51 SettingsProvider migration, which seeded
             // LineageSettings keys into the wrong (AOSP) table. The seeding is removed - those
-            // defaults now live in LineageSettingsProvider (patches/lineage-sdk, docs/ui.md) -
-            // but the version stays at 237: devices flashed with the previous build already have
-            // their settings database at 237 and lowering the version would make
-            // UpgradeController drop and recreate the whole settings database.
-            private static final int SETTINGS_VERSION = 237;
+            // defaults now live in LineageSettingsProvider (patches/lineage-sdk, docs/ui.md).
+            // 238 renames the old default device name once (docs/phase7.md 3.3).
+            private static final int SETTINGS_VERSION = 238;
+
+            // AshFall: models seeded into Settings.Global.DEVICE_NAME by older builds.
+            // Only these exact defaults are renamed; a name the user typed is kept.
+            private static final String ASHFALL_DEVICE_NAME = "RP5 AshFall";
+            private static final java.util.List<String> OLD_DEVICE_NAMES =
+                    java.util.Arrays.asList("AshFall GSI arm64", "Generic System", "Android");
 
             private final int mUserId;
             private final int mDeviceId;
@@ -7099,6 +7103,22 @@ public class SettingsProvider extends ContentProvider {
                     currentVersion = 237;
                 }
 
+                if (currentVersion == 237) {
+                    // AshFall: Settings.Global.DEVICE_NAME is seeded from Build.MODEL on a
+                    // fresh /data. An existing /data still carries the model of the build it
+                    // was created with ("AshFall GSI arm64"), so rename that known default
+                    // once. Never touch a name the user typed.
+                    final Setting deviceName = globalSettings.getSettingLocked(
+                            Settings.Global.DEVICE_NAME);
+                    if (!deviceName.isNull()
+                            && OLD_DEVICE_NAMES.contains(deviceName.getValue())) {
+                        globalSettings.insertSettingLocked(Settings.Global.DEVICE_NAME,
+                                ASHFALL_DEVICE_NAME, null /* tag */, true /* makeDefault */,
+                                SettingsState.SYSTEM_PACKAGE_NAME);
+                    }
+                    currentVersion = 238;
+                }
+
                 // vXXX: Add new settings above this point.
 
                 if (currentVersion != newVersion) {
-- 
2.53.0

