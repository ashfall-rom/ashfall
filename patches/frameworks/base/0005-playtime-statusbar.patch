new file mode 100644
index 000000000..1882a67d5
--- /dev/null
+++ b/packages/SystemUI/src/com/android/systemui/ashfall/PlayTimeSettings.java
@@ -0,0 +1,166 @@
+/*
+ * Copyright (C) 2026 The AshFall Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.systemui.ashfall;
+
+import android.os.SystemProperties;
+import android.util.Log;
+
+import java.util.concurrent.CopyOnWriteArrayList;
+
+/**
+ * The PlayTime settings, read from {@code persist.ashfall.batt.*}.
+ *
+ * <p>The settings page (Settings > Battery) writes those properties from another process; this
+ * process only reads them. {@link android.os.SystemProperties#addChangeCallback} cannot be used for
+ * that: it only reports changes made by the calling process itself (its native side is
+ * {@code report_sysprop_change()}, which runs in the writer), so a property written by Settings
+ * never reached SystemUI and the indicator stayed off until SystemUI restarted. The caller
+ * ({@code PlayTimeIndicator}) therefore re-reads this schema on a short main-thread tick and calls
+ * {@link #reload()}; this class still coalesces and compares, so listeners only hear about real
+ * changes.
+ *
+ * <p>Every value is validated here. A missing, malformed or stale property yields the documented
+ * default (see {@code docs/playtime.md}) - never an exception and never a crash.
+ */
+public final class PlayTimeSettings {
+
+    private static final String TAG = "PlayTimeSettings";
+
+    public static final String KEY_SHOW = "persist.ashfall.batt.show";
+    public static final String KEY_PLACEMENT = "persist.ashfall.batt.place";
+    public static final String KEY_DETAIL = "persist.ashfall.batt.detail";
+    public static final String KEY_FORMAT = "persist.ashfall.batt.fmt";
+    public static final String KEY_WINDOW = "persist.ashfall.batt.window";
+    public static final String KEY_INTERVAL = "persist.ashfall.batt.interval";
+    public static final String KEY_CHARGING_SYMBOL = "persist.ashfall.batt.chg_symbol";
+    public static final String KEY_CHARGING_CYCLE = "persist.ashfall.batt.chg_cycle";
+    public static final String KEY_CHARGING_CYCLE_MS = "persist.ashfall.batt.chg_cycle_ms";
+    public static final String KEY_CHARGING_METERS = "persist.ashfall.batt.chg_meters";
+    public static final String KEY_TAP = "persist.ashfall.batt.tap";
+    public static final String KEY_TEXT_SIZE = "persist.ashfall.batt.size_sp";
+    public static final String KEY_CAPACITY = "persist.ashfall.batt.capacity_mah";
+
+    private static volatile PlayTimeSettings sInstance;
+
+    private final CopyOnWriteArrayList<Runnable> mListeners = new CopyOnWriteArrayList<>();
+
+    private volatile PlayTimeEstimator.Config mConfig = read();
+
+    /** The process wide settings snapshot. */
+    public static PlayTimeSettings get() {
+        PlayTimeSettings instance = sInstance;
+        if (instance == null) {
+            synchronized (PlayTimeSettings.class) {
+                instance = sInstance;
+                if (instance == null) {
+                    instance = new PlayTimeSettings();
+                    sInstance = instance;
+                }
+            }
+        }
+        return instance;
+    }
+
+    private PlayTimeSettings() {
+    }
+
+    /** The current, already validated settings. */
+    public static PlayTimeEstimator.Config config() {
+        return get().mConfig;
+    }
+
+    /**
+     * Re-reads {@code persist.ashfall.batt.*} and notifies the listeners when anything changed.
+     * Called on the main thread by the indicator's settings tick; cheap enough for a 2 s cadence
+     * (a baker's dozen of property reads and one small snapshot).
+     */
+    public static void reload() {
+        get().refresh();
+    }
+
+    public static void addListener(Runnable listener) {
+        get().mListeners.addIfAbsent(listener);
+    }
+
+    public static void removeListener(Runnable listener) {
+        get().mListeners.remove(listener);
+    }
+
+    /** True when the indicator is on and owns the battery percent slot. */
+    public static boolean replacesBatteryPercent() {
+        PlayTimeEstimator.Config config = config();
+        return config.show && config.placement == PlayTimeEstimator.Placement.REPLACE_PERCENT;
+    }
+
+    private void refresh() {
+        PlayTimeEstimator.Config fresh;
+        try {
+            fresh = read();
+        } catch (Throwable t) {
+            Log.w(TAG, "reading persist.ashfall.batt.* failed, keeping the last settings", t);
+            return;
+        }
+        if (fresh.sameAs(mConfig)) {
+            return;
+        }
+        mConfig = fresh;
+        for (Runnable listener : mListeners) {
+            try {
+                listener.run();
+            } catch (Throwable t) {
+                Log.w(TAG, "settings listener failed", t);
+            }
+        }
+    }
+
+    private static PlayTimeEstimator.Config read() {
+        PlayTimeEstimator.Config config = new PlayTimeEstimator.Config();
+        try {
+            config.show = PlayTimeEstimator.parseEnabled(get(KEY_SHOW, "0"));
+            config.placement = PlayTimeEstimator.parsePlacement(get(KEY_PLACEMENT, ""));
+            config.detail = PlayTimeEstimator.parseDetail(get(KEY_DETAIL, ""));
+            config.format = PlayTimeEstimator.parseFormat(get(KEY_FORMAT, ""));
+            config.windowMinutes = PlayTimeEstimator.clampWindow(
+                    PlayTimeEstimator.parseNonNegativeInt(get(KEY_WINDOW, ""), 5));
+            config.intervalSeconds = PlayTimeEstimator.clampIntervalSeconds(
+                    PlayTimeEstimator.parseNonNegativeInt(get(KEY_INTERVAL, ""), 5));
+            config.chargingSymbol =
+                    PlayTimeEstimator.parseChargingSymbol(get(KEY_CHARGING_SYMBOL, ""));
+            config.chargingCycle = PlayTimeEstimator.parseEnabled(get(KEY_CHARGING_CYCLE, "0"));
+            config.chargingCycleMs = PlayTimeEstimator.clampCycleMs(
+                    PlayTimeEstimator.parseNonNegativeInt(get(KEY_CHARGING_CYCLE_MS, ""), 1000));
+            config.meters = PlayTimeEstimator.parseMeters(get(KEY_CHARGING_METERS, ""));
+            config.tapToCycle = PlayTimeEstimator.parseEnabled(get(KEY_TAP, "0"));
+            config.textSizeSp = PlayTimeEstimator.clampTextSizeSp(
+                    PlayTimeEstimator.parseNonNegativeInt(get(KEY_TEXT_SIZE, ""), 12));
+            config.capacityMah = PlayTimeEstimator.parseNonNegativeInt(get(KEY_CAPACITY, ""), 0);
+        } catch (Throwable t) {
+            // Defensive: a property read must never take SystemUI down. Keep the defaults.
+            Log.w(TAG, "reading persist.ashfall.batt.* failed, using defaults", t);
+            return new PlayTimeEstimator.Config();
+        }
+        return config;
+    }
+
+    private static String get(String key, String fallback) {
+        try {
+            return SystemProperties.get(key, fallback);
+        } catch (Throwable t) {
+            return fallback;
+        }
+    }
+}
