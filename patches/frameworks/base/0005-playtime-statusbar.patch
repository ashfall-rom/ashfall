+
+import java.util.function.BooleanSupplier;
+
+/**
+ * Drives the PlayTime text in the status bar.
+ *
+ * <p>Owns one {@link PlayTimeIndicatorView} in the {@link PhoneStatusBarView} hierarchy. The
+ * telemetry comes from {@link BatteryManager}: the sticky {@link Intent#ACTION_BATTERY_CHANGED}
+ * broadcast for level, voltage, charging state and the charge counter, and {@code
+ * BATTERY_PROPERTY_CURRENT_NOW} for the current - or, when the device reports none (the RP5 health
+ * HAL returns 0 uA), the slope of {@code BATTERY_PROPERTY_CHARGE_COUNTER}. Nothing reads sysfs,
+ * nothing reads a daemon property, nothing polls a service in the background: the broadcast updates
+ * the cached state and a tick at the configured sample interval feeds {@link PlayTimeEstimator} and
+ * writes the resulting string. Sampling is not scheduled while the indicator or the screen is off,
+ * and the estimator drops its window when the screen comes back so standby drain can never leak
+ * into the estimate.
+ *
+ * <p>The settings live in {@code persist.ashfall.batt.*}, written by Settings > Battery in another
+ * process. {@link android.os.SystemProperties#addChangeCallback} only reports changes made by the
+ * writing process, so it never saw them (issue #156 section 14): the indicator re-reads the schema
+ * on a 2 s main-thread tick instead, which is what makes "switch it on and watch the status bar"
+ * work without restarting SystemUI.
+ *
+ * <p>Everything is guarded: a missing view, a missing broadcast or an unsupported battery property
+ * leaves the indicator showing {@code --} instead of taking SystemUI down.
+ */
+public final class PlayTimeIndicator {
+
+    private static final String TAG = "PlayTimeIndicator";
+    private static final boolean DEBUG = false;
+
+    private static final IntentFilter BATTERY_FILTER = new IntentFilter(
+            Intent.ACTION_BATTERY_CHANGED);
+
+    private static final IntentFilter SCREEN_FILTER = new IntentFilter();
+
+    static {
+        SCREEN_FILTER.addAction(Intent.ACTION_SCREEN_ON);
+        SCREEN_FILTER.addAction(Intent.ACTION_SCREEN_OFF);
+    }
+
+    /** Plausibility bounds for this device; anything outside is treated as unknown. */
+    private static final int MAX_PLAUSIBLE_MA = PlayTimeEstimator.MAX_PLAUSIBLE_MA;
+    private static final int MIN_PLAUSIBLE_MV = 2_500;
+    private static final int MAX_PLAUSIBLE_MV = 5_500;
+
+    /** {@link BatteryManager#getIntProperty} reports this for an unsupported property. */
+    private static final int UNSUPPORTED_PROPERTY = Integer.MIN_VALUE;
+
+    private static final int PADDING_DP = 4;
+
+    /**
+     * Settings re-read cadence. {@code persist.*} has no cross-process notification, so this is the
+     * only way a write from Settings reaches SystemUI; 13 property reads per tick.
+     */
+    private static final long SETTINGS_WATCH_MS = 2_000;
+
+    /** Shortest window for a charge-counter slope; below this the 1 mAh resolution is noise. */
+    private static final long CHARGE_MIN_MS = 10_000;
+
+    /** The charge-counter slope is re-anchored this often. */
+    private static final long CHARGE_REF_MS = 30_000;
+
+    private final PhoneStatusBarView mBarView;
+    private final Context mContext;
+    private final DarkIconDispatcher mDarkIconDispatcher;
+    private final BooleanSupplier mPanelCollapsed;
+    private final Handler mHandler = new Handler(Looper.getMainLooper());
+    private final PlayTimeEstimator mEstimator =
+            new PlayTimeEstimator(SystemClock::elapsedRealtime);
+    private final PlayTimeEstimator.Reading mReading = new PlayTimeEstimator.Reading();
+    private final PlayTimeIndicatorView mIndicatorView;
+
+    private KeyguardStateController mKeyguardStateController;
+    private BatteryManager mBatteryManager;
+    private PowerManager mPowerManager;
+    private boolean mBatteryReceiverRegistered;
+    private boolean mScreenReceiverRegistered;
+    private boolean mScreenOn = true;
+
+    private final Runnable mTick = this::tick;
+    private final Runnable mCycle = this::advanceCycle;
+    private final Runnable mSettingsWatch = this::watchSettings;
+    private final Runnable mOnSettingsChanged = this::onSettingsChanged;
+
+    private final BroadcastReceiver mScreenReceiver =
+            new BroadcastReceiver() {
+                @Override
+                public void onReceive(Context context, Intent intent) {
+                    String action = intent == null ? null : intent.getAction();
+                    if (Intent.ACTION_SCREEN_OFF.equals(action)) {
+                        onScreenOff();
+                    } else if (Intent.ACTION_SCREEN_ON.equals(action)) {
+                        onScreenOn();
+                    }
+                }
+            };
+
+    // State of the latest ACTION_BATTERY_CHANGED, refreshed by the receiver.
+    private int mLevelPct = PlayTimeEstimator.UNKNOWN;
+    private int mVoltageMv = PlayTimeEstimator.UNKNOWN;
+    private boolean mCharging;
+    private int mChargeMah = PlayTimeEstimator.UNKNOWN;
+    private int mCapacityMah = PlayTimeEstimator.UNKNOWN;
+
+    // Charge-counter slope, used when BATTERY_PROPERTY_CURRENT_NOW says nothing.
+    private long mChargeRefUah = PlayTimeEstimator.UNKNOWN;
+    private long mChargeRefMs;
+    private int mDerivedMa = PlayTimeEstimator.UNKNOWN;
+
+    private final BroadcastReceiver mBatteryReceiver =
+            new BroadcastReceiver() {
+                @Override
+                public void onReceive(Context context, Intent intent) {
+                    try {
+                        updateFromBatteryIntent(intent);
+                        if (mAttached && mConfig.show && isScreenOn()) {
+                            sample();
+                        }
+                    } catch (Throwable t) {
+                        fail("battery broadcast failed", t);
+                    }
+                }
+            };
+
+    private PlayTimeEstimator.Config mConfig = new PlayTimeEstimator.Config();
+    private PlayTimeEstimator.Meter[] mMeters = new PlayTimeEstimator.Meter[0];
+    private PlayTimeEstimator.TapCycle mTap = PlayTimeEstimator.TapCycle.CONFIG;
+    private int mCycleIndex;
+    private String mLastText = "";
+    private boolean mAttached;
+    private boolean mFailureLogged;
+
+    /**
+     * Attaches the indicator to {@code view}, or returns {@code null} when it cannot be attached.
+     *
+     * @param panelCollapsed tells whether the shade is collapsed, so a tap on the indicator never
+     *     fires during an unfold or an expanded shade gesture
+     */
+    public static PlayTimeIndicator attach(PhoneStatusBarView view,
+            DarkIconDispatcher darkIconDispatcher, BooleanSupplier panelCollapsed) {
+        try {
+            PlayTimeIndicator indicator =
+                    new PlayTimeIndicator(view, darkIconDispatcher, panelCollapsed);
+            indicator.onAttached();
+            return indicator;
+        } catch (Throwable t) {
+            Log.w(TAG, "PlayTime indicator disabled: attach failed", t);
+            return null;
+        }
+    }
+
+    private PlayTimeIndicator(PhoneStatusBarView view, DarkIconDispatcher darkIconDispatcher,
+            BooleanSupplier panelCollapsed) {
+        mBarView = view;
+        mContext = view.getContext();
+        mDarkIconDispatcher = darkIconDispatcher;
+        mPanelCollapsed = panelCollapsed;
+        mIndicatorView = new PlayTimeIndicatorView(mContext);
+        int padding = Math.round(PADDING_DP * view.getResources().getDisplayMetrics().density);
+        mIndicatorView.setPaddingRelative(padding, 0, padding, 0);
+    }
+
+    private void onAttached() {
+        mAttached = true;
+        try {
+            mKeyguardStateController = Dependency.get(KeyguardStateController.class);
+        } catch (Throwable t) {
+            mKeyguardStateController = null;
+        }
+        try {
+            mBatteryManager = mContext.getSystemService(BatteryManager.class);
+        } catch (Throwable t) {
+            mBatteryManager = null;
+            Log.w(TAG, "no battery manager, the estimate stays unavailable", t);
+        }
+        try {
+            mPowerManager = mContext.getSystemService(PowerManager.class);
+        } catch (Throwable t) {
+            mPowerManager = null;
+        }
+        mScreenOn = mPowerManager == null || mPowerManager.isInteractive();
+        mEstimator.setScreenOn(mScreenOn);
+
+        registerScreenReceiver();
+        PlayTimeSettings.addListener(mOnSettingsChanged);
+        if (mDarkIconDispatcher != null) {
+            mDarkIconDispatcher.addDarkReceiver(mIndicatorView);
+        }
+        mIndicatorView.setOnClickListener(v -> onTap());
+        applyConfig();
+        scheduleSettingsWatch();
+    }
+
+    /** Detaches everything this indicator added. Safe to call twice. */
+    public void detach() {
+        if (!mAttached) {
+            return;
+        }
+        mAttached = false;
+        stopTimers();
+        mHandler.removeCallbacks(mSettingsWatch);
+        unregisterBatteryReceiver();
+        unregisterScreenReceiver();
+        PlayTimeSettings.removeListener(mOnSettingsChanged);
+        if (mDarkIconDispatcher != null) {
+            mDarkIconDispatcher.removeDarkReceiver(mIndicatorView);
+        }
+        removeFromParent();
+        mEstimator.purge();
+        resetChargeSlope();
+    }
+
+    // ---------------------------------------------------------- screen / focus
+
+    private void onScreenOn() {
+        mScreenOn = true;
+        mEstimator.setScreenOn(true);
+        mTap = PlayTimeEstimator.TapCycle.CONFIG;
+        PlayTimeSettings.reload();
+        // The 2 s settings watch stops itself while the panel is off (#233).
+        scheduleSettingsWatch();
+        registerBatteryReceiver();
+        startTicking();
+    }
+
+    private void onScreenOff() {
+        mScreenOn = false;
+        mEstimator.setScreenOn(false);
+        unregisterBatteryReceiver();
+        stopTimers();
+        resetChargeSlope();
+    }
+
+    private void registerScreenReceiver() {
+        if (mScreenReceiverRegistered) {
+            return;
+        }
+        try {
+            mContext.registerReceiver(mScreenReceiver, SCREEN_FILTER,
+                    Context.RECEIVER_NOT_EXPORTED);
+            mScreenReceiverRegistered = true;
+        } catch (Throwable t) {
+            mScreenReceiverRegistered = false;
+            Log.w(TAG, "cannot register for screen state, sampling will not pause", t);
+        }
+    }
+
+    private void unregisterScreenReceiver() {
+        if (!mScreenReceiverRegistered) {
+            return;
+        }
+        mScreenReceiverRegistered = false;
+        try {
+            mContext.unregisterReceiver(mScreenReceiver);
+        } catch (Throwable t) {
+            Log.w(TAG, "cannot unregister from screen state", t);
+        }
+    }
+
+    // ------------------------------------------------------------- settings
+
+    private void scheduleSettingsWatch() {
+        if (!mAttached || !isScreenOn()) {
+            return;
+        }
+        mHandler.removeCallbacks(mSettingsWatch);
+        mHandler.postDelayed(mSettingsWatch, SETTINGS_WATCH_MS);
+    }
+
+    /**
+     * Re-reads {@code persist.ashfall.batt.*}. The properties are written by Settings in another
+     * process, where no change notification reaches SystemUI, so the indicator looks for itself.
+     */
+    private void watchSettings() {
+        if (!mAttached) {
+            return;
+        }
+        try {
+            PlayTimeSettings.reload();
+        } catch (Throwable t) {
+            fail("reading the settings failed", t);
+            return;
+        }
+        scheduleSettingsWatch();
+    }
+
+    private void onSettingsChanged() {
+        try {
+            applyConfig();
+        } catch (Throwable t) {
+            fail("applying settings failed", t);
+        }
+    }
+
+    private void applyConfig() {
+        mConfig = PlayTimeSettings.config();
+        mEstimator.setWindowMinutes(mConfig.windowMinutes);
+        mEstimator.setIntervalSeconds(mConfig.intervalSeconds);
+        mMeters = mConfig.cycleMeters();
+        mTap = PlayTimeEstimator.TapCycle.CONFIG;
+        mCycleIndex = 0;
+        mIndicatorView.setClickable(mConfig.tapToCycle);
+
+        if (!mConfig.show) {
+            hide();
+            return;
+        }
+        mIndicatorView.setTextSize(TypedValue.COMPLEX_UNIT_SP, mConfig.textSizeSp);
+        if (!place()) {
+            hide();
+            return;
+        }
+        mIndicatorView.setVisibility(View.VISIBLE);
+        registerBatteryReceiver();
+        startTicking();
+    }
+
+    private void hide() {
+        stopTimers();
+        unregisterBatteryReceiver();
+        removeFromParent();
+        mEstimator.purge();
+        resetChargeSlope();
+        mLastText = "";
+    }
+
+    // ------------------------------------------------------------- placement
+
+    /** Places the view in the configured slot; false when there is no suitable parent. */
+    private boolean place() {
+        ViewGroup parent = parentFor(mConfig.placement);
+        if (parent == null) {
+            return false;
+        }
+        removeFromParent();
+        int index = Math.max(0, Math.min(indexFor(parent, mConfig.placement), parent.getChildCount()));
+        try {
+            parent.addView(mIndicatorView, index);
+        } catch (Throwable t) {
+            fail("cannot place the indicator", t);
+            return false;
+        }
+        return true;
+    }
+
+    private void removeFromParent() {
+        ViewParent parent = mIndicatorView.getParent();
+        if (parent instanceof ViewGroup) {
+            ((ViewGroup) parent).removeView(mIndicatorView);
+        }
+    }
+
+    private ViewGroup parentFor(PlayTimeEstimator.Placement placement) {
+        switch (placement) {
+            case CLOCK_LEFT:
+            case CLOCK_RIGHT: {
+                View clock = pickClockView();
+                if (clock == null) {
+                    return null;
+                }
+                ViewParent parent = clock.getParent();
+                return parent instanceof ViewGroup ? (ViewGroup) parent : null;
+            }
+            case BATTERY_LEFT:
+            case BATTERY_RIGHT:
+            case REPLACE_PERCENT:
+            default: {
+                View systemIcons = mBarView.findViewById(R.id.system_icons);
+                if (systemIcons instanceof ViewGroup
+                        && systemIcons.getVisibility() != View.GONE) {
+                    return (ViewGroup) systemIcons;
+                }
+                // Status icons rendered in Compose hide the View container (flag), or the layout
+                // changed: fall back to the end side of the status bar instead of dropping out.
+                View endSide = mBarView.findViewById(R.id.status_bar_end_side_content);
+                return endSide instanceof ViewGroup ? (ViewGroup) endSide : null;
+            }
+        }
+    }
+
+    private int indexFor(ViewGroup parent, PlayTimeEstimator.Placement placement) {
+        switch (placement) {
+            case CLOCK_LEFT:
+            case CLOCK_RIGHT: {
+                View clock = pickClockView();
+                if (clock == null || clock.getParent() != parent) {
+                    return parent.getChildCount();
+                }
+                return placement == PlayTimeEstimator.Placement.CLOCK_LEFT
+                        ? parent.indexOfChild(clock)
+                        : parent.indexOfChild(clock) + 1;
+            }
+            case BATTERY_LEFT:
+            case BATTERY_RIGHT:
+            case REPLACE_PERCENT:
+            default: {
+                // With the Compose battery the percent lives inside the battery view, so the
+                // indicator takes the slot right after it; the Compose side hides the percent for
+                // REPLACE_PERCENT (see StatusBarRoot).
+                View battery = parent.findViewById(R.id.battery_composable_view);
+                if (battery != null && battery.getParent() == parent) {
+                    int index = parent.indexOfChild(battery);
+                    return placement == PlayTimeEstimator.Placement.BATTERY_LEFT ? index : index + 1;
+                }
+                View icons = parent.findViewById(R.id.statusIcons);
+                if (icons != null && icons.getParent() == parent) {
+                    int index = parent.indexOfChild(icons);
+                    return placement == PlayTimeEstimator.Placement.BATTERY_LEFT ? index : index + 1;
+                }
+                return placement == PlayTimeEstimator.Placement.BATTERY_LEFT
+                        ? 0
+                        : parent.getChildCount();
+            }
+        }
+    }
+
+    /** The clock slot in use: left by default, centre or right when the user picked those. */
+    private View pickClockView() {
+        View[] clocks = {
+                mBarView.findViewById(R.id.clock),
+                mBarView.findViewById(R.id.clock_center),
+                mBarView.findViewById(R.id.clock_right),
+        };
+        for (View clock : clocks) {
+            if (clock != null && clock.getVisibility() == View.VISIBLE) {
+                return clock;
+            }
+        }
+        return null;
+    }
+
+    // --------------------------------------------------------------- sampling
+
+    private void startTicking() {
+        if (!mAttached || !mConfig.show || !isScreenOn()) {
+            return;
+        }
+        mHandler.removeCallbacks(mTick);
+        mHandler.post(mTick);
+    }
+
+    private void stopTimers() {
+        mHandler.removeCallbacks(mTick);
+        mHandler.removeCallbacks(mCycle);
+    }
+
+    private void tick() {
+        if (!mAttached || !mConfig.show || !isScreenOn()) {
+            return;
+        }
+        try {
+            sample();
+        } catch (Throwable t) {
+            fail("sampling failed", t);
+            return;
+        }
+        mHandler.postDelayed(mTick, mConfig.intervalSeconds * 1000L);
+    }
+
+    /** One sample: the cached broadcast state plus the best current we can get. */
+    private void sample() {
+        mEstimator.observe(readCurrentMa(), mLevelPct, mVoltageMv, mCharging, mChargeMah,
+                mCapacityMah, mConfig.capacityMah);
+        render();
+    }
+
+    private void registerBatteryReceiver() {
+        if (mBatteryReceiverRegistered) {
+            return;
+        }
+        try {
+            // Sticky: returns the latest battery state and keeps it updated from then on.
+            Intent sticky = mContext.registerReceiver(mBatteryReceiver, BATTERY_FILTER,
+                    Context.RECEIVER_NOT_EXPORTED);
+            mBatteryReceiverRegistered = true;
+            if (sticky != null) {
+                updateFromBatteryIntent(sticky);
+            }
+        } catch (Throwable t) {
+            mBatteryReceiverRegistered = false;
+            Log.w(TAG, "cannot register for battery updates", t);
+        }
+    }
+
+    private void unregisterBatteryReceiver() {
+        if (!mBatteryReceiverRegistered) {
+            return;
+        }
+        mBatteryReceiverRegistered = false;
+        try {
+            mContext.unregisterReceiver(mBatteryReceiver);
+        } catch (Throwable t) {
+            Log.w(TAG, "cannot unregister from battery updates", t);
+        }
+    }
+
+    /**
+     * Caches level, voltage, charging state, remaining charge and the derived capacity from an
+     * {@link Intent#ACTION_BATTERY_CHANGED} intent. Anything missing becomes {@link
+     * PlayTimeEstimator#UNKNOWN}.
+     */
+    private void updateFromBatteryIntent(Intent intent) {
+        if (intent == null) {
+            return;
+        }
+        int level = intent.getIntExtra(BatteryManager.EXTRA_LEVEL, PlayTimeEstimator.UNKNOWN);
+        int scale = intent.getIntExtra(BatteryManager.EXTRA_SCALE, PlayTimeEstimator.UNKNOWN);
+        mLevelPct = (level < 0 || scale <= 0 || level > scale)
+                ? PlayTimeEstimator.UNKNOWN
+                : (int) ((long) level * 100 / scale);
+
+        int voltageMv = intent.getIntExtra(BatteryManager.EXTRA_VOLTAGE,
+                PlayTimeEstimator.UNKNOWN);
+        mVoltageMv = (voltageMv < MIN_PLAUSIBLE_MV || voltageMv > MAX_PLAUSIBLE_MV)
+                ? PlayTimeEstimator.UNKNOWN
+                : voltageMv;
+
+        int status = intent.getIntExtra(BatteryManager.EXTRA_STATUS, PlayTimeEstimator.UNKNOWN);
+        mCharging = status == BatteryManager.BATTERY_STATUS_CHARGING
+                || status == BatteryManager.BATTERY_STATUS_FULL;
+
+        int chargeUah = property(BatteryManager.BATTERY_PROPERTY_CHARGE_COUNTER);
+        mChargeMah = chargeUah >= 0 ? chargeUah / 1000 : PlayTimeEstimator.UNKNOWN;
+        // Design capacity is not exposed: derive it from the charge counter and the level.
+        mCapacityMah = (mChargeMah > 0 && mLevelPct > 0)
+                ? (int) ((long) mChargeMah * 100 / mLevelPct)
+                : PlayTimeEstimator.UNKNOWN;
+    }
+
+    /**
+     * Instantaneous current in mA, rectified. {@code BATTERY_PROPERTY_CURRENT_NOW} is uA and signed,
+     * but the RP5 health HAL reports 0 there, so its charge-counter slope is used instead.
+     */
+    private int readCurrentMa() {
+        int microAmps = property(BatteryManager.BATTERY_PROPERTY_CURRENT_NOW);
+        if (microAmps != PlayTimeEstimator.UNKNOWN) {
+            int milliAmps = Math.abs(microAmps) / 1000;
+            if (milliAmps > 0 && milliAmps <= MAX_PLAUSIBLE_MA) {
+                return milliAmps;
+            }
+        }
+        return currentFromChargeCounter();
+    }
+
+    /**
+     * Current in mA from the movement of the charge counter over a window of at least {@link
+     * #CHARGE_MIN_MS}. The value is re-anchored every {@link #CHARGE_REF_MS} and reused in between,
+     * because a 5 s window at the counter's 1 mAh resolution is dominated by rounding.
+     */
+    private int currentFromChargeCounter() {
+        int chargeUah = property(BatteryManager.BATTERY_PROPERTY_CHARGE_COUNTER);
+        if (chargeUah < 0) {
+            resetChargeSlope();
+            return PlayTimeEstimator.UNKNOWN;
+        }
+        long now = SystemClock.elapsedRealtime();
+        if (mChargeRefUah == PlayTimeEstimator.UNKNOWN) {
+            mChargeRefUah = chargeUah;
+            mChargeRefMs = now;
+            return PlayTimeEstimator.UNKNOWN;
+        }
+        long windowMs = now - mChargeRefMs;
+        if (windowMs < CHARGE_MIN_MS) {
+            return mDerivedMa;
+        }
+        if (windowMs >= CHARGE_REF_MS) {
+            mDerivedMa = PlayTimeEstimator.currentFromChargeDelta(mChargeRefUah - chargeUah,
+                    windowMs);
+            mChargeRefUah = chargeUah;
+            mChargeRefMs = now;
+            if (DEBUG) {
+                Log.d(TAG, "charge-counter slope: " + mDerivedMa + " mA over " + windowMs + " ms");
+            }
+        }
+        return mDerivedMa;
+    }
+
+    private void resetChargeSlope() {
+        mChargeRefUah = PlayTimeEstimator.UNKNOWN;
+        mChargeRefMs = 0;
+        mDerivedMa = PlayTimeEstimator.UNKNOWN;
+    }
+
+    private int property(int id) {
+        if (mBatteryManager == null) {
+            return PlayTimeEstimator.UNKNOWN;
+        }
+        try {
+            int value = mBatteryManager.getIntProperty(id);
+            return value == UNSUPPORTED_PROPERTY ? PlayTimeEstimator.UNKNOWN : value;
+        } catch (Throwable t) {
+            return PlayTimeEstimator.UNKNOWN;
+        }
+    }
+
+    private void render() {
+        mEstimator.fill(mReading);
+        String text;
+        if (mConfig.chargingCycle && mReading.charging && mMeters.length > 1) {
+            text = PlayTimeEstimator.meter(mMeters[mCycleIndex % mMeters.length], mReading, mConfig);
+        } else {
+            text = PlayTimeEstimator.render(mReading, mConfig, mTap);
+        }
+        // One setText per changed string: no allocation and no relayout in the draw path.
+        if (!text.equals(mLastText)) {
+            mLastText = text;
+            mIndicatorView.setText(text);
+            mIndicatorView.setContentDescription(text);
+            if (DEBUG) {
+                Log.d(TAG, "indicator: " + text);
+            }
+        }
+        updateCycleTimer();
+    }
+
+    private void updateCycleTimer() {
+        mHandler.removeCallbacks(mCycle);
+        boolean rotate = mConfig.chargingCycle && mReading.charging && mMeters.length > 1
+                && isScreenOn();
+        if (!rotate) {
+            mCycleIndex = 0;
+            return;
+        }
+        mHandler.postDelayed(mCycle, mConfig.chargingCycleMs);
+    }
+
+    private void advanceCycle() {
+        if (!mAttached || !mConfig.show) {
+            return;
+        }
+        mCycleIndex++;
+        try {
+            render();
+        } catch (Throwable t) {
+            fail("charging cycle failed", t);
+        }
+    }
+
+    // -------------------------------------------------------------- tap cycle
+
+    private void onTap() {
+        if (!mConfig.show || !mConfig.tapToCycle) {
+            return;
+        }
+        if (mPanelCollapsed != null && !mPanelCollapsed.getAsBoolean()) {
+            // The shade is expanded or being dragged: that gesture belongs to the shade.
+            return;
+        }
+        if (mKeyguardStateController != null
+                && mKeyguardStateController.isPrimaryBouncerShowing()) {
+            return;
+        }
+        mTap = mTap.next();
+        try {
+            render();
+        } catch (Throwable t) {
+            fail("tap cycle failed", t);
+        }
+    }
+
+    // ---------------------------------------------------------------- helpers
+
+    private boolean isScreenOn() {
+        return mScreenOn;
+    }
+
+    private void fail(String message, Throwable t) {
+        if (!mFailureLogged) {
+            mFailureLogged = true;
+            Log.w(TAG, "PlayTime indicator disabled: " + message, t);
+        }
+        hide();
+    }
+}
