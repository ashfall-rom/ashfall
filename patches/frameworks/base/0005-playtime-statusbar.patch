+package com.android.systemui.ashfall;
+
+import java.util.Locale;
+
+/**
+ * PlayTime estimator: remaining active play time while discharging, time to full while charging.
+ *
+ * <p>Android predicts remaining life from long-term averages that include hours of standby, so a
+ * handheld shows "18 h remaining" and then collapses to two hours under a 3D emulator. This class
+ * only looks at the current screen-on session: it averages the power-supply current over a rolling
+ * window of that session and derives the clock from the remaining charge.
+ *
+ * <p>The class is dependency free on purpose - no Android imports, no sysfs, no properties, no
+ * direct clock. The caller injects a {@link Clock}, feeds one sample per telemetry tick and renders
+ * the result through the {@code format*}/{@code render} helpers. That keeps the maths and every edge
+ * case ({@code --}, FULL, the &gt;48 h cap, the screen-off purge) unit testable on the host without
+ * an emulator; see {@code PlayTimeEstimatorTest}.
+ */
+public final class PlayTimeEstimator {
+
+    /** Value used for "we do not know" everywhere in this class. */
+    public static final int UNKNOWN = -1;
+
+    /** Text shown when there is no estimate yet. */
+    public static final String UNKNOWN_TEXT = "--";
+
+    /** Samples are sparse (one per telemetry tick); 10 min at 2 s needs 300. */
+    private static final int CAPACITY = 512;
+
+    /** Below this the current reading is noise, not a measurement. */
+    public static final int MIN_USABLE_MA = 20;
+
+    /** Above this a current reading cannot come from this device. */
+    public static final int MAX_PLAUSIBLE_MA = 10_000;
+
+    /** Past this a clock is meaningless on a handheld. */
+    private static final int MAX_ESTIMATE_HOURS = 48;
+
+    private static final String SEPARATOR = " \u00b7 ";
+
+    /** Where the indicator sits in the status bar. */
+    public enum Placement {
+        BATTERY_LEFT, BATTERY_RIGHT, CLOCK_LEFT, CLOCK_RIGHT, REPLACE_PERCENT
+    }
+
+    /** Which values the indicator shows. */
+    public enum Detail {
+        TIME, TIME_W, TIME_W_V, TIME_V, W, V, W_V
+    }
+
+    /** How the time component is written. */
+    public enum Format {
+        COMPACT, SHORT, COLON, DETAILED
+    }
+
+    /** Symbol prefixed to the time while charging. */
+    public enum ChargingSymbol {
+        /** Monochrome bolt. */
+        BOLT,
+        /** Plain plus. */
+        PLUS,
+        /** {@code CHG}. */
+        TEXT,
+        /** Colour emoji bolt. */
+        EMOJI
+    }
+
+    /** The four values the indicator can show, used by the charging cycle. */
+    public enum Meter {
+        TIME, PERCENT, WATTS, VOLTS
+    }
+
+    /** Tap-to-cycle state: the configured view, then W, V, %. */
+    public enum TapCycle {
+        CONFIG, WATTS, VOLTS, PERCENT;
+
+        public TapCycle next() {
+            switch (this) {
+                case CONFIG:
+                    return WATTS;
+                case WATTS:
+                    return VOLTS;
+                case VOLTS:
+                    return PERCENT;
+                case PERCENT:
+                default:
+                    return CONFIG;
+            }
+        }
+    }
+
+    /** Injected time source, so tests control "now". */
+    public interface Clock {
+        long elapsedRealtime();
+    }
+
+    /** Fixed ring buffer of screen-on current samples (no allocation per tick). */
+    private final long[] mTimestamps = new long[CAPACITY];
+    private final int[] mCurrents = new int[CAPACITY];
+    private int mHead;
+    private int mCount;
+
+    private final Clock mClock;
+
+    private boolean mScreenOn = true;
+    private boolean mSawScreenOff;
+
+    private int mWindowMinutes = 5;
+    private int mIntervalSeconds = 5;
+
+    /** Charging state of the samples in the window; a flip purges it. */
+    private boolean mCharging;
+    private boolean mChargingKnown;
+
+    private long mSessionStart = UNKNOWN;
+
+    /** Raw inputs of the latest tick, kept for {@link #fill}. */
+    private int mLevelPct = UNKNOWN;
+    private int mVoltageMv = UNKNOWN;
+    private int mChargeMah = UNKNOWN;
+    private int mCapacityMah = UNKNOWN;
+    private int mCapacityOverrideMah;
+
+    public PlayTimeEstimator(Clock clock) {
+        mClock = clock;
+    }
+
+    // ----------------------------------------------------------------- config
+
+    /** One of 1/3/5/10 minutes; anything else keeps the current window. */
+    public void setWindowMinutes(int minutes) {
+        if (minutes == 1 || minutes == 3 || minutes == 5 || minutes == 10) {
+            mWindowMinutes = minutes;
+        }
+    }
+
+    public void setIntervalSeconds(int seconds) {
+        mIntervalSeconds = clampIntervalSeconds(seconds);
+    }
+
+    // ----------------------------------------------------------- screen state
+
+    /**
+     * Screen off stops sampling; the next screen on purges the window so the previous session (and
+     * any standby drain) never leaks into the new one. This is the main accuracy rule of the
+     * feature.
+     */
+    public void setScreenOn(boolean screenOn) {
+        if (mScreenOn == screenOn) {
+            return;
+        }
+        mScreenOn = screenOn;
+        if (screenOn) {
+            if (mSawScreenOff) {
+                purge();
+            }
+            mSawScreenOff = false;
+        } else {
+            mSawScreenOff = true;
+        }
+    }
+
+    // --------------------------------------------------------------- sampling
+
+    /**
+     * Feeds one telemetry tick. Ignored while the screen is off, for unknown ({@code <= 0}) current
+     * readings and for implausible ones. A change of the charging state drops the window: discharge
+     * samples say nothing about charge current and vice versa.
+     *
+     * @param currentMa current magnitude as measured by the power daemon
+     * @param levelPct battery level 0..100, {@link #UNKNOWN} if unknown
+     * @param voltageMv battery voltage in mV, {@link #UNKNOWN} if unknown
+     * @param charging {@code true} while the charger is connected
+     * @param chargeMah remaining charge in mAh, {@link #UNKNOWN} if unknown
+     * @param capacityMah design capacity in mAh, {@link #UNKNOWN} if unknown
+     * @param capacityOverrideMah user override in mAh, {@code 0} = auto
+     */
+    public synchronized void observe(int currentMa, int levelPct, int voltageMv,
+            boolean charging, int chargeMah, int capacityMah, int capacityOverrideMah) {
+        mLevelPct = levelPct;
+        mVoltageMv = voltageMv;
+        mChargeMah = chargeMah;
+        mCapacityMah = capacityMah;
+        mCapacityOverrideMah = Math.max(0, capacityOverrideMah);
+
+        if (!mScreenOn) {
+            return;
+        }
+        if (mChargingKnown && charging != mCharging) {
+            purge();
+        }
+        mCharging = charging;
+        mChargingKnown = true;
+
+        if (currentMa <= 0) {
+            return;
+        }
+
+        long now = mClock.elapsedRealtime();
+        if (mSessionStart == UNKNOWN) {
+            mSessionStart = now;
+        }
+        prune(now - mWindowMinutes * 60_000L);
+
+        if (mCount == CAPACITY) {
+            // Ring is full: drop the oldest sample.
+            mHead = (mHead + 1) % CAPACITY;
+            mCount--;
+        }
+        int tail = (mHead + mCount) % CAPACITY;
+        mTimestamps[tail] = now;
+        mCurrents[tail] = currentMa;
+        mCount++;
+    }
+
+    /** Drops every sample; the next estimate needs a full interval again. */
+    public synchronized void purge() {
+        mHead = 0;
+        mCount = 0;
+        mSessionStart = UNKNOWN;
+    }
+
+    private void prune(long oldestAllowed) {
+        while (mCount > 0 && mTimestamps[mHead] < oldestAllowed) {
+            mHead = (mHead + 1) % CAPACITY;
+            mCount--;
+        }
+    }
+
+    public synchronized int getSampleCount() {
+        return mCount;
+    }
+
+    /**
+     * A number is only shown after one full sample interval of the current session, and never from
+     * a single reading.
+     */
+    public synchronized boolean isEstimateReady() {
+        if (mCount < 2 || mSessionStart == UNKNOWN) {
+            return false;
+        }
+        return mClock.elapsedRealtime() - mSessionStart >= mIntervalSeconds * 1000L;
+    }
+
+    /** Average current of the window, {@link #UNKNOWN} when there is none. */
+    public synchronized int getAverageCurrentMa() {
+        if (mCount == 0) {
+            return UNKNOWN;
+        }
+        long sum = 0;
+        for (int i = 0; i < mCount; i++) {
+            sum += mCurrents[(mHead + i) % CAPACITY];
+        }
+        return (int) (sum / mCount);
+    }
+
+    /**
+     * Current in mA derived from the movement of the remaining charge: {@code deltaUah} is the
+     * charge-counter difference in uAh over {@code deltaMs} milliseconds, either sign.
+     *
+     * <p>This is the fallback when the device reports no {@code BATTERY_PROPERTY_CURRENT_NOW}: the
+     * RP5 health HAL reports {@code batteryCurrentMicroamps = 0} even under load, so the counter is
+     * the only real current the platform exposes (it is what {@code dumpsys battery}'s "Charge
+     * counter" shows and it does move on this device).
+     *
+     * @return the magnitude in mA, or {@link #UNKNOWN} for a non-positive window, no movement, or
+     *     a result outside the plausible range - never a guess
+     */
+    public static int currentFromChargeDelta(long deltaUah, long deltaMs) {
+        if (deltaMs <= 0) {
+            return UNKNOWN;
+        }
+        long moved = Math.abs(deltaUah);
+        if (moved == 0) {
+            return UNKNOWN;
+        }
+        // uAh per ms -> mA: (uAh / 1000) / (ms / 3_600_000) == uAh * 3600 / ms.
+        long milliAmps = moved * 3600L / deltaMs;
+        if (milliAmps <= 0 || milliAmps > MAX_PLAUSIBLE_MA) {
+            return UNKNOWN;
+        }
+        return (int) milliAmps;
+    }
+
+    // ------------------------------------------------------------------ maths
+
+    /**
+     * Remaining charge in mAh: the reported charge counter when the daemon has one, otherwise level
+     * x capacity. {@link #UNKNOWN} when neither is usable - never a guess.
+     */
+    public static int remainingMah(int chargeMah, int capacityMah, int capacityOverrideMah,
+            int levelPct) {
+        if (chargeMah > 0) {
+            return chargeMah;
+        }
+        int total = totalMah(capacityMah, capacityOverrideMah);
+        if (total <= 0 || levelPct < 0 || levelPct > 100) {
+            return UNKNOWN;
+        }
+        return (int) ((long) total * levelPct / 100);
+    }
+
+    /** The capacity to use: the user override when set, otherwise the design capacity. */
+    public static int totalMah(int capacityMah, int capacityOverrideMah) {
+        if (capacityOverrideMah > 0) {
+            return capacityOverrideMah;
+        }
+        return capacityMah > 0 ? capacityMah : UNKNOWN;
+    }
+
+    /**
+     * Minutes for {@code mah} at {@code avgMa}, rounded up so a positive amount never reads
+     * {@code 0m}. {@link #UNKNOWN} for a missing amount or a current that is just noise.
+     */
+    public static int minutesFor(long mah, int avgMa) {
+        if (mah <= 0 || avgMa <= MIN_USABLE_MA) {
+            return UNKNOWN;
+        }
+        return (int) ((mah * 60 + avgMa - 1) / avgMa);
+    }
+
+    /**
+     * Full means "stop counting up": 100 %, or a charge counter with no headroom left. The counter
+     * is authoritative when the daemon has one.
+     */
+    public static boolean isFull(boolean charging, int levelPct, int remainingMah, int fullMah) {
+        if (levelPct >= 100) {
+            return true;
+        }
+        return charging && fullMah > 0 && remainingMah >= fullMah;
+    }
+
+    /** Snapshot of everything the renderer needs; reuse one instance per view. */
+    public static final class Reading {
+        public int currentMa = UNKNOWN;
+        public int levelPct = UNKNOWN;
+        public int voltageMv = UNKNOWN;
+        public boolean charging;
+        public int remainingMah = UNKNOWN;
+        public int fullMah = UNKNOWN;
+        public int minutesRemaining = UNKNOWN;
+        public int minutesToFull = UNKNOWN;
+        public boolean full;
+        public boolean ready;
+    }
+
+    /** Fills {@code out} from the current window; never allocates. */
+    public synchronized void fill(Reading out) {
+        out.charging = mChargingKnown && mCharging;
+        out.levelPct = mLevelPct;
+        out.voltageMv = mVoltageMv;
+        out.currentMa = getAverageCurrentMa();
+        out.fullMah = totalMah(mCapacityMah, mCapacityOverrideMah);
+        out.remainingMah =
+                remainingMah(mChargeMah, mCapacityMah, mCapacityOverrideMah, mLevelPct);
+        out.ready = isEstimateReady() && out.currentMa > MIN_USABLE_MA;
+        out.full = isFull(out.charging, out.levelPct, out.remainingMah, out.fullMah);
+        out.minutesRemaining = !out.ready || out.charging
+                ? UNKNOWN
+                : minutesFor(out.remainingMah, out.currentMa);
+        out.minutesToFull = !out.ready || !out.charging || out.fullMah <= 0
+                ? UNKNOWN
+                : minutesFor(out.fullMah - out.remainingMah, out.currentMa);
+    }
+
+    // ------------------------------------------------------------ formatting
+
+    /** The time component: duration, charging prefix, {@code --} or FULL. */
+    public static String time(Reading r, Config config) {
+        String symbol = config.chargingSymbolText(r.charging);
+        if (r.charging) {
+            if (r.full) {
+                return symbol + "FULL";
+            }
+            if (r.minutesToFull == UNKNOWN) {
+                // No usable charge current yet: show the symbol alone, never a fabricated number.
+                return symbol.trim().isEmpty() ? UNKNOWN_TEXT : symbol.trim();
+            }
+            return symbol + formatMinutes(r.minutesToFull, config.format);
+        }
+        if (!r.ready || r.minutesRemaining == UNKNOWN) {
+            return UNKNOWN_TEXT;
+        }
+        return formatMinutes(r.minutesRemaining, config.format);
+    }
+
+    public static String formatMinutes(int minutes, Format format) {
+        if (minutes < 0) {
+            return UNKNOWN_TEXT;
+        }
+        int hours = minutes / 60;
+        int mins = minutes % 60;
+        if (hours > MAX_ESTIMATE_HOURS) {
+            return ">48h";
+        }
+        switch (format) {
+            case SHORT:
+                return String.format(Locale.US, "%dh%02d", hours, mins);
+            case COLON:
+                return String.format(Locale.US, "%d:%02d", hours, mins);
+            case DETAILED:
+                return String.format(Locale.US, "%d hr %d min", hours, mins);
+            case COMPACT:
+            default:
+                return hours > 0
+                        ? String.format(Locale.US, "%dh %dm", hours, mins)
+                        : String.format(Locale.US, "%dm", mins);
+        }
+    }
+
+    public static String watts(Reading r) {
+        if (r.currentMa <= 0 || r.voltageMv <= 0) {
+            return UNKNOWN_TEXT;
+        }
+        double w = (double) r.currentMa * r.voltageMv / 1_000_000d;
+        return String.format(Locale.US, "%s%.1fW", r.charging ? "+" : "", w);
+    }
+
+    public static String volts(Reading r) {
+        if (r.voltageMv <= 0) {
+            return UNKNOWN_TEXT;
+        }
+        return String.format(Locale.US, "%.2fV", r.voltageMv / 1000d);
+    }
+
+    public static String percent(Reading r) {
+        if (r.levelPct < 0 || r.levelPct > 100) {
+            return UNKNOWN_TEXT;
+        }
+        return r.levelPct + "%";
+    }
+
+    /** Text of one meter, for the charging cycle. */
+    public static String meter(Meter meter, Reading r, Config config) {
+        switch (meter) {
+            case PERCENT:
+                return percent(r);
+            case WATTS:
+                return watts(r);
+            case VOLTS:
+                return volts(r);
+            case TIME:
+            default:
+                return time(r, config);
+        }
+    }
+
+    /** The full indicator string for the configured detail mode. */
+    public static String render(Reading r, Config config) {
+        switch (config.detail) {
+            case TIME_W:
+                return time(r, config) + SEPARATOR + watts(r);
+            case TIME_W_V:
+                return time(r, config) + SEPARATOR + watts(r) + SEPARATOR + volts(r);
+            case TIME_V:
+                return time(r, config) + SEPARATOR + volts(r);
+            case W:
+                return watts(r);
+            case V:
+                return volts(r);
+            case W_V:
+                return watts(r) + SEPARATOR + volts(r);
+            case TIME:
+            default:
+                return time(r, config);
+        }
+    }
+
+    /** The indicator string with the tap override applied. */
+    public static String render(Reading r, Config config, TapCycle tap) {
+        switch (tap) {
+            case WATTS:
+                return watts(r);
+            case VOLTS:
+                return volts(r);
+            case PERCENT:
+                return percent(r);
+            case CONFIG:
+            default:
+                return render(r, config);
+        }
+    }
+
+    // ----------------------------------------------------------------- config
+
+    /** The persisted settings, already validated; defaults are documented in docs/playtime.md. */
+    public static final class Config {
+        public static final int METER_TIME = 1;
+        public static final int METER_PERCENT = 1 << 1;
+        public static final int METER_WATTS = 1 << 2;
+        public static final int METER_VOLTS = 1 << 3;
+
+        public boolean show;
+        public Placement placement = Placement.BATTERY_LEFT;
+        public Detail detail = Detail.TIME;
+        public Format format = Format.COMPACT;
+        public int windowMinutes = 5;
+        public int intervalSeconds = 5;
+        public ChargingSymbol chargingSymbol = ChargingSymbol.BOLT;
+        public boolean chargingCycle;
+        public int chargingCycleMs = 1000;
+        public int meters = METER_TIME | METER_PERCENT;
+        public boolean tapToCycle;
+        public int textSizeSp = 12;
+        public int capacityMah;
+
+        String chargingSymbolText(boolean charging) {
+            if (!charging) {
+                return "";
+            }
+            switch (chargingSymbol) {
+                case PLUS:
+                    return "+";
+                case TEXT:
+                    return "CHG ";
+                case EMOJI:
+                    return "\u26a1";
+                case BOLT:
+                default:
+                    return "\u21ef";
+            }
+        }
+
+        /** Meters of the charging cycle, in fixed order. */
+        public Meter[] cycleMeters() {
+            int count = Integer.bitCount(meters);
+            Meter[] out = new Meter[Math.max(2, count)];
+            int at = 0;
+            if ((meters & METER_TIME) != 0) {
+                out[at++] = Meter.TIME;
+            }
+            if ((meters & METER_PERCENT) != 0) {
+                out[at++] = Meter.PERCENT;
+            }
+            if ((meters & METER_WATTS) != 0) {
+                out[at++] = Meter.WATTS;
+            }
+            if ((meters & METER_VOLTS) != 0) {
+                out[at++] = Meter.VOLTS;
+            }
+            if (at == 0) {
+                out[0] = Meter.TIME;
+                out[1] = Meter.PERCENT;
+            }
+            return out;
+        }
+
+        /** True when {@code other} holds the same settings (for the property listener). */
+        public boolean sameAs(Config other) {
+            return other != null
+                    && show == other.show
+                    && placement == other.placement
+                    && detail == other.detail
+                    && format == other.format
+                    && windowMinutes == other.windowMinutes
+                    && intervalSeconds == other.intervalSeconds
+                    && chargingSymbol == other.chargingSymbol
+                    && chargingCycle == other.chargingCycle
+                    && chargingCycleMs == other.chargingCycleMs
+                    && meters == other.meters
+                    && tapToCycle == other.tapToCycle
+                    && textSizeSp == other.textSizeSp
+                    && capacityMah == other.capacityMah;
+        }
+    }
+
+    // --------------------------------------------------------------- parsing
+
+    public static int clampWindow(int minutes) {
+        return (minutes == 1 || minutes == 3 || minutes == 5 || minutes == 10) ? minutes : 5;
+    }
+
+    public static int clampIntervalSeconds(int seconds) {
+        return (seconds < 2 || seconds > 30) ? 5 : seconds;
+    }
+
+    public static int clampTextSizeSp(int sp) {
+        return (sp < 10 || sp > 16) ? 12 : sp;
+    }
+
+    public static int clampCycleMs(int ms) {
+        return (ms < 500 || ms > 5000) ? 1000 : ms;
+    }
+
+    public static boolean parseEnabled(String value) {
+        return "1".equals(value) || "true".equalsIgnoreCase(value);
+    }
+
+    public static Placement parsePlacement(String value) {
+        if (value != null) {
+            switch (value.trim().toUpperCase(Locale.US)) {
+                case "BATTERY_RIGHT":
+                    return Placement.BATTERY_RIGHT;
+                case "CLOCK_LEFT":
+                    return Placement.CLOCK_LEFT;
+                case "CLOCK_RIGHT":
+                    return Placement.CLOCK_RIGHT;
+                case "REPLACE_PERCENT":
+                    return Placement.REPLACE_PERCENT;
+                case "BATTERY_LEFT":
+                default:
+                    break;
+            }
+        }
+        return Placement.BATTERY_LEFT;
+    }
+
+    public static Detail parseDetail(String value) {
+        if (value != null) {
+            switch (value.trim().toUpperCase(Locale.US)) {
+                case "TIME_W":
+                    return Detail.TIME_W;
+                case "TIME_W_V":
+                    return Detail.TIME_W_V;
+                case "TIME_V":
+                    return Detail.TIME_V;
+                case "W":
+                    return Detail.W;
+                case "V":
+                    return Detail.V;
+                case "W_V":
+                    return Detail.W_V;
+                case "TIME":
+                default:
+                    break;
+            }
+        }
+        return Detail.TIME;
+    }
+
+    public static Format parseFormat(String value) {
+        if (value != null) {
+            switch (value.trim().toUpperCase(Locale.US)) {
+                case "SHORT":
+                    return Format.SHORT;
+                case "COLON":
+                    return Format.COLON;
+                case "DETAILED":
+                    return Format.DETAILED;
+                case "COMPACT":
+                default:
+                    break;
+            }
+        }
+        return Format.COMPACT;
+    }
+
+    public static ChargingSymbol parseChargingSymbol(String value) {
+        if (value != null) {
+            switch (value.trim().toUpperCase(Locale.US)) {
+                case "PLUS":
+                    return ChargingSymbol.PLUS;
+                case "TEXT":
+                    return ChargingSymbol.TEXT;
+                case "EMOJI":
+                    return ChargingSymbol.EMOJI;
+                case "BOLT":
+                default:
+                    break;
+            }
+        }
+        return ChargingSymbol.BOLT;
+    }
+
+    /**
+     * {@code chg_meters} is a comma separated list of 2-3 of TIME/PERCENT/WATTS/VOLTS; anything
+     * else falls back to the default pair.
+     */
+    public static int parseMeters(String value) {
+        if (value == null) {
+            return Config.METER_TIME | Config.METER_PERCENT;
+        }
+        int mask = 0;
+        for (String part : value.split(",")) {
+            switch (part.trim().toUpperCase(Locale.US)) {
+                case "TIME":
+                    mask |= Config.METER_TIME;
+                    break;
+                case "PERCENT":
+                    mask |= Config.METER_PERCENT;
+                    break;
+                case "WATTS":
+                    mask |= Config.METER_WATTS;
+                    break;
+                case "VOLTS":
+                    mask |= Config.METER_VOLTS;
+                    break;
+                default:
+                    break;
+            }
+        }
+        return Integer.bitCount(mask) < 2 ? Config.METER_TIME | Config.METER_PERCENT : mask;
+    }
+
+    /** Parses a non-negative integer property; anything else yields {@code fallback}. */
+    public static int parseNonNegativeInt(String value, int fallback) {
+        if (value == null || value.isEmpty()) {
+            return fallback;
+        }
+        try {
+            int parsed = Integer.parseInt(value.trim());
+            return parsed >= 0 ? parsed : fallback;
+        } catch (NumberFormatException e) {
+            return fallback;
+        }
+    }
+}
