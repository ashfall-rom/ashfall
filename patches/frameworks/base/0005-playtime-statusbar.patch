+/**
+ * The status bar PlayTime text.
+ *
+ * <p>Colour comes from the same {@link DarkIconDispatcher} tint the status bar clock and the battery
+ * text use, so the indicator follows light, dark and tinted backgrounds. The text itself is set by
+ * {@link PlayTimeIndicator} once per telemetry tick, never from {@code onDraw}: drawing only paints
+ * the cached string.
+ */
+public final class PlayTimeIndicatorView extends TextView implements DarkIconDispatcher.DarkReceiver {
+
+    public PlayTimeIndicatorView(Context context) {
+        super(context, null, 0, R.style.TextAppearance_StatusBar_Default);
+        setGravity(Gravity.CENTER_VERTICAL);
+        setSingleLine(true);
+        setIncludeFontPadding(false);
+    }
+
+    @Override
+    public void onDarkChanged(ArrayList<Rect> areas, float darkIntensity, int tint) {
+        setTextColor(DarkIconDispatcher.getTint(areas, this, tint));
+    }
+}
