index 000000000..9fedcbc60
--- /dev/null
+++ b/packages/SystemUI/tests/src/com/android/systemui/ashfall/PlayTimeEstimatorTest.java
@@ -0,0 +1,457 @@
+/*
+ * Copyright (C) 2026 The AshFall Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.systemui.ashfall;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import com.android.systemui.ashfall.PlayTimeEstimator.ChargingSymbol;
+import com.android.systemui.ashfall.PlayTimeEstimator.Config;
+import com.android.systemui.ashfall.PlayTimeEstimator.Detail;
+import com.android.systemui.ashfall.PlayTimeEstimator.Format;
+import com.android.systemui.ashfall.PlayTimeEstimator.Placement;
+import com.android.systemui.ashfall.PlayTimeEstimator.Reading;
+import com.android.systemui.ashfall.PlayTimeEstimator.TapCycle;
+
+import org.junit.Test;
+
+/** Host tests for the PlayTime maths and formatting; no Android, no emulator. */
+public class PlayTimeEstimatorTest {
+
+    private static final int LEVEL = 50;
+    private static final int VOLTAGE_MV = 3800;
+    private static final int CHARGE_MAH = 3000;
+    private static final int CAPACITY_MAH = 6000;
+
+    /** Controllable clock. */
+    private static final class FakeClock implements PlayTimeEstimator.Clock {
+        long now;
+
+        @Override
+        public long elapsedRealtime() {
+            return now;
+        }
+    }
+
+    private final FakeClock mClock = new FakeClock();
+    private final PlayTimeEstimator mEstimator = new PlayTimeEstimator(mClock);
+    private final Reading mReading = new Reading();
+
+    private Config config() {
+        Config config = new Config();
+        config.windowMinutes = 5;
+        config.intervalSeconds = 5;
+        return config;
+    }
+
+    /** One daemon tick at {@code nowMs}. */
+    private void sample(long nowMs, int currentMa) {
+        mClock.now = nowMs;
+        mEstimator.observe(currentMa, LEVEL, VOLTAGE_MV, false, CHARGE_MAH, CAPACITY_MAH, 0);
+    }
+
+    private void sample(long nowMs, int currentMa, boolean charging) {
+        mClock.now = nowMs;
+        mEstimator.observe(currentMa, LEVEL, VOLTAGE_MV, charging, CHARGE_MAH, CAPACITY_MAH, 0);
+    }
+
+    private Reading reading() {
+        mEstimator.fill(mReading);
+        return mReading;
+    }
+
+    // ---------------------------------------------------------- ready / unknown
+
+    @Test
+    public void noNumberBeforeOneFullInterval() {
+        sample(0, 1000);
+        assertFalse(mEstimator.isEstimateReady());
+        assertEquals(PlayTimeEstimator.UNKNOWN_TEXT, PlayTimeEstimator.render(reading(), config()));
+
+        sample(2_000, 1000);
+        assertFalse("5 s interval, 2 s elapsed", mEstimator.isEstimateReady());
+        assertEquals(PlayTimeEstimator.UNKNOWN_TEXT, PlayTimeEstimator.render(reading(), config()));
+
+        sample(5_000, 1000);
+        assertTrue(mEstimator.isEstimateReady());
+        // 3000 mAh * 60 / 1000 mA = 180 min
+        assertEquals("3h 0m", PlayTimeEstimator.render(reading(), config()));
+    }
+
+    @Test
+    public void singleSampleIsNeverAnEstimate() {
+        mClock.now = 10_000;
+        mEstimator.observe(1000, LEVEL, VOLTAGE_MV, false, CHARGE_MAH, CAPACITY_MAH, 0);
+        mClock.now = 60_000;
+        assertFalse(mEstimator.isEstimateReady());
+    }
+
+    @Test
+    public void noiseCurrentShowsUnknown() {
+        sample(0, 20);
+        sample(5_000, 20);
+        sample(7_000, 20);
+        assertEquals(PlayTimeEstimator.UNKNOWN_TEXT, PlayTimeEstimator.render(reading(), config()));
+    }
+
+    @Test
+    public void unknownLevelAndCapacityShowUnknown() {
+        mClock.now = 0;
+        mEstimator.observe(1000, PlayTimeEstimator.UNKNOWN, VOLTAGE_MV, false,
+                PlayTimeEstimator.UNKNOWN, PlayTimeEstimator.UNKNOWN, 0);
+        mClock.now = 5_000;
+        mEstimator.observe(1000, PlayTimeEstimator.UNKNOWN, VOLTAGE_MV, false,
+                PlayTimeEstimator.UNKNOWN, PlayTimeEstimator.UNKNOWN, 0);
+        assertEquals(PlayTimeEstimator.UNKNOWN, reading().remainingMah);
+        assertEquals("--", PlayTimeEstimator.time(reading(), config()));
+    }
+
+    @Test
+    public void invalidCurrentIsNotSampled() {
+        sample(0, 1000);
+        sample(2_000, 0);
+        sample(4_000, -1);
+        assertEquals(1, mEstimator.getSampleCount());
+    }
+
+    // -------------------------------------------------- current from the counter
+
+    @Test
+    public void chargeCounterSlopeYieldsTheCurrent() {
+        // 42 mAh over 5 min is 504 mA (uAh over ms, either sign).
