+/**
+ * AshFall: whether the PlayTime indicator owns the battery percent slot
+ * (`persist.ashfall.batt.place=REPLACE_PERCENT`). The status bar text itself is a View added by
+ * [com.android.systemui.ashfall.PlayTimeIndicator]; only the stock percentage is Compose, so it
+ * steps aside here. The properties are written by Settings in another process, so the indicator
+ * re-reads them on its 2 s settings tick and notifies this listener; the recomposition follows that
+ * notification rather than a poll of its own.
+ */
+@Composable
+private fun playTimeReplacesPercent(): Boolean {
+    var replaces by remember { mutableStateOf(PlayTimeSettings.replacesBatteryPercent()) }
+    DisposableEffect(Unit) {
+        val listener = Runnable { replaces = PlayTimeSettings.replacesBatteryPercent() }
+        PlayTimeSettings.addListener(listener)
+        onDispose { PlayTimeSettings.removeListener(listener) }
+    }
+    return replaces
+}
