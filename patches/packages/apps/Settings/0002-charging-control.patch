+package com.android.settings.fuelgauge.chargecontrol;
+
+import android.os.RemoteException;
+import android.util.Log;
+
+import java.lang.reflect.InvocationTargetException;
+import java.lang.reflect.Method;
+import java.util.NoSuchElementException;
+
+/**
+ * Reflective bridge to the retail vendor factory HAL ({@code
+ * vendor.qti.hardware.factory@1.1::IFactory}), the only surface that stops charging on the RP5:
+ * the PM8150B power-supply nodes expose no writable charge-enable node, and the factory HIDL
+ * stubs are not part of Settings' compile-time classpath.
+ *
+ * <p>The RP5 registers the factory HAL at <b>1.1 only</b> ({@code
+ * docs/stock/vintf/manifest.xml}, {@code @1.1::IFactory/default}); HIDL service lookup is an exact
+ * fqname match, so a {@code @1.0} lookup never answers it. The bridge therefore probes {@code
+ * V1_1.IFactory} first, falls back to {@code V1_0.IFactory} for firmware that registered 1.0, and
+ * logs which interface answered. 1.1 extends 1.0, so {@code chargerEnable(boolean)} is inherited.
+ *
+ * <p>Every failure is reported instead of thrown: a missing class or method, a service that is not
+ * registered ({@code null}) and a {@link RemoteException} from the call all mean "this firmware
+ * cannot do it", so the page shows "Not supported on this firmware" and the caller fails open to
+ * charging (docs/settings-battery.md).
+ */
+public final class ChargingSeparationHal {
+
+    private static final String TAG = "ChargingSeparationHal";
+
+    /** Probe order: the retail firmware registers 1.1, older/other builds may register 1.0. */
+    private static final String[] IFACTORY_CLASSES = {
+        "vendor.qti.hardware.factory.V1_1.IFactory",
+        "vendor.qti.hardware.factory.V1_0.IFactory",
+    };
+
+    private static final String[] IFACTORY_VERSIONS = {"@1.1", "@1.0"};
+
+    private static final String METHOD_GET_SERVICE = "getService";
+    private static final String METHOD_CHARGER_ENABLE = "chargerEnable";
+
+    /** A resolved interface: the proxy, its inherited method and the version that answered. */
+    private static final class Hal {
+        final Object proxy;
+        final Method chargerEnable;
+        final String version;
+
+        Hal(Object proxy, Method chargerEnable, String version) {
+            this.proxy = proxy;
+            this.chargerEnable = chargerEnable;
+            this.version = version;
+        }
+    }
+
+    /** Positive resolution only; a miss is re-probed next time so a slow service can appear. */
+    private static Hal sHal;
+
+    /** Outcome of one {@code chargerEnable} call. */
+    public enum Result {
+        /** The HAL applied the request. */
+        OK,
+        /** This firmware has no factory HAL for charging control. */
+        UNSUPPORTED,
+        /** The HAL is present but the call failed; the caller must fail open to charging. */
+        FAILED
+    }
+
+    private ChargingSeparationHal() {}
+
+    /** Whether this firmware exposes a factory service with {@code chargerEnable(boolean)}. */
+    public static boolean isSupported() {
+        return resolve() != null;
+    }
+
+    /**
+     * Stops ({@code enabled=false}) or resumes ({@code enabled=true}) battery charging.
+     *
+     * <p>Never throws: {@link Result#UNSUPPORTED} covers a missing class, method or service and a
+     * {@link RemoteException}; {@link Result#FAILED} covers any other invocation error. Both let
+     * the caller fail open to charging.
+     */
+    public static Result setChargingEnabled(boolean enabled) {
+        final Hal hal = resolve();
+        if (hal == null) {
+            return Result.UNSUPPORTED;
+        }
+        try {
+            hal.chargerEnable.invoke(hal.proxy, enabled);
+            return Result.OK;
+        } catch (IllegalAccessException | SecurityException e) {
+            Log.w(TAG, "chargerEnable(" + enabled + ") is not accessible on " + hal.version, e);
+            return Result.FAILED;
+        } catch (InvocationTargetException e) {
+            final Throwable cause = e.getCause();
+            if (cause instanceof RemoteException) {
+                Log.w(TAG, "chargerEnable(" + enabled + ") failed in " + hal.version, cause);
+                // The proxy may be dead; let the next probe re-resolve.
+                sHal = null;
+                return Result.UNSUPPORTED;
+            }
+            Log.w(TAG, "chargerEnable(" + enabled + ") threw on " + hal.version, cause);
+            return Result.FAILED;
+        } catch (RuntimeException | LinkageError e) {
+            Log.w(TAG, "chargerEnable(" + enabled + ") failed on " + hal.version, e);
+            return Result.FAILED;
+        }
+    }
+
+    /** The resolved factory service, or {@code null} when no probed version answers. */
+    private static synchronized Hal resolve() {
+        if (sHal != null) {
+            return sHal;
+        }
+        for (int i = 0; i < IFACTORY_CLASSES.length; i++) {
+            final Hal hal = resolve(IFACTORY_CLASSES[i], IFACTORY_VERSIONS[i]);
+            if (hal != null) {
+                sHal = hal;
+                Log.i(
+                        TAG,
+                        "Factory HAL resolved: "
+                                + hal.version
+                                + " ("
+                                + IFACTORY_CLASSES[i]
+                                + ")");
+                return hal;
+            }
+        }
+        Log.i(TAG, "Factory HAL not found: tried @1.1 and @1.0");
+        return null;
+    }
+
+    /** One probe of one interface version; {@code null} means "this one did not answer". */
+    private static Hal resolve(String className, String version) {
+        try {
+            final Class<?> ifactory = Class.forName(className);
+            final Method getService = ifactory.getMethod(METHOD_GET_SERVICE);
+            final Object proxy = getService.invoke(null);
+            if (proxy == null) {
+                Log.i(TAG, version + " getService() returned null (not registered or not ready)");
+                return null;
+            }
+            final Method chargerEnable = ifactory.getMethod(METHOD_CHARGER_ENABLE, boolean.class);
+            return new Hal(proxy, chargerEnable, version);
+        } catch (ClassNotFoundException e) {
+            // The vendor stub is not on Settings' classloader (no shared library on this build).
+            Log.i(TAG, version + " stub is not on this build's classpath", e);
+            return null;
+        } catch (NoSuchMethodException e) {
+            Log.i(TAG, version + " has no getService()/chargerEnable(boolean)", e);
+            return null;
+        } catch (IllegalAccessException | SecurityException e) {
+            Log.w(TAG, version + " is not reachable", e);
+            return null;
+        } catch (InvocationTargetException e) {
+            final Throwable cause = e.getCause();
+            if (cause instanceof RemoteException || cause instanceof NoSuchElementException) {
+                Log.i(TAG, version + " is not registered", cause);
+            } else {
+                Log.w(TAG, version + " getService() failed", cause);
+            }
+            return null;
+        } catch (RuntimeException | LinkageError e) {
+            Log.w(TAG, version + " probe failed", e);
+            return null;
+        }
+    }
+}
