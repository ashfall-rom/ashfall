+
+import android.os.RemoteException;
+import android.util.Log;
+
+import java.lang.reflect.InvocationTargetException;
+import java.lang.reflect.Method;
+import java.util.NoSuchElementException;
+
+/**
+ * Reflective bridge to the retail vendor factory HAL ({@code
+ * vendor.qti.hardware.factory@1.0::IFactory}), the only surface that stops charging on the RP5:
+ * the PM8150B power-supply nodes expose no writable charge-enable node, and the factory HIDL
+ * stubs are not part of the platform's compile-time classpath for Settings.
+ *
+ * <p>Every failure is reported instead of thrown: a missing class or method, a service that is not
+ * registered ({@code null}) and a {@link RemoteException} from the call all mean "this firmware
+ * cannot do it", so the page shows "Not supported on this firmware" and the caller fails open to
+ * charging (docs/settings-battery.md).
+ */
+public final class ChargingSeparationHal {
+
+    private static final String TAG = "ChargingSeparationHal";
+
+    /** HIDL 1.0 factory interface, Java package name of the generated stub. */
+    private static final String IFACTORY_CLASS = "vendor.qti.hardware.factory.V1_0.IFactory";
+
+    private static final String METHOD_GET_SERVICE = "getService";
+    private static final String METHOD_CHARGER_ENABLE = "chargerEnable";
+
+    /** Outcome of one {@code chargerEnable} call. */
+    public enum Result {
+        /** The HAL applied the request. */
+        OK,
+        /** This firmware has no factory HAL for charging control. */
+        UNSUPPORTED,
+        /** The HAL is present but the call failed; the caller must fail open to charging. */
+        FAILED
+    }
+
+    private ChargingSeparationHal() {}
+
+    /** Whether this firmware exposes both the service and {@code chargerEnable(boolean)}. */
+    public static boolean isSupported() {
+        return getService() != null && getChargerEnable() != null;
+    }
+
+    /**
+     * Stops ({@code enabled=false}) or resumes ({@code enabled=true}) battery charging.
+     *
+     * <p>Never throws: {@link Result#UNSUPPORTED} covers a missing class, method or service and a
+     * {@link RemoteException}; {@link Result#FAILED} covers any other invocation error. Both let
+     * the caller fail open to charging.
+     */
+    public static Result setChargingEnabled(boolean enabled) {
+        final Object service = getService();
+        if (service == null) {
+            return Result.UNSUPPORTED;
+        }
+        final Method chargerEnable = getChargerEnable();
+        if (chargerEnable == null) {
+            return Result.UNSUPPORTED;
+        }
+        try {
+            chargerEnable.invoke(service, enabled);
+            return Result.OK;
+        } catch (IllegalAccessException | SecurityException e) {
+            Log.w(TAG, "chargerEnable(" + enabled + ") is not accessible", e);
+            return Result.FAILED;
+        } catch (InvocationTargetException e) {
+            final Throwable cause = e.getCause();
+            if (cause instanceof RemoteException) {
+                Log.w(TAG, "chargerEnable(" + enabled + ") failed in the HAL", cause);
+                return Result.UNSUPPORTED;
+            }
+            Log.w(TAG, "chargerEnable(" + enabled + ") threw", cause);
+            return Result.FAILED;
+        } catch (RuntimeException | LinkageError e) {
+            // A missing dependent class or a broken stub surfaces here.
+            Log.w(TAG, "chargerEnable(" + enabled + ") failed", e);
+            return Result.FAILED;
+        }
+    }
+
+    /** The registered factory service, or {@code null} when this firmware has none. */
+    private static Object getService() {
+        try {
+            final Method getService =
+                    Class.forName(IFACTORY_CLASS).getMethod(METHOD_GET_SERVICE);
+            return getService.invoke(null);
+        } catch (ClassNotFoundException | NoSuchMethodException e) {
+            Log.i(TAG, "Factory HAL is not present on this firmware", e);
+            return null;
+        } catch (IllegalAccessException | SecurityException e) {
+            Log.w(TAG, "Factory HAL is not reachable", e);
+            return null;
+        } catch (InvocationTargetException e) {
+            final Throwable cause = e.getCause();
+            if (cause instanceof RemoteException || cause instanceof NoSuchElementException) {
+                Log.i(TAG, "Factory HAL is not registered", cause);
+            } else {
+                Log.w(TAG, "getService() failed", cause);
+            }
+            return null;
+        } catch (RuntimeException | LinkageError e) {
+            Log.w(TAG, "getService() failed", e);
+            return null;
+        }
+    }
+
+    /** The reflective {@code chargerEnable(boolean)} method, or {@code null} when it is missing. */
+    private static Method getChargerEnable() {
+        try {
+            return Class.forName(IFACTORY_CLASS).getMethod(METHOD_CHARGER_ENABLE, boolean.class);
+        } catch (ClassNotFoundException | NoSuchMethodException e) {
+            Log.i(TAG, "chargerEnable(boolean) is not present on this firmware", e);
+            return null;
+        } catch (RuntimeException | LinkageError e) {
+            Log.w(TAG, "chargerEnable(boolean) is not available", e);
+            return null;
+        }
+    }
+}
