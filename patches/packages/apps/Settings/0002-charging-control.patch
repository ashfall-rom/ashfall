+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.fuelgauge.chargecontrol;
+
+import android.app.settings.SettingsEnums;
+import android.content.Context;
+import android.os.Bundle;
+import android.widget.Toast;
+
+import androidx.preference.Preference;
+import androidx.preference.SwitchPreferenceCompat;
+
+import com.android.settings.R;
+import com.android.settings.SettingsPreferenceFragment;
+
+/**
+ * Settings &gt; Battery &gt; Charging control: the manual charging-separation toggle, the firmware
+ * support state and the battery-care note for the 80 %/10 % policy.
+ *
+ * <p>Separation stops charging while the adapter stays connected. The state is stored in {@code
+ * persist.ashfall.batt.charge_sep}, re-applied at locked boot by {@link ChargingControlReceiver},
+ * and never enabled below 20 % or without the charger. The stored state survives an unplug (there
+ * is no implicit-broadcast exemption for the disconnect action), so the page re-checks the floor on
+ * resume and drops a stale request. Every error path fails open to charging
+ * (docs/settings-battery.md).
+ *
+ * <p>The vendor HAL is reached through {@link ChargingSeparationHal}, which answers on a background
+ * thread. Nothing here blocks the main thread: the page shows a checking state, then enables the
+ * switch only after a transaction succeeded.
+ */
+public class ChargingControlSettings extends SettingsPreferenceFragment
+        implements Preference.OnPreferenceChangeListener {
+
+    private static final String KEY_SEPARATION = "charging_separation";
+    private static final String KEY_SUPPORT = "charging_support";
+
+    private SwitchPreferenceCompat mSeparation;
+    private Preference mSupport;
+
+    /**
+     * {@code null} while unknown: support is only claimed after a successful transaction, and a
+     * transient failure returns to unknown instead of claiming the firmware lacks the HAL.
+     */
+    private Boolean mSupported;
+
+    /** A HAL call is in flight; the switch stays locked until it answers. */
+    private boolean mBusy;
+
+    @Override
+    public void onCreatePreferences(Bundle savedInstanceState, String rootKey) {
+        addPreferencesFromResource(R.xml.charging_control_settings);
+
+        mSeparation = findPreference(KEY_SEPARATION);
+        mSupport = findPreference(KEY_SUPPORT);
+        mSeparation.setOnPreferenceChangeListener(this);
+        // Nothing is claimed before the first transaction answered.
+        mSeparation.setEnabled(false);
+        mSupport.setSummary(R.string.charging_control_checking);
+        bindState();
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        // A request stored earlier must not strand a low battery: drop it and restore charging.
+        if (ChargingSeparation.isEnabled() && !ChargingSeparation.isAboveGuard(getContext())) {
+            ChargingControlReceiver.clearAndRestore();
+        }
+        bindState();
+        if (!mBusy) {
+            probeSupport();
+        }
+    }
+
+    @Override
+    public int getMetricsCategory() {
+        return SettingsEnums.FUELGAUGE_POWER_USAGE_SUMMARY_V2;
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        if (!KEY_SEPARATION.equals(preference.getKey()) || mBusy) {
+            return false;
+        }
+        final boolean enable = (Boolean) newValue;
+        if (!enable) {
+            disable();
+            return false;
+        }
+        if (mSupported == null) {
+            showToast(R.string.charging_control_unavailable);
+            return false;
+        }
+        if (!mSupported) {
+            showToast(R.string.charging_control_unsupported);
+            return false;
+        }
+        if (!ChargingSeparation.isPlugged(getContext())) {
+            showToast(R.string.charging_control_not_plugged);
+            return false;
+        }
+        if (!ChargingSeparation.isAboveGuard(getContext())) {
+            showToast(R.string.charging_control_below_min);
+            return false;
+        }
+        mBusy = true;
+        mSeparation.setEnabled(false);
+        ChargingSeparationHal.setChargingEnabled(
+                false,
+                result -> {
+                    mBusy = false;
+                    if (result == ChargingSeparationHal.Result.OK
+                            && ChargingSeparation.setEnabled(true)) {
+                        mSeparation.setEnabled(true);
+                        bindState();
+                        return;
+                    }
+                    // Fail open: make sure the charger is enabled again and nothing is persisted.
+                    ChargingControlReceiver.clearAndRestore();
+                    if (result == ChargingSeparationHal.Result.UNSUPPORTED) {
+                        mSupported = false;
+                        mSupport.setSummary(R.string.charging_control_unsupported);
+                        showToast(R.string.charging_control_unsupported);
+                    } else {
+                        showToast(R.string.charging_control_apply_failed);
+                        mSeparation.setEnabled(true);
+                    }
+                    bindState();
+                });
+        return false;
+    }
+
+    /**
+     * Leaves the support state unknown until a transaction answers.
+     *
+     * <p>The probe is a real transaction, not a lookup: separation is re-applied when the property
+     * says on, otherwise charging is requested, which is a no-op while charging is already allowed.
+     * Both run on the HAL helper's background thread, so opening the page never waits for the lazy
+     * start.
+     */
+    private void probeSupport() {
+        mBusy = true;
+        mSupported = null;
+        mSeparation.setEnabled(false);
+        mSupport.setSummary(R.string.charging_control_checking);
+        ChargingSeparationHal.setChargingEnabled(
+                !ChargingSeparation.isEnabled(), this::onProbed);
+    }
+
+    private void onProbed(ChargingSeparationHal.Result result) {
+        mBusy = false;
+        switch (result) {
+            case OK:
+                mSupported = true;
+                mSupport.setSummary(R.string.charging_control_supported);
+                mSeparation.setEnabled(true);
+                break;
+            case UNSUPPORTED:
+                // Both descriptors missed after their lookups: this firmware has no factory HAL.
+                mSupported = false;
+                mSupport.setSummary(R.string.charging_control_unsupported);
+                break;
+            default:
+                // A service answered but the transaction failed: transient, so say so and probe
+                // again on the next resume instead of claiming the firmware lacks the HAL.
+                mSupported = null;
+                mSupport.setSummary(R.string.charging_control_unavailable);
+                break;
+        }
+        bindState();
+    }
+
+    /**
+     * Turns separation off: clear the stored state, then restore charging on the background thread.
+     * A failed clear keeps the switch on (the property would re-apply at boot) and says so; a
+     * failed restore is reported on its own, because the two can fail independently.
+     */
+    private void disable() {
+        mBusy = true;
+        final boolean cleared = ChargingSeparation.setEnabled(false);
+        mSeparation.setEnabled(false);
+        ChargingSeparationHal.setChargingEnabled(
+                true,
+                result -> {
+                    mBusy = false;
+                    if (result != ChargingSeparationHal.Result.OK) {
+                        showError(R.string.charging_control_restore_failed);
+                    }
+                    if (!cleared) {
+                        showError(R.string.charging_control_clear_failed);
+                    }
+                    mSeparation.setEnabled(mSupported != null && mSupported);
+                    bindState();
+                });
+    }
+
+    /** Mirrors the stored state; the property, not the switch, is the source of truth. */
+    private void bindState() {
+        if (mSeparation != null) {
+            mSeparation.setChecked(
+                    mSupported != null && mSupported && ChargingSeparation.isEnabled());
+        }
+    }
+
+    private void showToast(int resId) {
+        final Context context = getContext();
+        if (context != null) {
+            Toast.makeText(context, resId, Toast.LENGTH_SHORT).show();
+        }
+    }
+
+    private void showError(int resId) {
+        final Context context = getContext();
+        if (context != null) {
+            Toast.makeText(context, resId, Toast.LENGTH_LONG).show();
+        }
+    }
+}
