+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.fuelgauge.chargecontrol;
+
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.util.Log;
+
+/**
+ * Re-applies charging separation as soon as the framework is up.
+ *
+ * <p>The receiver is direct-boot aware: {@code LOCKED_BOOT_COMPLETED} applies the stored state
+ * before the first unlock, {@code BOOT_COMPLETED} is the fallback for a build that does not deliver
+ * the locked broadcast (the static flag keeps the second delivery from repeating the HAL call). It
+ * touches only properties and the vendor HAL, never credential-encrypted storage.
+ *
+ * <p>There is no unplug receiver: {@code ACTION_POWER_DISCONNECTED} is not an implicit-broadcast
+ * exemption, so a manifest receiver is not guaranteed it while the app is in the background. The
+ * stored state survives an unplug and applies again at the next boot or replug with the HAL still
+ * holding the request; the low-battery guards at boot and on page open drop it instead of stranding
+ * a low battery (docs/settings-battery.md).
+ *
+ * <p>The HAL call runs on a background thread and can wait for the vendor service's lazy start, so
+ * {@link #onReceive} holds a {@link PendingResult} from {@link #goAsync()} until the call answers.
+ * Five 300 ms lookups per interface stay well inside the 10 s broadcast budget.
+ *
+ * <p>When the stored state is off the boot path does nothing and makes no HAL call, so a missing
+ * factory HAL cannot produce a boot loop. A firmware without the HAL keeps the stored choice
+ * instead of discarding it, and every failure path clears the property first and then restores
+ * charging.
+ */
+public class ChargingControlReceiver extends BroadcastReceiver {
+
+    private static final String TAG = "ChargingControlReceiver";
+
+    /** Set once the boot re-apply ran in this process; both boot broadcasts are idempotent. */
+    private static boolean sBootApplied;
+
+    @Override
+    public void onReceive(Context context, Intent intent) {
+        final String action = intent.getAction();
+        if (!Intent.ACTION_LOCKED_BOOT_COMPLETED.equals(action)
+                && !Intent.ACTION_BOOT_COMPLETED.equals(action)) {
+            return;
+        }
+        final PendingResult pending = goAsync();
+        synchronized (ChargingControlReceiver.class) {
+            if (sBootApplied) {
+                pending.finish();
+                return;
+            }
+            sBootApplied = true;
+        }
+        reapplyAtBoot(context, pending);
+    }
+
+    /**
+     * Re-applies the stored state after boot: once, idempotently, and only when it was on. Below
+     * the safety floor the stored state is dropped, with charging restored; a firmware without the
+     * HAL keeps the choice and skips the call.
+     */
+    static void reapplyAtBoot(Context context, PendingResult pending) {
+        if (!ChargingSeparation.isEnabled()) {
+            pending.finish();
+            return;
+        }
+        if (!ChargingSeparation.isAboveGuard(context)) {
+            clearAndRestore(pending);
+            return;
+        }
+        ChargingSeparationHal.setChargingEnabled(
+                false,
+                result -> {
+                    switch (result) {
+                        case OK:
+                            Log.i(TAG, "Re-applied charging separation at boot");
+                            break;
+                        case UNSUPPORTED:
+                            // No factory HAL on this firmware: keep the user's choice, never loop.
+                            Log.i(TAG, "Boot: no factory HAL, keeping the stored choice");
+                            break;
+                        default:
+                            Log.w(
+                                    TAG,
+                                    "Boot: the HAL rejected the request, clearing and restoring");
+                            clearAndRestore(pending);
+                            return;
+                    }
+                    pending.finish();
+                });
+    }
+
+    /**
+     * Clears the stored state and restores charging. Used by every guard that must not leave a
+     * separation request behind (below 20 % at boot or page open, and a failed apply).
+     */
+    static void clearAndRestore() {
+        clearAndRestore(null);
+    }
+
+    private static void clearAndRestore(PendingResult pending) {
+        ChargingSeparation.setEnabled(false);
+        ChargingSeparationHal.setChargingEnabled(
+                true,
+                result -> {
+                    if (pending != null) {
+                        pending.finish();
+                    }
+                });
+    }
+}
