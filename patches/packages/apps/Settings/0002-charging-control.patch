+package com.android.settings.fuelgauge.chargecontrol;
+
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+
+/**
+ * Re-applies charging separation as soon as the framework is up and drops it when the charger goes
+ * away.
+ *
+ * <p>The receiver is direct-boot aware: {@code LOCKED_BOOT_COMPLETED} applies the stored state
+ * before the first unlock, {@code BOOT_COMPLETED} is the fallback for a build that does not deliver
+ * the locked broadcast (the static flag keeps the second delivery from repeating the HAL call). It
+ * touches only properties and the vendor HAL, never credential-encrypted storage.
+ *
+ * <p>When the stored state is off the boot path does nothing and makes no HAL call, so a missing
+ * factory HAL cannot produce a boot loop. A firmware without the HAL keeps the stored choice
+ * instead of discarding it, and every failure path clears the property first and then restores
+ * charging (docs/settings-battery.md).
+ */
+public class ChargingControlReceiver extends BroadcastReceiver {
+
+    /** Set once the boot re-apply ran in this process; both boot broadcasts are idempotent. */
+    private static boolean sBootApplied;
+
+    @Override
+    public void onReceive(Context context, Intent intent) {
+        final String action = intent.getAction();
+        if (Intent.ACTION_LOCKED_BOOT_COMPLETED.equals(action)
+                || Intent.ACTION_BOOT_COMPLETED.equals(action)) {
+            if (sBootApplied) {
+                return;
+            }
+            reapplyAtBoot(context);
+            sBootApplied = true;
+        } else if (Intent.ACTION_POWER_DISCONNECTED.equals(action)) {
+            disableOnDisconnect(context);
+        }
+    }
+
+    /**
+     * Re-applies the stored state after boot: once, idempotently, and only when it was on and the
+     * adapter is connected. Below the safety floor the stored state is dropped, with charging
+     * restored; a firmware without the HAL keeps the choice and skips the call.
+     */
+    static void reapplyAtBoot(Context context) {
+        if (!ChargingSeparation.isEnabled()) {
+            return;
+        }
+        if (!ChargingSeparation.isPlugged(context) || !ChargingSeparation.isAboveGuard(context)) {
+            disableOnDisconnect(context);
+            return;
+        }
+        if (!ChargingSeparationHal.isSupported()) {
+            // No HAL on this firmware: keep the user's choice, make no call, never loop.
+            return;
+        }
+        if (ChargingSeparationHal.setChargingEnabled(false)
+                != ChargingSeparationHal.Result.OK) {
+            // Fail open: the state is not trustworthy, so stop claiming separation and restore.
+            ChargingSeparation.setEnabled(false);
+            ChargingSeparationHal.setChargingEnabled(true);
+        }
+    }
+
+    /**
+     * Clears separation and restores charging when the adapter is unplugged. The restore is
+     * unconditional, so a crash between stopping charging and persisting the state is healed by the
+     * next unplug even though the property already reads {@code 0}.
+     */
+    static void disableOnDisconnect(Context context) {
+        if (ChargingSeparation.isEnabled()) {
+            ChargingSeparation.setEnabled(false);
+        }
+        ChargingSeparationHal.setChargingEnabled(true);
+    }
+}
