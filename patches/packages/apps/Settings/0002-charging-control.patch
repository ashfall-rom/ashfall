+ * limitations under the License.
+ */
+
+package com.android.settings.fuelgauge.chargecontrol;
+
+import android.app.settings.SettingsEnums;
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.os.Bundle;
+import android.widget.Toast;
+
+import androidx.preference.Preference;
+import androidx.preference.SwitchPreferenceCompat;
+
+import com.android.settings.R;
+import com.android.settings.SettingsPreferenceFragment;
+
+/**
+ * Settings &gt; Battery &gt; Charging control: the manual charging-separation toggle, the firmware
+ * support state and the battery-care note for the 80 %/10 % policy.
+ *
+ * <p>Separation stops charging while the adapter stays connected. The state is stored in {@code
+ * persist.ashfall.batt.charge_sep}, re-applied at boot by {@link ChargingControlReceiver}, dropped
+ * on unplug, and never enabled below 20 % or without the charger. Every error path fails open to
+ * charging (docs/settings-battery.md).
+ */
+public class ChargingControlSettings extends SettingsPreferenceFragment
+        implements Preference.OnPreferenceChangeListener {
+
+    private static final String KEY_SEPARATION = "charging_separation";
+    private static final String KEY_SUPPORT = "charging_support";
+
+    private SwitchPreferenceCompat mSeparation;
+    private Preference mSupport;
+    private boolean mSupported;
+
+    private final BroadcastReceiver mPowerReceiver =
+            new BroadcastReceiver() {
+                @Override
+                public void onReceive(Context context, Intent intent) {
+                    if (Intent.ACTION_POWER_DISCONNECTED.equals(intent.getAction())) {
+                        ChargingControlReceiver.disableOnDisconnect(context);
+                        bindState();
+                    }
+                }
+            };
+
+    @Override
+    public void onCreatePreferences(Bundle savedInstanceState, String rootKey) {
+        addPreferencesFromResource(R.xml.charging_control_settings);
+
+        mSeparation = findPreference(KEY_SEPARATION);
+        mSupport = findPreference(KEY_SUPPORT);
+        mSeparation.setOnPreferenceChangeListener(this);
+
+        mSupported = ChargingSeparationHal.isSupported();
+        if (mSupported) {
+            mSupport.setSummary(R.string.charging_control_supported);
+        } else {
+            // Keep the stored choice: getService() does not wait for the vendor service, so a miss
+            // can be transient. The toggle stays disabled and no HAL call is made.
+            mSupport.setSummary(R.string.charging_control_unsupported);
+            mSeparation.setEnabled(false);
+        }
+        bindState();
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        getContext()
+                .registerReceiver(
+                        mPowerReceiver,
+                        new IntentFilter(Intent.ACTION_POWER_DISCONNECTED),
+                        Context.RECEIVER_NOT_EXPORTED);
+        // A state that survived while the adapter was away has no effect: drop it and restore.
+        if (ChargingSeparation.isEnabled()
+                && !ChargingSeparation.isPlugged(getContext())) {
+            ChargingControlReceiver.disableOnDisconnect(getContext());
+        }
+        bindState();
+    }
+
+    @Override
+    public void onPause() {
+        super.onPause();
+        getContext().unregisterReceiver(mPowerReceiver);
+    }
+
+    @Override
+    public int getMetricsCategory() {
+        return SettingsEnums.FUELGAUGE_POWER_USAGE_SUMMARY_V2;
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        if (!KEY_SEPARATION.equals(preference.getKey())) {
+            return false;
+        }
+        final boolean enable = (Boolean) newValue;
+        if (!enable) {
+            return disable();
+        }
+        if (!mSupported) {
+            Toast.makeText(
+                            getContext(),
+                            R.string.charging_control_unsupported,
+                            Toast.LENGTH_SHORT)
+                    .show();
+            return false;
+        }
+        if (!ChargingSeparation.isPlugged(getContext())) {
+            Toast.makeText(
+                            getContext(),
+                            R.string.charging_control_not_plugged,
+                            Toast.LENGTH_SHORT)
+                    .show();
+            return false;
+        }
+        if (!ChargingSeparation.isAboveGuard(getContext())) {
+            Toast.makeText(
+                            getContext(),
+                            R.string.charging_control_below_min,
+                            Toast.LENGTH_SHORT)
+                    .show();
+            return false;
+        }
+        final ChargingSeparationHal.Result result =
+                ChargingSeparationHal.setChargingEnabled(false);
+        if (result == ChargingSeparationHal.Result.OK
+                && ChargingSeparation.setEnabled(true)) {
+            return true;
+        }
+        // Fail open: make sure the charger is enabled again and nothing is persisted.
+        ChargingSeparation.setEnabled(false);
+        ChargingSeparationHal.setChargingEnabled(true);
+        final boolean unsupported = result == ChargingSeparationHal.Result.UNSUPPORTED;
+        if (unsupported) {
+            mSupported = false;
+            mSupport.setSummary(R.string.charging_control_unsupported);
+            mSeparation.setEnabled(false);
+        }
+        Toast.makeText(
+                        getContext(),
+                        unsupported
+                                ? R.string.charging_control_unsupported
+                                : R.string.charging_control_apply_failed,
+                        Toast.LENGTH_LONG)
+                .show();
+        return false;
+    }
+
+    /** Turns separation off: clear the stored state first, then restore charging. */
+    private boolean disable() {
+        final boolean cleared = ChargingSeparation.setEnabled(false);
+        final boolean restored =
+                ChargingSeparationHal.setChargingEnabled(true)
+                        == ChargingSeparationHal.Result.OK;
+        if (!cleared) {
+            // The switch must not claim "off" while the property still re-applies at boot.
+            Toast.makeText(
+                            getContext(),
+                            R.string.charging_control_apply_failed,
+                            Toast.LENGTH_LONG)
+                    .show();
+            return false;
+        }
+        if (!restored) {
+            Toast.makeText(
+                            getContext(),
+                            R.string.charging_control_restore_failed,
+                            Toast.LENGTH_LONG)
+                    .show();
+        }
+        return true;
+    }
+
+    /** Mirrors the stored state; the property, not the switch, is the source of truth. */
+    private void bindState() {
+        if (mSeparation != null) {
+            mSeparation.setChecked(mSupported && ChargingSeparation.isEnabled());
+        }
+    }
+}
