+package com.android.settings.fuelgauge.chargecontrol;
+
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.os.BatteryManager;
+import android.os.SystemProperties;
+import android.util.Log;
+
+/**
+ * Stored charging-separation state and the safety limits around it.
+ *
+ * <p>The property is the only storage: the boot receiver and the unplug receiver re-read it, and a
+ * value that is not exactly {@code 1} means off. A rejected property write is logged and reported
+ * to the caller, never thrown at the page (docs/settings-battery.md).
+ */
+public final class ChargingSeparation {
+
+    private static final String TAG = "ChargingSeparation";
+
+    /** Off ({@code 0}) or separation enabled ({@code 1}). */
+    public static final String KEY_ENABLED = "persist.ashfall.batt.charge_sep";
+
+    /** Separation is refused below this level, the same floor the stock policy resumes at. */
+    public static final int MIN_LEVEL = 20;
+
+    private static final int MAX_LEVEL = 100;
+
+    private ChargingSeparation() {}
+
+    /** Whether the user left separation on; anything but {@code 1} is off. */
+    public static boolean isEnabled() {
+        return "1".equals(SystemProperties.get(KEY_ENABLED, "0"));
+    }
+
+    /**
+     * Persists the user's choice.
+     *
+     * @return {@code true} when the property reads back as requested; a rejected write (SELinux,
+     *     invalid name) is logged and the caller fails open to charging.
+     */
+    public static boolean setEnabled(boolean enabled) {
+        final String value = enabled ? "1" : "0";
+        try {
+            SystemProperties.set(KEY_ENABLED, value);
+        } catch (RuntimeException e) {
+            Log.w(TAG, "Failed to set " + KEY_ENABLED + " to " + value, e);
+            return false;
+        }
+        return value.equals(SystemProperties.get(KEY_ENABLED, ""));
+    }
+
+    /**
+     * Battery percentage from the sticky {@code ACTION_BATTERY_CHANGED} broadcast, or {@code -1}
+     * when the framework does not report a usable level. Unknown counts as "not above the guard".
+     */
+    public static int batteryLevel(Context context) {
+        final Intent battery = stickyBattery(context);
+        if (battery == null) {
+            return -1;
+        }
+        final int level = battery.getIntExtra(BatteryManager.EXTRA_LEVEL, -1);
+        final int scale = battery.getIntExtra(BatteryManager.EXTRA_SCALE, -1);
+        if (level < 0 || scale <= 0) {
+            return -1;
+        }
+        return Math.min(MAX_LEVEL, Math.round(level * (float) MAX_LEVEL / scale));
+    }
+
+    /** True when the battery is known to be at or above {@link #MIN_LEVEL}. */
+    public static boolean isAboveGuard(Context context) {
+        return batteryLevel(context) >= MIN_LEVEL;
+    }
+
+    /**
+     * Whether an adapter is connected. Enabling separation while unplugged would show a switch that
+     * does nothing, and re-applying a stale state at boot must not disable charging the moment the
+     * user plugs in, so both paths ask this first.
+     */
+    public static boolean isPlugged(Context context) {
+        final Intent battery = stickyBattery(context);
+        return battery != null && battery.getIntExtra(BatteryManager.EXTRA_PLUGGED, 0) != 0;
+    }
+
+    private static Intent stickyBattery(Context context) {
+        return context.registerReceiver(null, new IntentFilter(Intent.ACTION_BATTERY_CHANGED));
+    }
+}
