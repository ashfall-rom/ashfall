+package com.android.settings.fuelgauge.chargecontrol;
+
+import android.os.HwBinder;
+import android.os.HwParcel;
+import android.os.IHwBinder;
+import android.os.RemoteException;
+import android.util.Log;
+
+import com.android.settingslib.utils.ThreadUtils;
+
+import java.util.NoSuchElementException;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+/**
+ * HwBinder client for the retail vendor factory HAL ({@code
+ * vendor.qti.hardware.factory@1.1::IFactory}), the only surface that stops charging on the RP5: the
+ * PM8150B power-supply nodes expose no writable charge-enable node, and {@code
+ * charge_control_limit} is read-only.
+ *
+ * <p>It speaks HwBinder directly instead of using a generated HIDL proxy. The vendor Java stubs are
+ * not installed on the RP5: {@code pm list libraries} reports only {@code android.hidl.base} and
+ * {@code android.hidl.manager}, there is no factory jar under {@code /system/framework} or {@code
+ * /system_ext/framework}, and nothing links one into Settings' classloader, so a reflective {@code
+ * Class.forName} cannot reach them. {@code android.os.HwBinder}, {@code android.os.HwParcel} and
+ * {@code android.os.IHwBinder} are platform APIs and Settings builds with {@code platform_apis},
+ * so the descriptor, the single boolean argument and the transaction code are enough.
+ *
+ * <p><b>Transaction.</b> {@code IFactory.chargerEnable(boolean)} is transaction code 4 on both 1.0
+ * and 1.1 (1.1 extends 1.0 without changing it). The disassembled {@code
+ * BpHwFactory::_hidl_chargerEnable} writes the interface token, then the boolean, then transacts 4;
+ * this client does the same. The method is void, so the only thing expected in the reply is the
+ * HIDL status word, verified when present and never read as a return value.
+ *
+ * <p><b>Lazy start.</b> The vendor service is declared {@code disabled} and {@code oneshot} in
+ * {@code /vendor/etc/init/vendor.qti.hardware.factory@1.0-service.rc}, and system
+ * {@code hwservicemanager} issues {@code ctl.interface_start} when a client asks for a service
+ * that is not registered. The first lookup can therefore miss while the process starts, which is
+ * why a lookup is retried a few times (5 x 300 ms) before an interface counts as absent.
+ *
+ * <p>The RP5 registers 1.1 only ({@code docs/stock/vintf/manifest.xml}), and HIDL lookup is an
+ * exact fqname match, so 1.1 is probed first and 1.0 is the fallback for firmware that registered
+ * the older version. Every failure is reported as a {@link Result}, never thrown, and every call
+ * runs on its own background thread with the answer posted back to the main thread
+ * (docs/settings-battery.md §8.4).
+ */
+public final class ChargingSeparationHal {
+
+    private static final String TAG = "ChargingSeparationHal";
+
+    /** HIDL instance name; the vendor service registers {@code default}. */
+    private static final String SERVICE_NAME = "default";
+
+    /** Probe order: the RP5 registers 1.1, older or other builds may register 1.0. */
+    private static final String[] INTERFACES = {
+        "vendor.qti.hardware.factory@1.1::IFactory",
+        "vendor.qti.hardware.factory@1.0::IFactory",
+    };
+
+    /** {@code IFactory.chargerEnable(boolean)} in the vendor proxy ({@code BpHwFactory}). */
+    private static final int TRANSACTION_CHARGER_ENABLE = 4;
+
+    /** Lazy start needs a moment: the first lookup is what asks init to start the service. */
+    private static final int LOOKUP_ATTEMPTS = 5;
+
+    private static final long LOOKUP_RETRY_MS = 300L;
+
+    private static final Object sLock = new Object();
+
+    /**
+     * One dedicated thread: a transaction can wait for the lazy start, and Settings' shared
+     * background pool must not be blocked for that long. Serialising the calls also matches the
+     * single vendor service.
+     */
+    private static final ExecutorService sExecutor =
+            Executors.newSingleThreadExecutor(
+                    runnable -> {
+                        final Thread thread = new Thread(runnable, "ChargingSeparationHal");
+                        thread.setDaemon(true);
+                        return thread;
+                    });
+
+    /** The proxy that last answered, so repeated calls skip the lookup. Guarded by sLock. */
+    private static IHwBinder sBinder;
+
+    private static String sInterface;
+
+    private ChargingSeparationHal() {}
+
+    /** Outcome of one {@code chargerEnable} call. */
+    public enum Result {
+        /** The HAL accepted the request. */
+        OK,
+        /** Neither interface answered after the lookups: no factory HAL on this firmware. */
+        UNSUPPORTED,
+        /** A service answered but the transaction failed; the caller must fail open to charging. */
+        FAILED
+    }
+
+    /** Reports a result on the main thread. */
+    public interface Callback {
+        void onResult(Result result);
+    }
+
+    /**
+     * Stops ({@code enabled=false}) or resumes ({@code enabled=true}) battery charging.
+     *
+     * <p>Runs on a dedicated background thread and posts the answer to the main thread: a lookup
+     * may wait up to 5 x 300 ms per interface for the lazy start, so this must never run on the
+     * main thread. {@code callback} may be {@code null}.
+     *
+     * <p>Never throws: {@link Result#UNSUPPORTED} covers a firmware without the factory service and
+     * {@link Result#FAILED} covers a resolved service whose transaction was rejected, so the caller
+     * can fail open to charging.
+     */
+    public static void setChargingEnabled(boolean enabled, Callback callback) {
+        sExecutor.execute(
+                () -> {
+                    final Result result = apply(enabled);
+                    if (callback != null) {
+                        ThreadUtils.getUiThreadHandler().post(() -> callback.onResult(result));
+                    }
+                });
+    }
+
+    /** Blocking body of {@link #setChargingEnabled}; the HAL executor only. */
+    private static Result apply(boolean enabled) {
+        Result failure = Result.UNSUPPORTED;
+        for (String iface : INTERFACES) {
+            final IHwBinder binder = getService(iface);
+            if (binder == null) {
+                Log.i(
+                        TAG,
+                        "No "
+                                + iface
+                                + "/"
+                                + SERVICE_NAME
+                                + " after "
+                                + LOOKUP_ATTEMPTS
+                                + " lookups (lazy start did not produce it)");
+                continue;
+            }
+            synchronized (sLock) {
+                sBinder = binder;
+                sInterface = iface;
+            }
+            if (transact(binder, iface, enabled) == Result.OK) {
+                return Result.OK;
+            }
+            // A resolved service that rejects the call is a failure, not an absent HAL.
+            failure = Result.FAILED;
+        }
+        Log.i(
+                TAG,
+                "chargerEnable("
+                        + enabled
+                        + ") not applied: "
+                        + failure
+                        + " (tried "
+                        + INTERFACES[0]
+                        + " and "
+                        + INTERFACES[1]
+                        + ")");
+        return failure;
+    }
+
+    /**
+     * Returns the registered proxy for {@code iface}, retrying because the first lookup is what
+     * triggers the HIDL lazy start. A cached proxy is reused until a transaction fails.
+     */
+    private static IHwBinder getService(String iface) {
+        synchronized (sLock) {
+            if (sBinder != null && iface.equals(sInterface)) {
+                return sBinder;
+            }
+        }
+        for (int attempt = 1; attempt <= LOOKUP_ATTEMPTS; attempt++) {
+            try {
+                final IHwBinder binder = HwBinder.getService(iface, SERVICE_NAME);
+                if (binder != null) {
+                    Log.i(TAG, "Resolved " + iface + "/" + SERVICE_NAME + " on lookup " + attempt);
+                    return binder;
+                }
+                Log.i(
+                        TAG,
+                        "Lookup "
+                                + attempt
+                                + "/"
+                                + LOOKUP_ATTEMPTS
+                                + " for "
+                                + iface
+                                + " returned no proxy");
+            } catch (NoSuchElementException e) {
+                Log.i(
+                        TAG,
+                        "Lookup "
+                                + attempt
+                                + "/"
+                                + LOOKUP_ATTEMPTS
+                                + " for "
+                                + iface
+                                + ": not registered yet");
+            } catch (RemoteException e) {
+                Log.w(
+                        TAG,
+                        "Lookup "
+                                + attempt
+                                + "/"
+                                + LOOKUP_ATTEMPTS
+                                + " for "
+                                + iface
+                                + " failed in hwservicemanager",
+                        e);
+            }
+            if (attempt < LOOKUP_ATTEMPTS) {
+                try {
+                    Thread.sleep(LOOKUP_RETRY_MS);
+                } catch (InterruptedException e) {
+                    Thread.currentThread().interrupt();
+                    Log.i(TAG, "Lookup for " + iface + " interrupted");
+                    return null;
+                }
+            }
+        }
+        return null;
+    }
+
+    /**
+     * One {@code chargerEnable} transaction: the interface token and the boolean go out, and the
+     * reply is a void HIDL status. Reading the status is deliberate but optional - a reply without
+     * one is not an error, because nothing else is returned.
+     */
+    private static Result transact(IHwBinder binder, String iface, boolean enabled) {
+        final HwParcel request = new HwParcel();
+        final HwParcel reply = new HwParcel();
+        try {
+            request.writeInterfaceToken(iface);
+            request.writeBool(enabled);
+            binder.transact(TRANSACTION_CHARGER_ENABLE, request, reply, 0 /* synchronous */);
+            try {
+                reply.verifySuccess();
+            } catch (IllegalArgumentException e) {
+                // Void method with an empty reply: there is no status word to read.
+                Log.i(
+                        TAG,
+                        "chargerEnable("
+                                + enabled
+                                + ") on "
+                                + iface
+                                + " returned no status word");
+            }
+            Log.i(TAG, "chargerEnable(" + enabled + ") on " + iface + ": ok");
+            return Result.OK;
+        } catch (RemoteException e) {
+            Log.w(TAG, "chargerEnable(" + enabled + ") on " + iface + " failed", e);
+            // The vendor process may have died; re-resolve on the next call.
+            synchronized (sLock) {
+                if (binder == sBinder) {
+                    sBinder = null;
+                    sInterface = null;
+                }
+            }
+            return Result.FAILED;
+        } catch (RuntimeException e) {
+            Log.w(TAG, "chargerEnable(" + enabled + ") on " + iface + " was rejected", e);
+            return Result.FAILED;
+        } finally {
+            request.release();
+            reply.release();
+        }
+    }
+}
