+
+package com.android.settings.fuelgauge.playtime;
+
+import android.app.settings.SettingsEnums;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.text.TextUtils;
+import android.widget.Toast;
+
+import androidx.preference.ListPreference;
+import androidx.preference.MultiSelectListPreference;
+import androidx.preference.Preference;
+import androidx.preference.SwitchPreferenceCompat;
+
+import com.android.settings.R;
+import com.android.settings.SettingsPreferenceFragment;
+import com.android.settings.widget.SeekBarPreference;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.Set;
+
+/**
+ * Settings for the PlayTime indicator that lives in the status bar.
+ *
+ * <p>Every row reads {@code persist.ashfall.batt.*} once when the page opens and writes it back on
+ * change; SystemUI applies the change live and owns the defaults, so an unset or malformed value
+ * only ever falls back to the documented default (docs/settings-battery.md).
+ */
+public class PlayTimeSettings extends SettingsPreferenceFragment
+        implements Preference.OnPreferenceChangeListener {
+
+    public static final String TAG = "PlayTimeSettings";
+
+    /** ashfall-hwd publishes its power telemetry on a 2 s tick (docs/phase6.md §9.3). */
+    private static final int READOUT_REFRESH_MS = 2000;
+
+    private static final String KEY_SHOW = "playtime_show";
+
+    private static final String KEY_PLACEMENT = "playtime_placement";
+    private static final String KEY_DETAIL = "playtime_detail";
+    private static final String KEY_FORMAT = "playtime_format";
+    private static final String KEY_WINDOW = "playtime_window";
+    private static final String KEY_INTERVAL = "playtime_interval";
+    private static final String KEY_CHARGING_SYMBOL = "playtime_charging_symbol";
+    private static final String KEY_CHARGING_CYCLE = "playtime_charging_cycle";
+    private static final String KEY_CHARGING_CYCLE_MS = "playtime_charging_cycle_ms";
+    private static final String KEY_CHARGING_METERS = "playtime_charging_meters";
+    private static final String KEY_TAP_CYCLE = "playtime_tap_cycle";
+    private static final String KEY_FONT_SIZE = "playtime_font_size";
+    private static final String KEY_CAPACITY = "playtime_capacity";
+    private static final String KEY_READOUT = "playtime_readout";
+
+    private final Handler mHandler = new Handler(Looper.getMainLooper());
+
+    private final Runnable mReadoutUpdater =
+            new Runnable() {
+                @Override
+                public void run() {
+                    updateReadout();
+                    mHandler.postDelayed(this, READOUT_REFRESH_MS);
+                }
+            };
+
+    private SwitchPreferenceCompat mShow;
+    private ListPreference mPlacement;
+    private ListPreference mDetail;
+    private ListPreference mFormat;
+    private ListPreference mWindow;
+    private SeekBarPreference mInterval;
+    private ListPreference mChargingSymbol;
+    private SwitchPreferenceCompat mChargingCycle;
+    private SeekBarPreference mChargingCycleMs;
+    private MultiSelectListPreference mChargingMeters;
+    private SwitchPreferenceCompat mTapCycle;
+    private SeekBarPreference mFontSize;
+    private PlayTimeCapacityPreference mCapacity;
+    private Preference mReadout;
+
+    @Override
+    public void onCreatePreferences(Bundle savedInstanceState, String rootKey) {
+        addPreferencesFromResource(R.xml.playtime_settings);
+
+        mShow = findPreference(KEY_SHOW);
+        mPlacement = findPreference(KEY_PLACEMENT);
+        mDetail = findPreference(KEY_DETAIL);
+        mFormat = findPreference(KEY_FORMAT);
+        mWindow = findPreference(KEY_WINDOW);
+        mInterval = findPreference(KEY_INTERVAL);
+        mChargingSymbol = findPreference(KEY_CHARGING_SYMBOL);
+        mChargingCycle = findPreference(KEY_CHARGING_CYCLE);
+        mChargingCycleMs = findPreference(KEY_CHARGING_CYCLE_MS);
+        mChargingMeters = findPreference(KEY_CHARGING_METERS);
+        mTapCycle = findPreference(KEY_TAP_CYCLE);
+        mFontSize = findPreference(KEY_FONT_SIZE);
+        mCapacity = findPreference(KEY_CAPACITY);
+        mReadout = findPreference(KEY_READOUT);
+
+        for (Preference preference :
+                new Preference[] {
+                    mShow,
+                    mPlacement,
+                    mDetail,
+                    mFormat,
+                    mWindow,
+                    mInterval,
+                    mChargingSymbol,
+                    mChargingCycle,
+                    mChargingCycleMs,
+                    mChargingMeters,
+                    mTapCycle,
+                    mFontSize,
+                    mCapacity
+                }) {
+            preference.setOnPreferenceChangeListener(this);
+        }
+
+        bindValues();
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        mHandler.post(mReadoutUpdater);
+    }
+
+    @Override
+    public void onPause() {
+        super.onPause();
+        mHandler.removeCallbacks(mReadoutUpdater);
+    }
+
+    @Override
+    public int getMetricsCategory() {
+        return SettingsEnums.FUELGAUGE_POWER_USAGE_SUMMARY_V2;
+    }
+
+    @Override
+    public boolean onPreferenceChange(Preference preference, Object newValue) {
+        final String key = preference.getKey();
+        if (KEY_SHOW.equals(key)) {
+            PlayTimeProperties.setBoolean(PlayTimeProperties.KEY_SHOW, (Boolean) newValue);
+        } else if (KEY_PLACEMENT.equals(key)) {
+            PlayTimeProperties.set(PlayTimeProperties.KEY_PLACEMENT, (String) newValue);
+        } else if (KEY_DETAIL.equals(key)) {
+            PlayTimeProperties.set(PlayTimeProperties.KEY_DETAIL, (String) newValue);
+        } else if (KEY_FORMAT.equals(key)) {
+            PlayTimeProperties.set(PlayTimeProperties.KEY_FORMAT, (String) newValue);
+        } else if (KEY_WINDOW.equals(key)) {
+            PlayTimeProperties.set(PlayTimeProperties.KEY_WINDOW, (String) newValue);
+        } else if (KEY_INTERVAL.equals(key)) {
+            final int seconds = (Integer) newValue;
+            PlayTimeProperties.setInt(PlayTimeProperties.KEY_INTERVAL, seconds);
+            updateIntervalSummary(seconds);
+        } else if (KEY_CHARGING_SYMBOL.equals(key)) {
+            PlayTimeProperties.set(PlayTimeProperties.KEY_CHARGING_SYMBOL, (String) newValue);
+        } else if (KEY_CHARGING_CYCLE.equals(key)) {
+            PlayTimeProperties.setBoolean(
+                    PlayTimeProperties.KEY_CHARGING_CYCLE, (Boolean) newValue);
+        } else if (KEY_CHARGING_CYCLE_MS.equals(key)) {
+            final int cycleMs = toChargingCycleMs((Integer) newValue);
+            PlayTimeProperties.setInt(PlayTimeProperties.KEY_CHARGING_CYCLE_MS, cycleMs);
+            updateChargingCycleSummary(cycleMs);
+        } else if (KEY_CHARGING_METERS.equals(key)) {
+            final Set<String> meters = toStringSet(newValue);
+            if (meters.size() < PlayTimeProperties.MIN_CHARGING_METERS
+                    || meters.size() > PlayTimeProperties.MAX_CHARGING_METERS) {
+                Toast.makeText(getContext(), R.string.playtime_charging_meters_hint,
+                        Toast.LENGTH_SHORT).show();
+                return false;
+            }
+            PlayTimeProperties.set(
+                    PlayTimeProperties.KEY_CHARGING_METERS,
+                    PlayTimeProperties.toPropertyValue(meters, mChargingMeters.getEntryValues()));
+            updateChargingMetersSummary(meters);
+        } else if (KEY_TAP_CYCLE.equals(key)) {
+            PlayTimeProperties.setBoolean(PlayTimeProperties.KEY_TAP_CYCLE, (Boolean) newValue);
+        } else if (KEY_FONT_SIZE.equals(key)) {
+            final int sizeSp = (Integer) newValue;
+            PlayTimeProperties.setInt(PlayTimeProperties.KEY_FONT_SIZE_SP, sizeSp);
+            updateFontSizeSummary(sizeSp);
+        } else if (KEY_CAPACITY.equals(key)) {
+            final int capacityMah = parseCapacity((String) newValue);
+            PlayTimeProperties.setInt(PlayTimeProperties.KEY_CAPACITY_MAH, capacityMah);
+            updateCapacitySummary(capacityMah);
+        } else {
+            return false;
+        }
+        return true;
+    }
+
+    private void bindValues() {
+        mShow.setChecked(
+                PlayTimeProperties.getBoolean(
+                        PlayTimeProperties.KEY_SHOW, PlayTimeProperties.DEFAULT_SHOW));
+
+        bindList(
+                mPlacement,
+                PlayTimeProperties.KEY_PLACEMENT,
+                PlayTimeProperties.DEFAULT_PLACEMENT);
+        bindList(mDetail, PlayTimeProperties.KEY_DETAIL, PlayTimeProperties.DEFAULT_DETAIL);
+        bindList(mFormat, PlayTimeProperties.KEY_FORMAT, PlayTimeProperties.DEFAULT_FORMAT);
+        bindList(mWindow, PlayTimeProperties.KEY_WINDOW, PlayTimeProperties.DEFAULT_WINDOW);
+        bindList(
+                mChargingSymbol,
+                PlayTimeProperties.KEY_CHARGING_SYMBOL,
+                PlayTimeProperties.DEFAULT_CHARGING_SYMBOL);
+
+        final int interval =
+                PlayTimeProperties.getInt(
+                        PlayTimeProperties.KEY_INTERVAL,
+                        PlayTimeProperties.DEFAULT_INTERVAL,
+                        PlayTimeProperties.MIN_INTERVAL,
+                        PlayTimeProperties.MAX_INTERVAL);
+        mInterval.setProgress(interval);
+        updateIntervalSummary(interval);
+
+        mChargingCycle.setChecked(
+                PlayTimeProperties.getBoolean(
+                        PlayTimeProperties.KEY_CHARGING_CYCLE,
+                        PlayTimeProperties.DEFAULT_CHARGING_CYCLE));
+
+        final int cycleMs =
+                PlayTimeProperties.getInt(
+                        PlayTimeProperties.KEY_CHARGING_CYCLE_MS,
+                        PlayTimeProperties.DEFAULT_CHARGING_CYCLE_MS,
+                        PlayTimeProperties.MIN_CHARGING_CYCLE_MS,
+                        PlayTimeProperties.MAX_CHARGING_CYCLE_MS);
+        mChargingCycleMs.setProgress(toChargingCycleStep(cycleMs));
+        updateChargingCycleSummary(cycleMs);
+
+        final Set<String> meters =
+                new HashSet<>(
+                        PlayTimeProperties.getList(
+                                PlayTimeProperties.KEY_CHARGING_METERS,
+                                mChargingMeters.getEntryValues(),
+                                PlayTimeProperties.DEFAULT_CHARGING_METERS));
+        mChargingMeters.setValues(meters);
+        updateChargingMetersSummary(meters);
+
+        mTapCycle.setChecked(
+                PlayTimeProperties.getBoolean(
+                        PlayTimeProperties.KEY_TAP_CYCLE, PlayTimeProperties.DEFAULT_TAP_CYCLE));
+
+        final int sizeSp =
+                PlayTimeProperties.getInt(
+                        PlayTimeProperties.KEY_FONT_SIZE_SP,
+                        PlayTimeProperties.DEFAULT_FONT_SIZE_SP,
+                        PlayTimeProperties.MIN_FONT_SIZE_SP,
+                        PlayTimeProperties.MAX_FONT_SIZE_SP);
+        mFontSize.setProgress(sizeSp);
+        updateFontSizeSummary(sizeSp);
+
+        final int capacityMah =
+                PlayTimeProperties.getInt(
+                        PlayTimeProperties.KEY_CAPACITY_MAH,
+                        PlayTimeProperties.DEFAULT_CAPACITY_MAH,
+                        PlayTimeProperties.MIN_CAPACITY_MAH,
+                        PlayTimeProperties.MAX_CAPACITY_MAH);
+        mCapacity.setText(Integer.toString(capacityMah));
+        updateCapacitySummary(capacityMah);
+    }
+
+    private static void bindList(ListPreference preference, String property, String defaultValue) {
+        preference.setValue(
+                PlayTimeProperties.getChoice(
+                        property, preference.getEntryValues(), defaultValue));
+    }
+
+    private void updateReadout() {
+        if (mReadout == null) {
+            return;
+        }
+        mReadout.setSummary(PlayTimeProperties.buildReadout(getContext()));
+    }
+
+    private void updateIntervalSummary(int seconds) {
+        mInterval.setSummary(getString(R.string.playtime_seconds, seconds));
+    }
+
+    private void updateChargingCycleSummary(int cycleMs) {
+        final String seconds = String.format(Locale.getDefault(), "%.1f", cycleMs / 1000f);
+        mChargingCycleMs.setSummary(
+                getString(R.string.playtime_seconds_tenths, seconds));
+    }
+
+    private void updateChargingMetersSummary(Set<String> meters) {
+        final List<String> labels = new ArrayList<>();
+        final CharSequence[] values = mChargingMeters.getEntryValues();
+        final CharSequence[] entries = mChargingMeters.getEntries();
+        for (int i = 0; i < values.length; i++) {
+            if (meters.contains(values[i].toString())) {
+                labels.add(entries[i].toString());
+            }
+        }
+        mChargingMeters.setSummary(TextUtils.join(", ", labels));
+    }
+
+    private void updateFontSizeSummary(int sizeSp) {
+        mFontSize.setSummary(getString(R.string.playtime_font_size_summary, sizeSp));
+    }
+
+    private void updateCapacitySummary(int capacityMah) {
+        mCapacity.setSummary(
+                capacityMah == 0
+                        ? getString(R.string.playtime_capacity_summary_auto)
+                        : getString(R.string.playtime_capacity_summary, capacityMah));
+    }
+
+    private static int toChargingCycleStep(int cycleMs) {
+        final int stepMs = cycleMs - PlayTimeProperties.MIN_CHARGING_CYCLE_MS;
+        return Math.round((float) stepMs / PlayTimeProperties.STEP_CHARGING_CYCLE_MS);
+    }
+
+    private static int toChargingCycleMs(int step) {
+        return PlayTimeProperties.MIN_CHARGING_CYCLE_MS
+                + step * PlayTimeProperties.STEP_CHARGING_CYCLE_MS;
+    }
+
+    private static int parseCapacity(String text) {
+        if (TextUtils.isEmpty(text)) {
+            return PlayTimeProperties.DEFAULT_CAPACITY_MAH;
+        }
+        try {
+            final int capacityMah = Integer.parseInt(text.trim());
+            if (capacityMah >= PlayTimeProperties.MIN_CAPACITY_MAH
+                    && capacityMah <= PlayTimeProperties.MAX_CAPACITY_MAH) {
+                return capacityMah;
+            }
+        } catch (NumberFormatException e) {
+            // Fall through to auto: the dialog validator already rejects unparsable input.
+        }
+        return PlayTimeProperties.DEFAULT_CAPACITY_MAH;
+    }
+
+    private static Set<String> toStringSet(Object value) {
+        final Set<String> result = new HashSet<>();
+        if (value instanceof Set) {
+            for (Object item : (Set<?>) value) {
+                result.add(String.valueOf(item));
+            }
+        }
+        return result;
+    }
+}
