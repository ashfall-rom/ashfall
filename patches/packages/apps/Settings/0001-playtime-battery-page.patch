+package com.android.settings.fuelgauge.playtime;
+
+import android.content.Context;
+import android.text.InputType;
+import android.util.AttributeSet;
+import android.view.View;
+import android.widget.EditText;
+
+import androidx.annotation.Nullable;
+
+import com.android.settings.widget.ValidatedEditTextPreference;
+
+/**
+ * Numeric dialog for the PlayTime battery capacity: {@code 0} means auto, anything else is a
+ * manual capacity in mAh. Values outside the accepted range cannot be confirmed.
+ */
+public class PlayTimeCapacityPreference extends ValidatedEditTextPreference {
+
+    public PlayTimeCapacityPreference(Context context, AttributeSet attrs, int defStyleAttr,
+            int defStyleRes) {
+        super(context, attrs, defStyleAttr, defStyleRes);
+        init();
+    }
+
+    public PlayTimeCapacityPreference(Context context, AttributeSet attrs, int defStyleAttr) {
+        super(context, attrs, defStyleAttr);
+        init();
+    }
+
+    public PlayTimeCapacityPreference(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        init();
+    }
+
+    public PlayTimeCapacityPreference(Context context) {
+        super(context);
+        init();
+    }
+
+    private void init() {
+        setValidator(this::isCapacityValid);
+    }
+
+    @Override
+    protected void onBindDialogView(View view) {
+        super.onBindDialogView(view);
+        final EditText editText = view.findViewById(android.R.id.edit);
+        if (editText != null) {
+            editText.setInputType(InputType.TYPE_CLASS_NUMBER);
+        }
+    }
+
+    private boolean isCapacityValid(@Nullable String text) {
+        if (text == null || text.isEmpty()) {
+            return false;
+        }
+        final int capacity;
+        try {
+            capacity = Integer.parseInt(text);
+        } catch (NumberFormatException e) {
+            return false;
+        }
+        return capacity >= PlayTimeProperties.MIN_CAPACITY_MAH
+                && capacity <= PlayTimeProperties.MAX_CAPACITY_MAH;
+    }
+}
