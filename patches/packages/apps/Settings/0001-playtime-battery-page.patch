+
+/**
+ * Property access and display formatting for the PlayTime indicator ({@code
+ * persist.ashfall.batt.*}).
+ *
+ * <p>Settings stores the user's choice only. SystemUI owns the defaults, the estimator and the
+ * clamping, so an unset or malformed value is shown as the documented default and is never written
+ * back by this page, and a rejected property write is logged instead of failing the page
+ * (docs/settings-battery.md, docs/phase6.md §9.3).
+ *
+ * <p>The live values come from the framework's {@link BatteryManager} - the sticky {@code
+ * ACTION_BATTERY_CHANGED} broadcast plus {@code BATTERY_PROPERTY_CURRENT_NOW} and {@code
+ * BATTERY_PROPERTY_CHARGE_COUNTER} - not from {@code ashfall.status.*}: there is no battery sampler
+ * in {@code ashfall-hwd} (a coredomain cannot read the RP5's vendor-labeled power-supply nodes).
+ */
+public final class PlayTimeProperties {
+
+    private static final String TAG = "PlayTimeProperties";
+
+    /** Properties written by the PlayTime page. */
+    public static final String KEY_SHOW = "persist.ashfall.batt.show";
+
+    public static final String KEY_PLACEMENT = "persist.ashfall.batt.place";
+    public static final String KEY_DETAIL = "persist.ashfall.batt.detail";
+    public static final String KEY_FORMAT = "persist.ashfall.batt.fmt";
+    public static final String KEY_WINDOW = "persist.ashfall.batt.window";
+    public static final String KEY_INTERVAL = "persist.ashfall.batt.interval";
+    public static final String KEY_CHARGING_SYMBOL = "persist.ashfall.batt.chg_symbol";
+    public static final String KEY_CHARGING_CYCLE = "persist.ashfall.batt.chg_cycle";
+    public static final String KEY_CHARGING_CYCLE_MS = "persist.ashfall.batt.chg_cycle_ms";
+    public static final String KEY_CHARGING_METERS = "persist.ashfall.batt.chg_meters";
+    public static final String KEY_TAP_CYCLE = "persist.ashfall.batt.tap";
+    public static final String KEY_FONT_SIZE_SP = "persist.ashfall.batt.size_sp";
+    public static final String KEY_CAPACITY_MAH = "persist.ashfall.batt.capacity_mah";
+
+    /**
+     * Defaults shown when a property is unset or invalid. SystemUI is the owner of these values
+     * (docs/playtime.md); this page only mirrors them for display.
+     */
+    public static final boolean DEFAULT_SHOW = false;
+
+    public static final String DEFAULT_PLACEMENT = "BATTERY_LEFT";
+    public static final String DEFAULT_DETAIL = "TIME";
+    public static final String DEFAULT_FORMAT = "COMPACT";
+    public static final String DEFAULT_WINDOW = "5";
+    public static final int DEFAULT_INTERVAL = 5;
+    public static final String DEFAULT_CHARGING_SYMBOL = "BOLT";
+    public static final boolean DEFAULT_CHARGING_CYCLE = false;
+    public static final int DEFAULT_CHARGING_CYCLE_MS = 1000;
+    public static final String DEFAULT_CHARGING_METERS = "TIME,PERCENT";
+    public static final boolean DEFAULT_TAP_CYCLE = false;
+    public static final int DEFAULT_FONT_SIZE_SP = 12;
+    public static final int DEFAULT_CAPACITY_MAH = 0;
+
+    /** Ranges the rows enforce; a value outside them is treated as unset. */
+    public static final int MIN_INTERVAL = 2;
+
+    public static final int MAX_INTERVAL = 30;
+    public static final int MIN_CHARGING_CYCLE_MS = 500;
+    public static final int MAX_CHARGING_CYCLE_MS = 5000;
+    public static final int STEP_CHARGING_CYCLE_MS = 100;
+    public static final int MIN_FONT_SIZE_SP = 10;
+    public static final int MAX_FONT_SIZE_SP = 16;
+    public static final int MIN_CAPACITY_MAH = 0;
+    public static final int MAX_CAPACITY_MAH = 20000;
+
+    /** The meter list must keep 2 or 3 entries (issue #137). */
+    public static final int MIN_CHARGING_METERS = 2;
+
+    public static final int MAX_CHARGING_METERS = 3;
+
+    /** Telemetry bounds; the same ones SystemUI applies before it shows a number. */
+    private static final int MIN_CURRENT_MA = 1;
+
+    private static final int MAX_CURRENT_MA = 10000;
+    private static final int MIN_VOLTAGE_MV = 2500;
+    private static final int MAX_VOLTAGE_MV = 5500;
+    private static final int MAX_CHARGE_MAH = 100000;
+    private static final int MAX_LEVEL = 100;
+
+    private static int sCapacityMah = -1;
+    private static boolean sCapacityRead;
+
+    private static final long MINUTES_PER_HOUR = 60;
+    private static final long MINUTES_PER_DAY = 24 * MINUTES_PER_HOUR;
+    private static final long MAX_DISPLAYED_MINUTES = 2 * MINUTES_PER_DAY;
+
+    private PlayTimeProperties() {
+    }
+
+    /** Reads an integer inside {@code [min, max]}, or the default when unset or invalid. */
+    public static int getInt(String key, int defaultValue, int min, int max) {
+        final String value = SystemProperties.get(key, "");
+        if (TextUtils.isEmpty(value)) {
+            return defaultValue;
+        }
+        final int parsed;
+        try {
+            parsed = Integer.parseInt(value);
+        } catch (NumberFormatException e) {
+            return defaultValue;
+        }
+        return parsed < min || parsed > max ? defaultValue : parsed;
+    }
+
+    /** Reads a {@code 0}/{@code 1} property, or the default when it is anything else. */
+    public static boolean getBoolean(String key, boolean defaultValue) {
+        final String value = SystemProperties.get(key, "");
+        if ("1".equals(value)) {
+            return true;
+        }
+        if ("0".equals(value)) {
+            return false;
+        }
+        return defaultValue;
+    }
+
+    /** Returns {@code value} when it is one of {@code allowed}, otherwise {@code defaultValue}. */
+    public static String getChoice(String key, CharSequence[] allowed, String defaultValue) {
+        final String value = SystemProperties.get(key, "");
+        for (CharSequence candidate : allowed) {
+            if (candidate.toString().equals(value)) {
+                return value;
+            }
+        }
+        return defaultValue;
+    }
+
+    /**
+     * Reads a comma-separated list of {@code allowed} values, in {@code allowed} order. A list
+     * outside {@link #MIN_CHARGING_METERS}..{@link #MAX_CHARGING_METERS} falls back to {@code
+     * defaultCsv}.
+     */
+    public static List<String> getList(String key, CharSequence[] allowed, String defaultCsv) {
+        List<String> values = filterList(SystemProperties.get(key, ""), allowed);
+        if (values.size() < MIN_CHARGING_METERS || values.size() > MAX_CHARGING_METERS) {
+            values = filterList(defaultCsv, allowed);
+        }
+        return values;
+    }
+
+    /** Joins the selected values in {@code allowed} order, the form SystemUI parses. */
+    public static String toPropertyValue(Iterable<String> selected, CharSequence[] allowed) {
+        final List<String> ordered = new ArrayList<>();
+        for (CharSequence candidate : allowed) {
+            final String value = candidate.toString();
+            for (String item : selected) {
+                if (value.equals(item)) {
+                    ordered.add(value);
+                    break;
+                }
+            }
+        }
+        return TextUtils.join(",", ordered);
+    }
+
+    /** Writes a property; a rejected write is logged, never thrown at the page. */
+    public static void set(String key, String value) {
+        try {
+            SystemProperties.set(key, value);
+        } catch (RuntimeException e) {
+            Log.w(TAG, "Failed to set " + key + " to " + value, e);
+        }
+    }
+
+    public static void setInt(String key, int value) {
+        set(key, Integer.toString(value));
+    }
+
+    public static void setBoolean(String key, boolean value) {
+        set(key, value ? "1" : "0");
+    }
+
+    /** One-line summary for the Settings &gt; Battery row, e.g. {@code 2h 45m · 5.4W}. */
+    public static CharSequence buildSummary(Context context) {
+        if (!getBoolean(KEY_SHOW, DEFAULT_SHOW)) {
+            return context.getString(R.string.playtime_summary_off);
+        }
+        final Telemetry telemetry = readTelemetry(context);
+        final String time = formatRemainingTime(context, telemetry);
+        final String watts = formatWatts(telemetry.currentMa, telemetry.voltageMv);
+        final String value =
+                watts == null
+                        ? time
+                        : context.getString(
+                                R.string.playtime_summary,
+                                time,
+                                context.getString(R.string.playtime_watts, watts));
+        return telemetry.charging
+                ? context.getString(
+                        R.string.playtime_charging_summary, chargingSymbol(context), value)
+                : value;
+    }
+
+    /**
+     * Live read-out for the non-selectable row: {@code 4.8 W · 3.85 V · 5120 mAh · 72 %}. Fields
+     * the framework does not report are shown as {@code -}.
+     */
+    public static CharSequence buildReadout(Context context) {
+        final String unavailable = context.getString(R.string.playtime_unavailable);
+        final Telemetry telemetry = readTelemetry(context);
+        final String watts = formatWatts(telemetry.currentMa, telemetry.voltageMv);
+        return context.getString(
+                R.string.playtime_readout_format,
+                watts == null
+                        ? unavailable
+                        : context.getString(R.string.playtime_readout_watts, watts),
+                telemetry.voltageMv < 0
+                        ? unavailable
+                        : context.getString(
+                                R.string.playtime_readout_volts,
+                                formatVolts(telemetry.voltageMv)),
+                telemetry.capacityMah < 0
+                        ? unavailable
+                        : context.getString(
+                                R.string.playtime_readout_charge, telemetry.capacityMah),
+                telemetry.level < 0
+                        ? unavailable
+                        : context.getString(R.string.playtime_readout_level, telemetry.level));
+    }
+
+    /** One framework battery sample; every field is {@code -1}/false when it is unavailable. */
+    private static final class Telemetry {
+        int currentMa = -1;
+        int voltageMv = -1;
+        int level = -1;
+        int chargeMah = -1;
+        int capacityMah = -1;
+        boolean charging;
+    }
+
+    /**
+     * Reads one sample the way SystemUI does: the sticky {@code ACTION_BATTERY_CHANGED} broadcast
+     * for voltage, level and status, {@code BATTERY_PROPERTY_CURRENT_NOW} (µA, absolute value) for
+     * the draw, {@code BATTERY_PROPERTY_CHARGE_COUNTER} (µAh) for the remaining charge and the
+     * power profile for the design capacity.
+     */
+    private static Telemetry readTelemetry(Context context) {
+        final Telemetry telemetry = new Telemetry();
+        final Intent battery =
+                context.registerReceiver(null, new IntentFilter(Intent.ACTION_BATTERY_CHANGED));
+        if (battery != null) {
+            telemetry.voltageMv =
+                    inRange(
+                            battery.getIntExtra(BatteryManager.EXTRA_VOLTAGE, -1),
+                            MIN_VOLTAGE_MV,
+                            MAX_VOLTAGE_MV);
+            final int rawLevel = battery.getIntExtra(BatteryManager.EXTRA_LEVEL, -1);
+            final int scale = battery.getIntExtra(BatteryManager.EXTRA_SCALE, -1);
+            if (rawLevel >= 0 && scale > 0) {
+                telemetry.level =
+                        Math.min(
+                                MAX_LEVEL,
+                                Math.round((float) rawLevel * MAX_LEVEL / scale));
+            }
+            final int status =
+                    battery.getIntExtra(
+                            BatteryManager.EXTRA_STATUS, BatteryManager.BATTERY_STATUS_UNKNOWN);
+            telemetry.charging =
+                    status == BatteryManager.BATTERY_STATUS_CHARGING
+                            || status == BatteryManager.BATTERY_STATUS_FULL;
+        }
+        final BatteryManager batteryManager =
+                context.getSystemService(BatteryManager.class);
+        if (batteryManager != null) {
+            telemetry.currentMa = readCurrentMa(batteryManager);
+            telemetry.chargeMah = readChargeMah(batteryManager);
+        }
+        telemetry.capacityMah = readCapacityMah(context);
+        return telemetry;
+    }
+
+    /** {@code CURRENT_NOW} is µA and signed; the indicator shows the magnitude in mA. */
+    private static int readCurrentMa(BatteryManager batteryManager) {
+        final int microAmps =
+                batteryManager.getIntProperty(BatteryManager.BATTERY_PROPERTY_CURRENT_NOW);
+        if (microAmps == Integer.MIN_VALUE) {
+            return -1;
+        }
+        return inRange(Math.abs(microAmps) / 1000, MIN_CURRENT_MA, MAX_CURRENT_MA);
+    }
+
+    /** {@code CHARGE_COUNTER} is µAh; negative means the fuel gauge has no counter. */
+    private static int readChargeMah(BatteryManager batteryManager) {
+        final int microAmpHours =
+                batteryManager.getIntProperty(BatteryManager.BATTERY_PROPERTY_CHARGE_COUNTER);
+        if (microAmpHours < 0) {
+            return -1;
+        }
+        return inRange(microAmpHours / 1000, 0, MAX_CHARGE_MAH);
+    }
+
+    /**
+     * Design capacity from the power profile, mAh; {@code -1} when it is not declared. The profile
+     * is a static resource, so it is parsed once per process instead of on every refresh.
+     */
+    private static int readCapacityMah(Context context) {
+        if (!sCapacityRead) {
+            sCapacityRead = true;
+            final double capacityMah = new PowerProfile(context).getBatteryCapacity();
+            sCapacityMah =
+                    capacityMah <= 0 || capacityMah > MAX_CHARGE_MAH
+                            ? -1
+                            : (int) Math.round(capacityMah);
+        }
+        return sCapacityMah;
+    }
+
+    private static int inRange(int value, int min, int max) {
+        return value < min || value > max ? -1 : value;
+    }
+
+    private static String formatRemainingTime(Context context, Telemetry telemetry) {
+        if (telemetry.currentMa <= 0) {
+            return context.getString(R.string.playtime_unavailable);
+        }
+        final long minutes;
+        if (telemetry.charging) {
+            if (telemetry.chargeMah < 0 || telemetry.capacityMah <= 0) {
+                return context.getString(R.string.playtime_unavailable);
+            }
+            if (telemetry.chargeMah >= telemetry.capacityMah) {
+                return context.getString(R.string.playtime_full);
+            }
+            minutes =
+                    (long) (telemetry.capacityMah - telemetry.chargeMah)
+                            * MINUTES_PER_HOUR
+                            / telemetry.currentMa;
+        } else {
+            if (telemetry.chargeMah <= 0) {
+                return context.getString(R.string.playtime_unavailable);
+            }
+            minutes =
+                    (long) telemetry.chargeMah * MINUTES_PER_HOUR / telemetry.currentMa;
+        }
+        return formatMinutes(context, minutes);
+    }
+
+    /** Compact time format, capped like the estimator: past 48h a clock is meaningless. */
+    private static String formatMinutes(Context context, long minutes) {
+        if (minutes <= 0) {
+            return context.getString(R.string.playtime_unavailable);
+        }
+        if (minutes >= MAX_DISPLAYED_MINUTES) {
+            return context.getString(R.string.playtime_time_over);
+        }
+        final long hours = minutes / MINUTES_PER_HOUR;
+        final long rest = minutes % MINUTES_PER_HOUR;
+        if (hours == 0) {
+            return context.getString(R.string.playtime_time_short, rest);
+        }
+        return context.getString(R.string.playtime_time, hours, rest);
+    }
+
+    /** Formats {@code current_ma * voltage_mv} as watts, or {@code null} when unknown. */
+    private static String formatWatts(int currentMa, int voltageMv) {
+        if (currentMa <= 0 || voltageMv <= 0) {
+            return null;
+        }
+        final double watts = (double) currentMa * voltageMv / 1_000_000d;
+        return String.format(Locale.getDefault(), "%.1f", watts);
+    }
+
+    private static String formatVolts(int voltageMv) {
+        return String.format(Locale.getDefault(), "%.2f", voltageMv / 1000d);
+    }
+
+    private static String chargingSymbol(Context context) {
+        final String symbol =
+                getChoice(
+                        KEY_CHARGING_SYMBOL,
+                        new CharSequence[] {"BOLT", "PLUS", "TEXT", "EMOJI"},
+                        DEFAULT_CHARGING_SYMBOL);
+        switch (symbol) {
+            case "PLUS":
+                return context.getString(R.string.playtime_symbol_plus);
+            case "TEXT":
+                return context.getString(R.string.playtime_symbol_text);
+            case "EMOJI":
+                return context.getString(R.string.playtime_symbol_emoji);
+            case "BOLT":
+            default:
+                return context.getString(R.string.playtime_symbol_bolt);
+        }
+    }
+
+    private static List<String> filterList(String csv, CharSequence[] allowed) {
+        final List<String> values = new ArrayList<>();
+        for (String part : csv.split(",")) {
+            final String value = part.trim();
+            for (CharSequence candidate : allowed) {
+                final String candidateValue = candidate.toString();
+                if (candidateValue.equals(value) && !values.contains(candidateValue)) {
+                    values.add(candidateValue);
+                    break;
+                }
+            }
+        }
+        return values;
+    }
+}
