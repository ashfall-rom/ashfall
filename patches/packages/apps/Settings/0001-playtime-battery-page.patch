+            android:title="@string/playtime_detail_title" />
+
+        <ListPreference
+            android:entries="@array/playtime_format_entries"
+            android:entryValues="@array/playtime_format_values"
+            android:key="playtime_format"
+            android:persistent="false"
+            android:summary="%s"
+            android:title="@string/playtime_format_title" />
+
+        <com.android.settings.widget.SeekBarPreference
+            android:key="playtime_font_size"
+            android:max="16"
+            android:min="10"
+            android:persistent="false"
+            android:title="@string/playtime_font_size_title" />
+
+        <SwitchPreferenceCompat
+            android:key="playtime_tap_cycle"
+            android:persistent="false"
+            android:summary="@string/playtime_tap_cycle_summary"
+            android:title="@string/playtime_tap_cycle_title" />
+    </PreferenceCategory>
