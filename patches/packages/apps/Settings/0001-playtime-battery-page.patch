+package com.android.settings.fuelgauge.playtime;
+
+import android.content.Context;
+import android.os.Handler;
+import android.os.Looper;
+
+import androidx.preference.Preference;
+import androidx.preference.PreferenceScreen;
+
+import com.android.settings.core.BasePreferenceController;
+import com.android.settingslib.core.lifecycle.LifecycleObserver;
+import com.android.settingslib.core.lifecycle.events.OnStart;
+import com.android.settingslib.core.lifecycle.events.OnStop;
+
+/**
+ * Summary of the PlayTime indicator row on Settings &gt; Battery: the live estimate from the
+ * framework {@link android.os.BatteryManager}, or "Off". The row itself opens {@link
+ * PlayTimeSettings}.
+ *
+ * <p>The estimate is refreshed on the ashfall-hwd tick while the page is started so the summary
+ * keeps ticking next to the status bar, and the timer is removed as soon as it is not.
+ */
+public class PlayTimeSummaryController extends BasePreferenceController
+        implements LifecycleObserver, OnStart, OnStop {
+
+    /** The estimate moves with the battery state; 2 s is the SystemUI sample interval. */
+    private static final int REFRESH_MS = 2000;
+
+    private final Handler mHandler = new Handler(Looper.getMainLooper());
+
+    private final Runnable mUpdater =
+            new Runnable() {
+                @Override
+                public void run() {
+                    updateSummary();
+                    mHandler.postDelayed(this, REFRESH_MS);
+                }
+            };
+
+    private Preference mPreference;
+
+    public PlayTimeSummaryController(Context context, String preferenceKey) {
+        super(context, preferenceKey);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return AVAILABLE;
+    }
+
+    @Override
+    public void displayPreference(PreferenceScreen screen) {
+        super.displayPreference(screen);
+        mPreference = screen.findPreference(getPreferenceKey());
+    }
+
+    @Override
+    public void updateState(Preference preference) {
+        super.updateState(preference);
+        mPreference = preference;
+        updateSummary();
+    }
+
+    @Override
+    public void onStart() {
+        mHandler.post(mUpdater);
+    }
+
+    @Override
+    public void onStop() {
+        mHandler.removeCallbacks(mUpdater);
+    }
+
+    private void updateSummary() {
+        if (mPreference != null) {
+            mPreference.setSummary(PlayTimeProperties.buildSummary(mContext));
+        }
+    }
+}
