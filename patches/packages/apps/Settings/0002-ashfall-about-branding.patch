+package com.android.settings.deviceinfo.firmwareversion;
+
+import android.content.Context;
+import android.os.SystemProperties;
+
+import com.android.settings.R;
+import com.android.settings.core.BasePreferenceController;
+
+/**
+ * About phone -> "AshFall version".
+ *
+ * <p>Shows the ROM version and build id that {@code scripts/build.sh} exports
+ * into the product properties. The LineageOS base version keeps its own row,
+ * so the upstream attribution is not lost.
+ */
+public class AshFallVersionPreferenceController extends BasePreferenceController {
+
+    private static final String ASHFALL_VERSION_PROP = "ro.ashfall.version";
+    private static final String ASHFALL_BUILD_PROP = "ro.ashfall.build.id";
+
+    public AshFallVersionPreferenceController(Context context, String key) {
+        super(context, key);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return AVAILABLE;
+    }
+
+    @Override
+    public boolean useDynamicSliceSummary() {
+        return true;
+    }
+
+    @Override
+    public CharSequence getSummary() {
+        final String version = SystemProperties.get(ASHFALL_VERSION_PROP,
+                mContext.getString(R.string.unknown));
+        final String build = SystemProperties.get(ASHFALL_BUILD_PROP, "");
+        return build.isEmpty() ? version : version + " (" + build + ")";
+    }
+}
