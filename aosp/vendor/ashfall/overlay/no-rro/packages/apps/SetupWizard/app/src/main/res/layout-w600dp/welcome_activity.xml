<?xml version="1.0" encoding="utf-8"?>
<!-- AshFall welcome screen. Same ids and Start/accessibility controls as the
     LineageOS layout, with the mark, wordmark and device subtitle instead of
     the LineageOS Lottie. -->
<com.google.android.setupdesign.GlifLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/setup_wizard_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.1" />

        <ImageView
            android:id="@+id/brand_logo"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center_horizontal"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:src="@drawable/logo" />

        <TextView
            android:id="@+id/ashfall_wordmark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="@string/ashfall_setup_wordmark"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textSize="40sp"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.35" />

        <LinearLayout
            style="@style/SudContentFrame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/welcome_content_container_padding_start"
            android:paddingEnd="@dimen/welcome_content_container_padding_end"
            android:paddingBottom="0dp">

            <TextView
                android:id="@+id/welcome_title"
                style="@style/WelcomeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:hyphenationFrequency="none"
                android:textAlignment="center" />

            <TextView
                android:id="@+id/ashfall_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_horizontal"
                android:text="@string/ashfall_setup_subtitle"
                android:textAlignment="center"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:alpha="0.72"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="?attr/sudMarginStart"
            android:paddingTop="?attr/sucFooterBarPaddingTop"
            android:paddingEnd="?attr/sudMarginEnd"
            android:paddingBottom="?attr/sucFooterBarPaddingBottom">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/launch_accessibility"
                style="@style/WelcomeIconButton"
                android:layout_width="@dimen/welcome_footer_button_size"
                android:layout_height="@dimen/welcome_footer_button_size"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="@dimen/welcome_footer_button_spacing"
                android:contentDescription="@string/accessibility_settings"
                app:icon="@drawable/ic_accessibility"
                app:iconSize="@dimen/welcome_accessibility_icon_size"
                app:iconTint="?attr/colorOnSurface" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="@dimen/welcome_start_button_inset_weight" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/start"
                style="?attr/materialButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="@dimen/welcome_footer_button_size"
                android:text="@string/start"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                app:icon="@drawable/ic_arrow_forward"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/welcome_start_button_icon_padding"
                app:iconSize="@dimen/welcome_start_button_icon_size" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.setupdesign.GlifLayout>
