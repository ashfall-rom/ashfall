<!--
     Desktop mode (#131) for the RP5 internal display.

     An Android 17 build supports per-display desktop windowing on an internal
     panel; the gate is configuration, not hardware. Only the four bools below
     are overridden here - every other frameworks/base resource keeps its AOSP
     value. See docs/desktop-mode.md for the entry/exit contract and
     docs/ui.md for the taskbar/density reasoning.

     This file is statically merged through
     PRODUCT_PACKAGE_OVERLAYS += vendor/ashfall/overlay/no-rro
     (vendor/ashfall/ui.mk), so it must stay under `no-rro/`: Lineage sets
     PRODUCT_ENFORCE_RRO_TARGETS := *, and without the exclusion the overlay
     would become a runtime RRO APK instead of patching frameworks-res.
-->
<resources>
    <!-- Whether desktop mode is supported on the current device. AOSP: false. -->
    <bool name="config_isDesktopModeSupported">true</bool>

    <!-- Whether the internal display can host desktop sessions. AOSP: false.
         The panel is 1920x1080 at 360 dpi = 853x480 dp, well above the 600 dp
         width desktop mode asks for. -->
    <bool name="config_canInternalDisplayHostDesktops">true</bool>

    <!-- Whether the developer option for desktop mode is offered. AOSP: false.
         Kept on so Settings > System > Developer options can toggle desktop
         mode before the AshFall Parts switch lands (#131 F2). -->
    <bool name="config_isDesktopModeDevOptionSupported">true</bool>

    <!-- Whether a display enters desktop mode by default when its root
         TaskDisplayArea is set to WINDOWING_MODE_FREEFORM. Deliberately false,
         same as AOSP: a normal boot of a handheld stays fullscreen, and desktop
         mode is only ever entered by an explicit action (#131 F2 / QS tile /
         L1+R1+Start chord). Turning this on would make the whole product boot
         into desktop mode as soon as the display is freeform. -->
    <bool name="config_enterDesktopByDefaultOnFreeformDisplay">false</bool>
</resources>
