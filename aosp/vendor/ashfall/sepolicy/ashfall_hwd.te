# AshFall RP5 hardware daemon: fan + stick lighting (docs/phase5.md §2).
#
# System-domain daemon (it runs from /system/bin and is a coredomain, so it may
# not touch generic sysfs: private/coredomain.te neverallows sysfs:file for
# coredomains).  The fan and LED attributes are therefore labelled with
# dedicated types in genfs_contexts.

type ashfall_hwd, domain;
type ashfall_hwd_exec, system_file_type, exec_type, file_type;

# Dedicated sysfs types for the fan and LED attributes (genfs_contexts).
type ashfall_fan_sysfs, fs_type, sysfs_type;
type ashfall_led_sysfs, fs_type, sysfs_type;

# GPU devfreq cap (phase 6, docs/phase6.md section 3).  The stock vendor policy
# labels /sys/devices/.../kgsl-3d0/** vendor_sysfs_kgsl (a vendor type that the
# system_ext policy build cannot reference).  Three *resolved* attributes are
# relabelled with this type via exact-path file_contexts entries - and
# genfs_contexts as a fallback - so a coredomain may use them without any
# generic sysfs access (ashfall-hwd must not follow the /sys/class/kgsl
# symlinks, which stay vendor-labelled; issue #115):
#   .../kgsl/kgsl-3d0/gpu_available_frequencies   (read: DT step table)
#   .../devfreq/3d00000.qcom,kgsl-3d0/max_freq    (read/write: the cap)
#   .../devfreq/3d00000.qcom,kgsl-3d0/min_freq    (write: devfreq floor rescue)
# Directory traversal is covered by the stock vendor rule
# `allow { domain - isolated_app_all } vendor_sysfs_kgsl:dir search`.
type ashfall_gpu_sysfs, fs_type, sysfs_type;

typeattribute ashfall_hwd coredomain;

init_daemon_domain(ashfall_hwd)

# Thermal zones: /sys/class/thermal and /sys/devices/virtual/thermal are
# labelled sysfs_thermal by the stock vendor policy.  Reading covers the fan
# sensor; writing is only the trip_point_*_temp attributes used by the
# performance override (#82).  Critical trips are never touched by the daemon.
allow ashfall_hwd sysfs_thermal:dir r_dir_perms;
allow ashfall_hwd sysfs_thermal:lnk_file read;
allow ashfall_hwd sysfs_thermal:file rw_file_perms;

# Fan: /sys/class/gpio5_pwm2/{state,duty,speed} (genfs_contexts entry for the
# gpio5-pwm platform device).
allow ashfall_hwd ashfall_fan_sysfs:dir r_dir_perms;
allow ashfall_hwd ashfall_fan_sysfs:lnk_file read;
allow ashfall_hwd ashfall_fan_sysfs:file rw_file_perms;

# Stick LEDs: /sys/class/sn3112{l,r}/led/{enable,brightness}.
allow ashfall_hwd ashfall_led_sysfs:dir r_dir_perms;
allow ashfall_hwd ashfall_led_sysfs:lnk_file read;
allow ashfall_hwd ashfall_led_sysfs:file rw_file_perms;

# GPU devfreq cap (phase 6): the three kgsl attributes relabelled with
# ashfall_gpu_sysfs.  max_freq is 0660 root:root, the other two are read-only;
# the daemon runs as root and is the only writer of the cap.
allow ashfall_hwd ashfall_gpu_sysfs:file rw_file_perms;
allow ashfall_hwd ashfall_gpu_sysfs:lnk_file read;

# CPU frequency caps/governor (phase 6, #124).  /sys/devices/system/cpu is
# sysfs_devices_system_cpu in the platform policy and a coredomain may not
# write it, so the cpufreq tree gets a dedicated type exactly like the GPU
# relabel (#115).  The kona policy directories are symlinks into
# /sys/devices/system/cpu/cpuN/cpufreq, which genfs_contexts labels recursively;
# file_contexts carries the same paths so the exact-path pattern stays visible:
#   .../cpufreq/policy{0,4,7}/scaling_{available_frequencies,available_governors,
#                                            cur_freq,max_freq,governor}
type ashfall_cpu_sysfs, fs_type, sysfs_type;

# The parent /sys/devices/system/cpu keeps the platform type; traversal needs
# search on it (the neverallow for coredomains covers sysfs *files*, not dirs).
allow ashfall_hwd sysfs_devices_system_cpu:dir search;
allow ashfall_hwd ashfall_cpu_sysfs:dir r_dir_perms;
allow ashfall_hwd ashfall_cpu_sysfs:lnk_file read;
allow ashfall_hwd ashfall_cpu_sysfs:file rw_file_perms;

# Battery telemetry (phase 6, #124/#137).  /sys/class/power_supply is already
# labelled sysfs_batteryinfo by the platform policy (a public type), so the
# Class dir, its symlinks and the resolved attributes only need a read grant.
# No ashfall_power_sysfs relabel is necessary; docs/rp5/hw.md §11 carries the
# enforcing check (a denial naming another label means the vendor policy moved
# the attributes and exact-path relabels must be added then).
allow ashfall_hwd sysfs_batteryinfo:dir r_dir_perms;
allow ashfall_hwd sysfs_batteryinfo:lnk_file read;
allow ashfall_hwd sysfs_batteryinfo:file r_file_perms;

# zram (phase 6, #141): /dev/block/zram0 and /sys/block/zram0/* (resolved
# /sys/devices/virtual/block/zram0).  swapon/swapoff open the block device.
type ashfall_zram_device, dev_type;
type ashfall_zram_sysfs, fs_type, sysfs_type;

allow ashfall_hwd block_device:dir search;
allow ashfall_hwd ashfall_zram_device:blk_file rw_file_perms;
allow ashfall_hwd ashfall_zram_sysfs:dir r_dir_perms;
allow ashfall_hwd ashfall_zram_sysfs:file rw_file_perms;

# Swap file (phase 6, #141): /data/ashfall/swapfile, created by init at
# post-fs-data so it gets this label (a runtime-created directory would inherit
# the /data label).  One type covers the directory and the file: the daemon
# creates/unlinks the file inside it at runtime and the inherited label is the
# same type, so no restorecon is needed at enable time.  swapon/swapoff need
# CAP_SYS_ADMIN; MemTotal/SwapTotal come from /proc/meminfo (proc_meminfo is
# readable by every domain in the platform policy).
type ashfall_swap_file, file_type;

allow ashfall_hwd ashfall_swap_file:dir { create rw_dir_perms };
allow ashfall_hwd ashfall_swap_file:file { create rw_file_perms };
allow ashfall_hwd self:capability sys_admin;

# persist.ashfall.fan.* / persist.ashfall.led.* come from ashfall_props.te;
# the screen state for the fan screen-off hold and the LED screen-off policy is
# the framework's debug.tracing.screen_state, which domain.te already grants to
# every domain.
# ashfall.ui.* (fan live/preview, LED override) and ashfall.perf.* (throttle
# override) are in ashfall_props.te too.
