# AshFall RP5 file labels.
#
# Loaded from /system_ext/etc/selinux/system_ext_file_contexts, which the
# build merges into file_contexts.bin for the image build and libselinux loads
# at runtime, so labelling /system/bin from here is intentional (both daemons
# ship on the GSI system image).

# Daemons
/system/bin/ashfall-hwd              u:object_r:ashfall_hwd_exec:s0
/system/bin/ashfall-rp5-input        u:object_r:ashfall_rp5_input_exec:s0

# Gamepad MCU UART (and the stock /dev/rscom name the daemon falls back to).
# /dev/ttyS[0-9]* is already serial_device in platform policy; the HS UART is
# not covered there.
/dev/ttyHS1                          u:object_r:serial_device:s0
/dev/rscom                           u:object_r:serial_device:s0

# Control socket created by init for ashfall-rp5-input
/dev/socket/ashfall_input            u:object_r:ashfall_input_socket:s0

# Calibration directory (joys = user calibration, joys.factory = init copy of
# the factory file).  Created by init at post-fs-data.
/data/misc/ashfall(/.*)?             u:object_r:ashfall_data_file:s0

# CPU frequency caps/governor (phase 6, #124).  The kona policy dirs are
# symlinks into cpuN/cpufreq; genfs_contexts labels the trees recursively and
# these exact paths document the attributes the daemon opens.  There are no
# dots in these names, so no escaping is needed (unlike the kgsl paths below).
/sys/devices/system/cpu/cpufreq/policy0/scaling_available_frequencies u:object_r:ashfall_cpu_sysfs:s0
/sys/devices/system/cpu/cpufreq/policy0/scaling_available_governors u:object_r:ashfall_cpu_sysfs:s0
/sys/devices/system/cpu/cpufreq/policy0/scaling_cur_freq u:object_r:ashfall_cpu_sysfs:s0
/sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq u:object_r:ashfall_cpu_sysfs:s0
/sys/devices/system/cpu/cpufreq/policy0/scaling_governor u:object_r:ashfall_cpu_sysfs:s0
/sys/devices/system/cpu/cpufreq/policy4/scaling_available_frequencies u:object_r:ashfall_cpu_sysfs:s0
/sys/devices/system/cpu/cpufreq/policy4/scaling_available_governors u:object_r:ashfall_cpu_sysfs:s0
/sys/devices/system/cpu/cpufreq/policy4/scaling_cur_freq u:object_r:ashfall_cpu_sysfs:s0
/sys/devices/system/cpu/cpufreq/policy4/scaling_max_freq u:object_r:ashfall_cpu_sysfs:s0
/sys/devices/system/cpu/cpufreq/policy4/scaling_governor u:object_r:ashfall_cpu_sysfs:s0
/sys/devices/system/cpu/cpufreq/policy7/scaling_available_frequencies u:object_r:ashfall_cpu_sysfs:s0
/sys/devices/system/cpu/cpufreq/policy7/scaling_available_governors u:object_r:ashfall_cpu_sysfs:s0
/sys/devices/system/cpu/cpufreq/policy7/scaling_cur_freq u:object_r:ashfall_cpu_sysfs:s0
/sys/devices/system/cpu/cpufreq/policy7/scaling_max_freq u:object_r:ashfall_cpu_sysfs:s0
/sys/devices/system/cpu/cpufreq/policy7/scaling_governor u:object_r:ashfall_cpu_sysfs:s0

# Swap file (phase 6, #141): /data/ashfall is created by init at post-fs-data
# (ashfall-hwd.rc) so the directory and the file share the same type; a
# runtime-created swapfile inherits it from the directory.
/data/ashfall(/.*)?                  u:object_r:ashfall_swap_file:s0

# GPU devfreq cap (phase 6).  The stock vendor_file_contexts labels the whole
# kgsl tree vendor_sysfs_kgsl with regexes, and system_ext_file_contexts is
# loaded *before* vendor_file_contexts.  These entries therefore escape every
# dot: libselinux's sort_specs() moves specifications without meta characters
# ("exact pathnames") behind all regex specifications, so they are matched
# first no matter which partition the competing regex came from.  Only the
# attributes ashfall-hwd uses are relabelled (the read-only live clock gpuclk
# and the read-only gpu_busy_percentage, both for the Power page telemetry);
# gpu_model, gpubusy, max_gpuclk and every other kgsl attribute keep the vendor
# label.  min_freq and max_freq keep their existing labels: the #120
# vendor-perf-HAL question is not changed here.
# Paths verified on the RP5 (build 20261114-led109-bf3c952):
#   readlink -f /sys/class/kgsl/kgsl-3d0/devfreq/max_freq
/sys/devices/platform/soc/3d00000\.qcom,kgsl-3d0/kgsl/kgsl-3d0/gpu_available_frequencies u:object_r:ashfall_gpu_sysfs:s0
/sys/devices/platform/soc/3d00000\.qcom,kgsl-3d0/kgsl/kgsl-3d0/gpuclk u:object_r:ashfall_gpu_sysfs:s0
/sys/devices/platform/soc/3d00000\.qcom,kgsl-3d0/kgsl/kgsl-3d0/gpu_busy_percentage u:object_r:ashfall_gpu_sysfs:s0
/sys/devices/platform/soc/3d00000\.qcom,kgsl-3d0/devfreq/3d00000\.qcom,kgsl-3d0/max_freq u:object_r:ashfall_gpu_sysfs:s0
/sys/devices/platform/soc/3d00000\.qcom,kgsl-3d0/devfreq/3d00000\.qcom,kgsl-3d0/min_freq u:object_r:ashfall_gpu_sysfs:s0
# Older kona DT layouts expose the same nodes without the /platform level.
/sys/devices/soc/3d00000\.qcom,kgsl-3d0/kgsl/kgsl-3d0/gpu_available_frequencies u:object_r:ashfall_gpu_sysfs:s0
/sys/devices/soc/3d00000\.qcom,kgsl-3d0/kgsl/kgsl-3d0/gpuclk u:object_r:ashfall_gpu_sysfs:s0
/sys/devices/soc/3d00000\.qcom,kgsl-3d0/kgsl/kgsl-3d0/gpu_busy_percentage u:object_r:ashfall_gpu_sysfs:s0
/sys/devices/soc/3d00000\.qcom,kgsl-3d0/devfreq/3d00000\.qcom,kgsl-3d0/max_freq u:object_r:ashfall_gpu_sysfs:s0
/sys/devices/soc/3d00000\.qcom,kgsl-3d0/devfreq/3d00000\.qcom,kgsl-3d0/min_freq u:object_r:ashfall_gpu_sysfs:s0
