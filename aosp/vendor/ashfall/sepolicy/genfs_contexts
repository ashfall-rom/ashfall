# AshFall RP5 sysfs types (docs/phase5.md §2.1/§2.2, docs/rp5/hw.md).
#
# The fan and LED drivers create plain sysfs class devices, so their attributes
# are labelled `sysfs` (generic) by default.  A coredomain daemon may not touch
# generic sysfs at all (private/coredomain.te:
# neverallow { coredomain ... } sysfs:file no_rw_file_perms, which covers open,
# read and write), so both trees get a dedicated type here.
#
# All paths below were verified on the RP5 (build 20261113-213314) with
# `readlink -f` / the avc audit path; see docs/rp5/hw.md §5.

# Fan controller (gpio5_pwm.ko).  The driver registers class-level attributes,
# so the files live directly in the class directory - there is no device dir:
#   /sys/class/gpio5_pwm2/{state,duty,speed,period,thermal,en_backlight,...}
genfscon sysfs /class/gpio5_pwm2     u:object_r:ashfall_fan_sysfs:s0

# GPU devfreq cap (phase 6).  Fallback labels only: the stock vendor policy
# labels these paths vendor_sysfs_kgsl through vendor_file_contexts, and
# userspace (ueventd) applies a stored xattr, so the *file_contexts* exact-path
# entries in this directory are what actually win.  These deep genfscon paths
# are longer than the vendor `/class/kgsl` prefix and cover the case where the
# vendor file_contexts rule is absent (e.g. a future stock image).
#   readlink -f /sys/class/kgsl/kgsl-3d0/devfreq/max_freq on the RP5:
#   /sys/devices/platform/soc/3d00000.qcom,kgsl-3d0/devfreq/3d00000.qcom,kgsl-3d0/max_freq
genfscon sysfs /devices/platform/soc/3d00000.qcom,kgsl-3d0/kgsl/kgsl-3d0/gpu_available_frequencies u:object_r:ashfall_gpu_sysfs:s0
genfscon sysfs /devices/platform/soc/3d00000.qcom,kgsl-3d0/kgsl/kgsl-3d0/gpuclk u:object_r:ashfall_gpu_sysfs:s0
genfscon sysfs /devices/platform/soc/3d00000.qcom,kgsl-3d0/devfreq/3d00000.qcom,kgsl-3d0/max_freq u:object_r:ashfall_gpu_sysfs:s0
genfscon sysfs /devices/platform/soc/3d00000.qcom,kgsl-3d0/devfreq/3d00000.qcom,kgsl-3d0/min_freq u:object_r:ashfall_gpu_sysfs:s0
genfscon sysfs /devices/soc/3d00000.qcom,kgsl-3d0/kgsl/kgsl-3d0/gpu_available_frequencies u:object_r:ashfall_gpu_sysfs:s0
genfscon sysfs /devices/soc/3d00000.qcom,kgsl-3d0/kgsl/kgsl-3d0/gpuclk u:object_r:ashfall_gpu_sysfs:s0
genfscon sysfs /devices/soc/3d00000.qcom,kgsl-3d0/devfreq/3d00000.qcom,kgsl-3d0/max_freq u:object_r:ashfall_gpu_sysfs:s0
genfscon sysfs /devices/soc/3d00000.qcom,kgsl-3d0/devfreq/3d00000.qcom,kgsl-3d0/min_freq u:object_r:ashfall_gpu_sysfs:s0

# Stick LED controllers (sn3112l / sn3112r).  Each class has one device named
# "led"; `/sys/class/sn3112{l,r}/led` are symlinks to these device dirs, which
# is where enable/brightness/breath actually live:
#   readlink -f /sys/class/sn3112l/led -> /sys/devices/virtual/sn3112l/led
genfscon sysfs /devices/virtual/sn3112l  u:object_r:ashfall_led_sysfs:s0
genfscon sysfs /devices/virtual/sn3112r  u:object_r:ashfall_led_sysfs:s0

# CPU frequency caps/governor (phase 6, #124).  /sys/devices/system/cpu is
# labelled sysfs_devices_system_cpu by the platform policy; the deeper prefix
# here wins for the cpufreq trees.  The policyN directories are symlinks into
# cpuN/cpufreq, and genfscon applies recursively, so the cpuN entries label the
# attributes the daemon actually opens:
#   readlink -f /sys/devices/system/cpu/cpufreq/policy0
#   -> /sys/devices/system/cpu/cpu0/cpufreq
genfscon sysfs /devices/system/cpu/cpufreq      u:object_r:ashfall_cpu_sysfs:s0
genfscon sysfs /devices/system/cpu/cpu0/cpufreq u:object_r:ashfall_cpu_sysfs:s0
genfscon sysfs /devices/system/cpu/cpu1/cpufreq u:object_r:ashfall_cpu_sysfs:s0
genfscon sysfs /devices/system/cpu/cpu2/cpufreq u:object_r:ashfall_cpu_sysfs:s0
genfscon sysfs /devices/system/cpu/cpu3/cpufreq u:object_r:ashfall_cpu_sysfs:s0
genfscon sysfs /devices/system/cpu/cpu4/cpufreq u:object_r:ashfall_cpu_sysfs:s0
genfscon sysfs /devices/system/cpu/cpu5/cpufreq u:object_r:ashfall_cpu_sysfs:s0
genfscon sysfs /devices/system/cpu/cpu6/cpufreq u:object_r:ashfall_cpu_sysfs:s0
genfscon sysfs /devices/system/cpu/cpu7/cpufreq u:object_r:ashfall_cpu_sysfs:s0

# zram attributes (phase 6, #141): no genfscon here.  The platform policy
# already labels /sys/devices/virtual/block/zram0 (and therefore
# /sys/block/zram0) with the public sysfs_zram type.
