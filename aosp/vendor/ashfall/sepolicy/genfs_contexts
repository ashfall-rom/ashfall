# AshFall RP5 sysfs types (docs/phase5.md §2.1/§2.2, docs/rp5/hw.md).
#
# The fan and LED drivers create plain sysfs class devices, so their attributes
# are labelled `sysfs` (generic) by default.  A coredomain daemon may not touch
# generic sysfs (private/coredomain.te: neverallow sysfs:file no_rw_file_perms),
# so both trees get a dedicated type here.
#
# Paths are the *resolved* device paths (what `readlink -f /sys/class/...`
# prints), not the class symlinks.  The fan node is a child of the `soc`
# simple-bus node `pm8150l_gpio6`; the LED controllers are class devices
# created by their driver without a device-tree parent.  Both spellings are
# listed where the driver may or may not set a parent: an entry that does not
# match is harmless, and this keeps the policy working across the two plausible
# probe paths.  Verify with `ls -lZ /sys/class/gpio5_pwm2` after a flash (see
# the test checklist in docs/rp5/hw.md).

# Fan controller (gpio5_pwm.ko, class gpio5_pwm2)
genfscon sysfs /devices/platform/soc/soc:pm8150l_gpio6 u:object_r:ashfall_fan_sysfs:s0
genfscon sysfs /devices/virtual/gpio5_pwm2             u:object_r:ashfall_fan_sysfs:s0

# Stick LED controllers (class sn3112l / sn3112r, one attribute dir "led")
genfscon sysfs /devices/virtual/sn3112l                u:object_r:ashfall_led_sysfs:s0
genfscon sysfs /devices/virtual/sn3112r                u:object_r:ashfall_led_sysfs:s0
genfscon sysfs /devices/platform/sn3112l               u:object_r:ashfall_led_sysfs:s0
genfscon sysfs /devices/platform/sn3112r               u:object_r:ashfall_led_sysfs:s0
