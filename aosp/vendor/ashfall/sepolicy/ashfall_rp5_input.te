# AshFall RP5 built-in gamepad bridge + calibration/deadzone/socket extensions.
#
# The RP5 gamepad is sampled by an MCU on the 115200-baud UART at /dev/ttyHS1
# and injected through /dev/uinput.  On stock Android this is done by the stock
# system image (pservice/RsMapping), which a GSI replaces.

type ashfall_rp5_input, domain;
type ashfall_rp5_input_exec, system_file_type, exec_type, file_type;

typeattribute ashfall_rp5_input coredomain;

init_daemon_domain(ashfall_rp5_input)

# MCU UART (labelled serial_device in file_contexts) and the uinput node.
allow ashfall_rp5_input serial_device:chr_file rw_file_perms;
allow ashfall_rp5_input uhid_device:chr_file rw_file_perms;

# /dev/input (#138): fusion opens every node once to classify it, reads the
# gamepad events, grabs the external gamepads (EVIOCGRAB) and replays force
# feedback to them.  A motion-only node is only probed read-only for its
# capabilities and is never grabbed or held, so the sensor path is unaffected.
# /dev/input itself is deliberately NOT relabelled: issue #120 is the example
# of what a relabel does to the other domains that need these nodes.
allow ashfall_rp5_input input_device:dir {
    getattr
    search
    open
    read
    watch
};
allow ashfall_rp5_input input_device:chr_file {
    getattr
    open
    read
    write
    ioctl
};

# /data/misc/ashfall: joys (user calibration, written only by this daemon) and
# joys.factory (copied from /mnt/vendor/persist by init at post-fs-data).  No
# other domain may write this directory.
type ashfall_data_file, file_type, data_file_type, core_data_file_type;

allow ashfall_rp5_input ashfall_data_file:dir {
    getattr
    search
    open
    read
    write
    add_name
    remove_name
    create
};
allow ashfall_rp5_input ashfall_data_file:file {
    getattr
    open
    read
    write
    create
    rename
    unlink
    setattr
};

# Control socket /dev/socket/ashfall_input.  init creates it with this
# domain's socket context (the .rc `socket` command inherits the service
# seclabel), so `domain self:unix_stream_socket { create_stream_socket_perms }`
# from domain.te covers listen/accept.  The only client is the AshFall Parts
# app (system_app).
type ashfall_input_socket, file_type;

allow system_app ashfall_input_socket:sock_file write;
allow system_app ashfall_rp5_input:unix_stream_socket connectto;
allow system_app ashfall_rp5_input:unix_stream_socket { read write getattr };
allow ashfall_rp5_input system_app:unix_stream_socket { read write getattr };
