// Workaround for a LineageOS 24.0 tree defect, NOT an AshFall feature.
//
// build/make/target/product/gsi/Android.bp defines the AOSP-only GSI image
// module `aosp_system_image`, whose `deps` list names the AOSP `Calendar` app.
// LineageOS removed `packages/apps/Calendar` from its tree (it ships Etar
// instead), so Soong aborts the analysis of EVERY product in this tree:
//
//   error: build/make/target/product/gsi/Android.bp:190:1:
//          "aosp_system_image" depends on undefined module "Calendar".
//
// `aosp_system_image` is dead weight for us: lineage_gsi_arm64 (and therefore
// ashfall_gsi_arm64) inherits device/generic/common/gsi_arm64.mk, which selects
// `android_gsi` via PRODUCT_SOONG_DEFINED_SYSTEM_IMAGE, and
// lineage_generic_target.mk sets USE_SOONG_DEFINED_SYSTEM_IMAGE := false, so
// the make-based image path is used. This empty `phony` module only satisfies
// the analysis; nothing installs or builds it.
//
// (AccessibilityMenu and WallpaperCropper are also in that deps list but do
// exist under frameworks/base, so they need no stub.)
//
// Remove this file once the dangling dep is fixed upstream or carried as a
// proper patch in patches/build/ (issue #5).

phony {
    name: "Calendar",
    required: [],
}
