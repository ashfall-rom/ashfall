<resources>
    <!-- Memory page (issue #141, docs/phase6.md §9.3).  Every string of the
         page carries the mem_ prefix and lives in this file, so the other
         wave-2 pages can change res/values/strings.xml without conflicts.
         The page is swapfile-only since #156 §7, so no string here mentions
         compressed swap. -->

    <!-- Shared -->
    <string name="mem_dash">—</string>
    <string name="mem_off">Off</string>
    <string name="mem_size_mb">%1$d MB</string>
    <string name="mem_size_gb">%1$s GB</string>
    <string name="mem_applied_mismatch">Requested %1$d MB — %2$d MB in use.</string>

    <!-- Live status (ashfall.status.mem.*) -->
    <string name="mem_status_category">Status</string>
    <string name="mem_swap_status_title">Swap</string>
    <string name="mem_storage_status_title">Free storage</string>
    <string name="mem_swap_status_value">%1$s used of %2$s</string>
    <string name="mem_storage_status_value">%1$s free of %2$s</string>

    <!-- Swapfile.  The warning is part of the feature, not decoration: it is
         always in the row summary and repeated in a non-dismissible
         confirmation before swap is switched on. -->
    <string name="mem_swap_category">Swapfile</string>
    <string name="mem_swap_size_title">Swapfile size</string>
    <string name="mem_swap_free">%1$s free</string>
    <string name="mem_swap_warning">Swap is far slower than RAM, and heavy use wears the storage out.</string>
    <string name="mem_swap_too_large">Leaves too little free storage — it will be refused.</string>
    <string name="mem_swap_unavailable">The swapfile is not available on this build</string>
    <string name="mem_swap_confirm_title">Create a swapfile?</string>
    <string name="mem_swap_confirm_body">The swapfile (%1$s) is created on internal storage. It is far slower than RAM, the device can feel sluggish once it swaps, and heavy use wears the storage out.</string>
    <string name="mem_swap_confirm_enable">Create</string>

    <!-- Handheld row summary -->
    <string name="mem_home_summary">Swap %1$s</string>
    <string name="mem_home_unavailable">Unavailable</string>

    <string name="mem_footer">Applied immediately.</string>
</resources>
