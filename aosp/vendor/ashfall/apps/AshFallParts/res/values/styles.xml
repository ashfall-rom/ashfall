<resources>

    <!-- Base theme.  On Android 17 / LineageOS 24 this is overridden by
         res/values-v36/themes.xml, which inherits SettingsLib's
         Theme.SubSettingsBase.Expressive (the exact theme of a Settings
         sub-page).  The definition here keeps the app previewable on older
         SDK images with the stock DeviceDefault Settings look; it inherits
         AppCompat because the preview host activity is an AppCompatActivity. -->
    <style name="Theme.AshFall.Settings" parent="@style/Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:clipToPadding">false</item>
        <item name="android:clipChildren">false</item>
        <item name="colorAccent">@android:color/system_accent1_500</item>
        <item name="colorControlActivated">@android:color/system_accent1_500</item>
        <item name="colorPrimary">@android:color/system_accent1_500</item>
        <item name="android:windowBackground">?android:attr/colorBackground</item>
    </style>

    <!-- Dialogs used by the in-app colour picker and the preset editor.
         The window background is the rounded card itself, so the floating
         window draws exactly one outline/shadow; the theme sets neither an
         extra android:background nor an elevation, which used to add a second
         stray shadow behind the Quick Settings dialogs.  AppCompat DayNight
         follows the system light/dark theme (the dialog is never themed
         separately from the system). -->
    <style name="Theme.AshFall.Dialog" parent="@style/Theme.AppCompat.DayNight.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:windowDimAmount">0.5</item>
        <item name="android:colorAccent">@android:color/system_accent1_500</item>
    </style>

    <!-- Quick Settings tile dialogs.  The window type (TYPE_QS_DIALOG) is set
         by TileService.showDialog(); only the decoration is ours. -->
    <style name="Theme.AshFall.QsDialog" parent="@style/Theme.AshFall.Dialog" />

    <!-- Explicit sizes/colours rather than textAppearance: a Dialog created
         from a Service inherits a different theme chain, and framework text
         appearance styles can reference attributes (textColorLink) that the
         dialog theme does not define. -->
    <style name="AshFallDialogTitle">
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <!-- Dialog-safe text styles: these only use attributes that every
         DeviceDefault dialog theme defines (list item appearances are not
         guaranteed inside a dialog). -->
    <style name="AshFallDialogPrimary">
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="AshFallDialogSecondary">
        <item name="android:textColor">?android:attr/textColorSecondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="AshFallSection">
        <item name="android:textColor">?android:attr/textColorSecondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Custom preference rows.  They reuse the theme's list text appearances,
         colours and the standard selectable background, so focus, ripple, light
         and dark all behave like every other Settings row. -->
    <style name="AshFallPreferenceRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">?android:attr/listPreferredItemHeight</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">?android:attr/listPreferredItemPaddingStart</item>
        <item name="android:paddingEnd">?android:attr/listPreferredItemPaddingEnd</item>
        <item name="android:paddingTop">@dimen/preference_vertical_padding</item>
        <item name="android:paddingBottom">@dimen/preference_vertical_padding</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="AshFallPreferenceTitle">
        <item name="android:textAppearance">?android:attr/textAppearanceListItem</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style name="AshFallPreferenceSummary">
        <item name="android:textAppearance">?android:attr/textAppearanceListItemSecondary</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>
</resources>
