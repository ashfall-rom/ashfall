    <string name="fan_gpu_summary_clamped">Requested %1$d MHz — the throttle override clamps the GPU to stock %2$d MHz.</string>
    <string name="fan_gpu_summary_not_applied">Requested %1$d MHz — the daemon reports %2$d MHz; the OC step is not available.</string>
    <string name="fan_gpu_summary_unavailable">Requested %1$d MHz — the GPU cap is not available (ashfall-hwd is not reporting).</string>
    <string name="fan_gpu_summary_no_sysfs">Requested %1$d MHz — the GPU clock interface is unavailable on this kernel.</string>
    <string name="fan_gpu_warning_fan">Sustained clocks depend on the fan and thermal throttling; the fan is not forced.</string>
    <string name="fan_gpu_mock_note">Preview mock: this value is simulated, no daemon is involved.</string>
    <string name="fan_gpu_confirm_title">Run the GPU at 1000 MHz?</string>
    <string name="fan_gpu_confirm_body">1000 MHz is outside Qualcomm\'s stock table and marginal on some SD865 units; 940 MHz is the common stable overclock. It raises the GPU voltage and needs the fan. If the device becomes unstable or too hot, select 940 MHz. The cap is applied by ashfall-hwd and survives a reboot.</string>
    <string name="fan_gpu_confirm_enable">Use 1000 MHz</string>
