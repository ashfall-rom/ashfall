    <!-- Calibration wizard -->
    <string name="cal_step_release_title">Let go of the sticks</string>
    <string name="cal_step_release_body">Put the handheld down and do not touch the sticks or triggers.  The centre position is captured for 2 seconds.</string>
    <string name="cal_step_rotate_title">Roll both sticks around the edge</string>
    <string name="cal_step_rotate_body">Move both sticks slowly around their full circle a few times, then let them spring back to the centre.  Capturing for 8 seconds.</string>
    <string name="cal_step_trigger_title">Pull both triggers fully</string>
    <string name="cal_step_trigger_body">Squeeze L2 and R2 all the way in and release them twice.  Capturing for 4 seconds.</string>
    <string name="cal_step_review_title">Review and save</string>
    <string name="cal_step_review_body">Check that every range looks sane.  Nothing is written until you press Save.</string>
