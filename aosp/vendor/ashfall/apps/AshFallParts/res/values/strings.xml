    <!-- Placeholder/footers -->
    <string name="footer_fan">The daemon samples the hottest CPU/GPU sensor every 2 seconds (every 0.5 seconds while this page is open).  A fixed last-resort rule still runs the fan at 100 % at 90 °C.</string>
    <string name="footer_controller">Deadzones are applied by ashfall-rp5-input after calibration, so every app and emulator sees them.</string>
    <string name="footer_lighting">Effect changes are visible immediately.  Brightness 0 turns the rings off without changing the colour.</string>
