<resources>

    <!-- Android 16+ (SettingsLib expressive theme, used by LineageOS 24 /
         Android 17).  This is the real thing: the same theme family as
         Settings' own sub-pages, including the SettingsLib preference theme
         overlay, so androidx.preference rows render exactly like platform
         rows (light and dark). -->
    <style name="Theme.AshFall.Settings" parent="@style/Theme.SubSettingsBase.Expressive">
        <item name="android:clipToPadding">false</item>
        <item name="android:clipChildren">false</item>
        <item name="android:listPreferredItemHeight">72dip</item>
        <!-- Use exactly the Settings page surface instead of the device
             default window background (which resolves to black in this app and
             made the page differ from Settings).  SettingsLib's colour is
             @android:color/system_surface_container_dark (#17191F) in the dark
             theme and turns #000000 under the LineageOS black-theme RRO, so
             both modes match Settings without a runtime check. -->
        <item name="android:colorBackground">@color/settingslib_materialColorSurfaceContainer</item>
        <item name="android:windowBackground">@color/settingslib_materialColorSurfaceContainer</item>
        <!-- Platform SettingsLib dialogs, used by AlertDialog.Builder for the
             preset editor and the throttling confirmation. -->
        <item name="android:alertDialogTheme">@style/Theme.DeviceDefault.AlertDialog.SettingsLib.Expressive</item>
    </style>
</resources>
