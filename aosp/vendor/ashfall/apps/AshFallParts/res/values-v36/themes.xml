<resources>

    <!-- Android 16+ (SettingsLib expressive theme, used by LineageOS 24 /
         Android 17).  This is the real thing: the same theme family as
         Settings' own sub-pages, including the SettingsLib preference theme
         overlay, so androidx.preference rows render exactly like platform
         rows (light and dark). -->
    <style name="Theme.AshFall.Settings" parent="@style/Theme.SubSettingsBase.Expressive">
        <item name="android:clipToPadding">false</item>
        <item name="android:clipChildren">false</item>
        <item name="android:listPreferredItemHeight">72dip</item>
    </style>
</resources>
