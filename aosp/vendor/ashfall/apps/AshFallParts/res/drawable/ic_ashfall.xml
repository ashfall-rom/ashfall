        android:pathData="M25.125,10.5 C26.625,19.5 28.875,29.625 36.75,38.25 L30.5625,38.25 C25.875,29.8125 24.0,18.75 22.875,10.5 Z" />
    <path
        android:fillColor="#FFEDE9E4"
        android:pathData="M18.375,28.125 a1.7812,1.7812 0 0 1 1.7812,-1.7812 h7.6876 a1.7812,1.7812 0 0 1 1.7812,1.7812 a1.7812,1.7812 0 0 1 -1.7812,1.7812 h-7.6876 a1.7812,1.7812 0 0 1 -1.7812,-1.7812 z" />
