    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- tile -->
    <path
        android:fillColor="#FF0B0C0F"
        android:pathData="M24,0 a24,24 0 1 1 0,48 a24,24 0 1 1 0,-48 z" />

    <!-- bloom, centred just below the letterform and clipped to the tile -->
    <path android:pathData="M24,0 a24,24 0 1 1 0,48 a24,24 0 1 1 0,-48 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="24"
                android:centerY="28.125"
                android:gradientRadius="23.4">
                <item android:offset="0.0" android:color="#29FF8A3D" />
                <item android:offset="0.45" android:color="#0DFF8A3D" />
                <item android:offset="1.0" android:color="#00FF8A3D" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- the A -->
    <path
        android:fillColor="#FFEDE9E4"
        android:pathData="M22.875,10.5 C21.375,19.5 19.125,29.625 11.25,38.25 L17.4375,38.25 C22.125,29.8125 24.0,18.75 25.125,10.5 Z" />
