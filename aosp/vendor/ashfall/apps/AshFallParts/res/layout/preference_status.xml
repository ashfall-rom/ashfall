<?xml version="1.0" encoding="utf-8"?>
<!-- Live fan status: temperature, output and RPM with a gauge for the output. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="false"
    android:orientation="vertical"
    android:paddingStart="?android:attr/listPreferredItemPaddingStart"
    android:paddingTop="8dp"
    android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/status_unavailable"
        style="@style/AshFallPreferenceSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/fan_status_unavailable"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/status_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:focusable="false"
            android:orientation="vertical">

            <TextView
                style="@style/AshFallPreferenceSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:text="@string/fan_status_temperature" />

            <TextView
                android:id="@+id/status_temp"
                style="@style/AshFallPreferenceTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:focusable="false"
            android:orientation="vertical">

            <TextView
                style="@style/AshFallPreferenceSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:text="@string/fan_status_output" />

            <TextView
                android:id="@+id/status_pct"
                style="@style/AshFallPreferenceTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:focusable="false"
            android:orientation="vertical">

            <TextView
                style="@style/AshFallPreferenceSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:text="@string/fan_status_speed" />

            <TextView
                android:id="@+id/status_rpm"
                style="@style/AshFallPreferenceTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/status_gauge"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:focusable="false"
        android:max="100" />

    <TextView
        android:id="@+id/status_safety"
        style="@style/AshFallPreferenceTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:focusable="false"
        android:text="@string/fan_status_safety"
        android:textColor="@color/status_warning"
        android:visibility="gone" />
</LinearLayout>
