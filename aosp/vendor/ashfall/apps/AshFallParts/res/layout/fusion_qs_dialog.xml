<?xml version="1.0" encoding="utf-8"?>
<!-- Fusion Quick Settings dialog.  Every control applies immediately.

     Same chrome and measurement contract as the Fan/Lighting dialogs
     (docs/parts.md §3): a title + state header that never scrolls, the pad list
     (with its inline layout options) in the only ScrollView, then a divider, the
     fixed action rows and Done.  The fit routine (`FusionDialog.fitWindow`, the
     same contract as `Ui.fitDialog()`) gives the ScrollView the space the fixed
     header and footer leave over, so the switch and Done are always fully inside
     the card and only the pad list scrolls (#156 §16).  The root is match_parent
     on purpose: the window is sized from @dimen/dialog_width by
     `FusionDialog.fitWindow`, so the card and its content can never disagree
     about the width (#166). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fusion_qs_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/dialog_padding"
    android:paddingTop="20dp"
    android:paddingEnd="@dimen/dialog_padding"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_gamepad"
            android:tint="?android:attr/textColorPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/AshFallDialogTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fusion_dialog_title" />

            <TextView
                android:id="@+id/fusion_qs_state"
                style="@style/AshFallDialogSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <Switch
            android:id="@+id/fusion_qs_switch"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:contentDescription="@string/fusion_switch_title"
            android:showText="false" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/fusion_qs_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/AshFallSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fusion_pads_title" />

            <LinearLayout
                android:id="@+id/fusion_qs_pads"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="?android:attr/listDivider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/fusion_qs_rescan"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="start|center_vertical"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/fusion_rescan_title"
            android:textColor="?android:attr/colorAccent" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/fusion_qs_more"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="end|center_vertical"
            android:minWidth="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/fusion_dialog_more"
            android:textColor="?android:attr/colorAccent" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/AshFallDialogPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fusion_pointer_title" />

            <TextView
                android:id="@+id/fusion_qs_pointer_summary"
                style="@style/AshFallDialogSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fusion_pointer_summary" />
        </LinearLayout>

        <Switch
            android:id="@+id/fusion_qs_pointer_switch"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:contentDescription="@string/fusion_pointer_title"
            android:showText="false" />
    </LinearLayout>

    <Button
        android:id="@+id/fusion_qs_done"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:gravity="end|center_vertical"
        android:minWidth="0dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:text="@string/done"
        android:textColor="?android:attr/colorAccent" />
</LinearLayout>
