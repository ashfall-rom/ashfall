<?xml version="1.0" encoding="utf-8"?>
<!-- Fusion Quick Settings dialog.  Every control applies immediately. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fusion_qs_root"
    android:layout_width="@dimen/dialog_width"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/dialog_padding"
    android:paddingTop="20dp"
    android:paddingEnd="@dimen/dialog_padding"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_gamepad"
            android:tint="?android:attr/textColorPrimary" />

        <TextView
            style="@style/AshFallDialogTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="@string/fusion_dialog_title" />

        <Switch
            android:id="@+id/fusion_qs_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/fusion_switch_title"
            android:showText="false" />
    </LinearLayout>

    <TextView
        android:id="@+id/fusion_qs_state"
        style="@style/AshFallDialogSecondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <ScrollView
        android:id="@+id/fusion_qs_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/AshFallSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fusion_pads_title" />

            <LinearLayout
                android:id="@+id/fusion_qs_pads"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/fusion_qs_rescan"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="start|center_vertical"
                android:minWidth="0dp"
                android:text="@string/fusion_rescan_title"
                android:textColor="?android:attr/colorAccent" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/fusion_qs_more"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/fusion_dialog_more"
            android:textColor="?android:attr/colorAccent" />

        <Button
            android:id="@+id/fusion_qs_done"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/done"
            android:textColor="?android:attr/colorAccent" />
    </LinearLayout>
</LinearLayout>
