<?xml version="1.0" encoding="utf-8"?>
<!-- Content view of every AshFall Parts page.  CollapsingToolbarBaseActivity
     inflates this into the content frame of the Settings collapsing toolbar. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/parts_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:clipChildren="false">

    <FrameLayout
        android:id="@+id/parts_fragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
