<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/curve_info"
            style="@style/AshFallPreferenceTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/curve_live"
            style="@style/AshFallPreferenceSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <org.ashfall.parts.ui.CurveEditorView
            android:id="@+id/curve_editor"
            android:layout_width="match_parent"
            android:layout_height="@dimen/curve_height"
            android:layout_marginTop="8dp"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <TextView
            style="@style/AshFallPreferenceSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/curve_hint" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/curve_add"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/curve_add_point"
                android:textColor="?android:attr/colorAccent" />

            <Button
                android:id="@+id/curve_delete"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/curve_delete_point"
                android:textColor="?android:attr/colorAccent" />

            <Button
                android:id="@+id/curve_reset"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/curve_reset"
                android:textColor="?android:attr/colorAccent" />
        </LinearLayout>

        <!-- Stress test: two load sliders.  Leaving the page stops the load;
             the engine also enforces a ten-minute cap. -->
        <TextView
            style="@style/AshFallPreferenceTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/curve_stress_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/AshFallPreferenceSummary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/curve_stress_cpu" />

            <TextView
                android:id="@+id/stress_cpu_value"
                style="@style/AshFallPreferenceTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/stress_cpu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/AshFallPreferenceSummary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/curve_stress_gpu" />

            <TextView
                android:id="@+id/stress_gpu_value"
                style="@style/AshFallPreferenceTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/stress_gpu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <TextView
            android:id="@+id/stress_status"
            style="@style/AshFallPreferenceSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/curve_stress_hint" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
