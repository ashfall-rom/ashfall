<?xml version="1.0" encoding="utf-8"?>
<!-- Colour picker: preset swatches, a saturation/value square driven by touch
     or the D-pad, and a hue slider. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/dialog_width"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/dialog_padding"
    android:paddingTop="20dp"
    android:paddingEnd="@dimen/dialog_padding"
    android:paddingBottom="8dp">

    <TextView
        style="@style/AshFallDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/lighting_colour_title" />

    <TextView
        style="@style/AshFallSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/lighting_presets_colour" />

    <LinearLayout
        android:id="@+id/picker_swatches"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal" />

    <org.ashfall.parts.ui.ColorPickerView
        android:id="@+id/picker_square"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="16dp"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            style="@style/AshFallSection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/lighting_hue" />

        <TextView
            android:id="@+id/picker_hue_value"
            style="@style/AshFallDialogPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/picker_hue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="360" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/picker_cancel"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/cancel"
            android:textColor="?android:attr/colorAccent" />

        <Button
            android:id="@+id/picker_set"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/set"
            android:textColor="?android:attr/colorAccent" />
    </LinearLayout>
</LinearLayout>
