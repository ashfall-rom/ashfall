<?xml version="1.0" encoding="utf-8"?>
<!-- Settings-style slider row: title/value on one line, optional summary, and
     a SeekBar that is the only focus stop so the D-pad adjusts the value. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/AshFallPreferenceRow"
    android:focusable="false"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/slider_title"
            style="@style/AshFallPreferenceTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:focusable="false" />

        <TextView
            android:id="@+id/slider_value"
            style="@style/AshFallPreferenceTitle"
            android:layout_width="@dimen/slider_value_width"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:gravity="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/slider_summary"
        style="@style/AshFallPreferenceSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="false"
        android:visibility="gone" />

    <SeekBar
        android:id="@+id/slider_seekbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:paddingStart="0dp"
        android:paddingEnd="0dp" />
</LinearLayout>
