<?xml version="1.0" encoding="utf-8"?>
<!-- Memory page slider row (issue #141): title and size on one line, an
     optional summary, and a step-aware SeekBar that is the focus stop.  The
     D-pad is handled by the row (see MemoryFragment.StepSlider), so one
     left/right press moves the size by exactly one 256 MB step. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/AshFallPreferenceRow"
    android:focusable="false"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/memory_slider_title"
            style="@style/AshFallPreferenceTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:focusable="false" />

        <TextView
            android:id="@+id/memory_slider_value"
            style="@style/AshFallPreferenceTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:gravity="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/memory_slider_summary"
        style="@style/AshFallPreferenceSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="false"
        android:visibility="gone" />

    <SeekBar
        android:id="@+id/memory_slider_seekbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:paddingStart="0dp"
        android:paddingEnd="0dp" />
</LinearLayout>
