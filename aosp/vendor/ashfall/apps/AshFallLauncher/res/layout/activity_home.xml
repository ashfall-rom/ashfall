<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <org.ashfall.launcher.LauncherBackgroundView
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <org.ashfall.launcher.AppPager
                android:id="@+id/pager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/pager_margin_horizontal"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="@dimen/pager_margin_horizontal" />

            <ImageButton
                android:id="@+id/previous_page"
                android:layout_width="@dimen/chevron_width"
                android:layout_height="@dimen/chevron_height"
                android:layout_gravity="start|center_vertical"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/cd_previous_page"
                android:focusable="false"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chevron_left" />

            <ImageButton
                android:id="@+id/next_page"
                android:layout_width="@dimen/chevron_width"
                android:layout_height="@dimen/chevron_height"
                android:layout_gravity="end|center_vertical"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/cd_next_page"
                android:focusable="false"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chevron_right" />

            <TextView
                android:id="@+id/empty_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/loading_apps"
                android:textColor="@color/text_muted"
                android:textSize="16sp" />
        </FrameLayout>

        <org.ashfall.launcher.PageIndicatorView
            android:id="@+id/page_dots"
            android:layout_width="match_parent"
            android:layout_height="@dimen/page_indicator_height" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <org.ashfall.launcher.BottomBarView
            android:id="@+id/bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bottom_bar_height" />
    </LinearLayout>
</FrameLayout>
