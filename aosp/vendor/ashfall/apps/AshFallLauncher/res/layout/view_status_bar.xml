<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <TextView
        android:id="@+id/focused_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_weight="1"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        android:singleLine="true"
        android:text="@string/focused_none"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/focused_label_text_size"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/wifi_icon"
        android:layout_width="@dimen/status_icon_size"
        android:layout_height="@dimen/status_icon_size"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="12dp"
        android:contentDescription="@string/cd_wifi"
        android:src="@drawable/ic_wifi_off" />

    <org.ashfall.launcher.BatteryView
        android:id="@+id/battery_view"
        android:layout_width="@dimen/battery_view_width"
        android:layout_height="@dimen/battery_view_height"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="10dp" />

    <TextView
        android:id="@+id/battery_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="6dp"
        android:singleLine="true"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/battery_text_size"
        android:textStyle="bold" />
</merge>
