// AshFall launcher: a small, controller-first landscape HOME app for the RP5.
//
// Deliberately free of AndroidX / Kotlin / Compose: plain framework views keep
// the APK tiny and the cold start short. The app is not privileged and asks for
// no signature permissions; it only reads the launcher activity list and the
// network/battery state.
android_app {
    name: "AshFallLauncher",
    manifest: "AndroidManifest.xml",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],

    // In-tree system app; the platform API surface lets us use the same
    // WindowInsets and PackageManager APIs the platform itself uses.
    platform_apis: true,
    certificate: "platform",

    // No native code, no prebuilts, no static libraries.
    jni_libs: [],
    static_libs: [],

    aaptflags: [
        "--auto-add-overlay",
    ],

    // A launcher is started on every HOME press; keep the dex small and do not
    // spend boot time on dex2oat for a few hundred methods.
    dex_preopt: {
        enabled: false,
    },
}
