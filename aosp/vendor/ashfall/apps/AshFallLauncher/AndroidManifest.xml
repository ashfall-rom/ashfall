<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.ashfall.launcher"
    android:versionCode="1"
    android:versionName="1.0">

    <!-- Launchers are expected to see every launchable activity. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- The background is installed as the system wallpaper; the animated
         gradient uses the built-in live wallpaper below. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.SET_WALLPAPER_COMPONENT" />

    <uses-feature
        android:name="android.software.live_wallpaper"
        android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="false"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.AshFall">

        <!--
          android:priority makes this the fallback HOME holder chosen by
          RoleManager on first boot (HomeRoleBehavior picks the highest-priority
          HOME filter). Launcher3QuickStep is intentionally NOT overridden: it
          stays installed and keeps providing the recents/quickstep surface, as
          on the stock firmware (rp3launcher + Launcher3QuickStepEX). A
          Launcher3 patch removes its own HOME candidacy, so AshFall is the only
          home app in the chooser (docs/launcher.md).
        -->
        <activity
            android:name=".HomeActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.AshFall"
            android:windowSoftInputMode="stateAlwaysHidden|adjustNothing">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <!-- Also launchable from an app drawer/menu while the launcher
                     is being brought up; it still holds the HOME role. -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LauncherSettingsActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.AshFall.Settings" />

        <!--
          Live wallpaper for the animated gradient background. Installed by
          WallpaperController when "Animate colors" is on; it only draws while
          visible and reads the same appearance preferences as the launcher.
        -->
        <service
            android:name=".AshFallWallpaperService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper" />
        </service>
    </application>
</manifest>
