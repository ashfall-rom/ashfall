// AshFall RP5 input extensions (calibration, deadzones, control socket,
// GamepadFusion).
//
// The daemon's mapping/protocol/fusion code is built for the host with
// -DASHFALL_HOST; this target only pulls in the MCU/uinput/evdev loop check
// that the shared sources are warning-free on a second architecture.
cc_binary {
    name: "ashfall-rp5-input",
    srcs: [
        "ashfall_rp5_input.c",
        "calib.c",
        "control.c",
        "fusion.c",
        "input.c",
        "mapping.c",
        "plat.c",
        "session.c",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Wno-unused-parameter",
    ],
    shared_libs: [
        "liblog",
    ],
    init_rc: ["ashfall-rp5-input.rc"],
    compile_multilib: "64",
    vendor: false,
}
