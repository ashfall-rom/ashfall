service ashfall-hwd /system/bin/ashfall-hwd
    class core
    user system
    group system
    seclabel u:r:ashfall_hwd:s0

# The daemon is the only writer of the fan (gpio5_pwm2) and stick LED
# (sn3112) nodes.  It applies persist.ashfall.* at boot and at runtime and
# publishes ashfall.status.*.  init restarts it with the usual crash backoff.
