<?xml version="1.0" encoding="utf-8"?>
<!-- AshFall icon draft (issue #85). Clean-room, original design.
     A - Light bars: Three rounded light bars under a rail. Direct evolution of the current ic_led / ic_tile_lighting asset, so the tile keeps its meaning.
     Preview only: not wired into the app. 24dp, single colour,
     tintable. Geometry matches the LineageOS 24 Settings weight
     (960 viewport, 80 = 2dp stroke). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="960"
    android:viewportHeight="960"
    android:tint="?android:attr/colorControlNormal">
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@android:color/white"
        android:strokeWidth="80"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M180,200L780,200" />
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@android:color/white"
        android:strokeWidth="80"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M230,420L230,780" />
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@android:color/white"
        android:strokeWidth="80"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M480,380L480,780" />
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@android:color/white"
        android:strokeWidth="80"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M730,450L730,780" />
</vector>
